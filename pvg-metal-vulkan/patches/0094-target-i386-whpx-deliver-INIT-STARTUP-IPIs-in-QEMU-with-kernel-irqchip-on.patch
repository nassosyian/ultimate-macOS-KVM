From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nassos Yiannopoulos <nassosyian@gmail.com>
Date: Sun, 1 Nov 2026 23:30:00 +0200
Subject: [PATCH] target/i386/whpx: deliver INIT/STARTUP IPIs in QEMU with kernel-irqchip=on

With kernel-irqchip=on (Hyper-V's APIC) macOS could not start its other CPUs ("Failed to
start CPU 01, rebooting"): its INIT/STARTUP IPIs never took effect and the APs stayed in the
firmware's wait loop. QEMU now delivers INIT and STARTUP IPIs itself, as with its own APIC:

- X64ApicInitSipiExitTrap hands the ICR of INIT/STARTUP writes to QEMU (whpx_handle_init_sipi:
  physical/logical destination or shorthand; INIT de-asserts ignored; a STARTUP is kept when the
  target has not processed the INIT sent just before yet);
- INIT resets the target (do_cpu_init) and puts the AP into Hyper-V's StartupSuspend; STARTUP
  loads CS:IP from the vector (apic_sipi) and clears it;
- the WHPX APIC model no longer clears wait_for_sipi on reset (apic_sipi needs it).

macOS (and OVMF's own AP start) now boot with all CPUs under kernel-irqchip=on. Measured with
the pvg-linux-pci guest: the same frame rate as kernel-irqchip=off (~18 presents/s); not the
launcher default yet.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 target/i386/whpx/trace-events |    1 +
 target/i386/whpx/whpx-all.c   |   74 +++++++++++++++++++++++++++++++++++++++++
 target/i386/whpx/whpx-apic.c  |    6 ++-
 3 files changed, 79 insertions(+), 2 deletions(-)

diff --git a/target/i386/whpx/trace-events b/target/i386/whpx/trace-events
index ebdfa34..4059d28 100644
--- a/target/i386/whpx/trace-events
+++ b/target/i386/whpx/trace-events
@@ -1 +1,2 @@
 whpx_unsupported_msr_access(uint32_t msr, int is_write) "WHPX: Unsupported MSR access (0x%x), IsWrite=%i"
+whpx_init_sipi(int cpu, uint64_t icr) "vCPU %d sends INIT/SIPI, ICR 0x%" PRIx64
diff --git a/target/i386/whpx/whpx-all.c b/target/i386/whpx/whpx-all.c
index 8bed0ff..cdb65f7 100644
--- a/target/i386/whpx/whpx-all.c
+++ b/target/i386/whpx/whpx-all.c
@@ -1606,6 +1606,8 @@ HRESULT whpx_set_exception_exit_bitmap(UINT64 exceptions)
     memset(&prop, 0, sizeof(WHV_PARTITION_PROPERTY));
     prop.ExtendedVmExits.X64MsrExit = 1;
     prop.ExtendedVmExits.X64CpuidExit = 1;
+    /* Hyper-V's APIC: INIT and STARTUP IPIs are delivered by QEMU (whpx_handle_init_sipi) */
+    prop.ExtendedVmExits.X64ApicInitSipiExitTrap = whpx_irqchip_in_kernel();
 
     if (exceptions != 0 || whpx_get_default_exceptions() != 0) {
         prop.ExtendedVmExits.ExceptionExit = 1;
@@ -2245,6 +2247,15 @@ static void whpx_vcpu_process_async_events(CPUState *cpu)
         whpx_cpu_synchronize_state(cpu);
         do_cpu_init(x86_cpu);
         vcpu->interruptable = true;
+        if (whpx_irqchip_in_kernel() && !cpu_is_bsp(x86_cpu)) {
+            /* delivered by QEMU (whpx_handle_init_sipi): Hyper-V holds the AP until its SIPI */
+            WHV_REGISTER_VALUE reg;
+
+            whpx_get_reg(cpu, WHvRegisterInternalActivityState, &reg);
+            reg.InternalActivity.StartupSuspend = 1;
+            reg.InternalActivity.HaltSuspend = 0;
+            whpx_set_reg(cpu, WHvRegisterInternalActivityState, reg);
+        }
     }
 
     if (cpu_test_interrupt(cpu, CPU_INTERRUPT_POLL)) {
@@ -2263,6 +2274,15 @@ static void whpx_vcpu_process_async_events(CPUState *cpu)
         cpu_reset_interrupt(cpu, CPU_INTERRUPT_SIPI);
         whpx_cpu_synchronize_state(cpu);
         do_cpu_sipi(x86_cpu);
+        if (whpx_irqchip_in_kernel() && !cpu->halted) {
+            /* started by QEMU (whpx_handle_init_sipi): leave Hyper-V's wait-for-SIPI state */
+            WHV_REGISTER_VALUE reg;
+
+            whpx_get_reg(cpu, WHvRegisterInternalActivityState, &reg);
+            reg.InternalActivity.StartupSuspend = 0;
+            reg.InternalActivity.HaltSuspend = 0;
+            whpx_set_reg(cpu, WHvRegisterInternalActivityState, reg);
+        }
     }
 
     if (cpu_test_interrupt(cpu, CPU_INTERRUPT_TPR)) {
@@ -2356,6 +2376,55 @@ static bool whpx_host_bp_hit(CPUState *cpu)
     return true;
 }
 
+/*
+ * kernel-irqchip=on: Hyper-V's APIC traps INIT and STARTUP IPIs to us (X64ApicInitSipiExitTrap)
+ * and QEMU delivers them as with its own APIC: INIT resets the target and leaves an AP waiting
+ * for its STARTUP, which loads CS:IP from the vector. Left to Hyper-V, macOS's APs never
+ * started ("Failed to start CPU 01": they stayed in the firmware's wait loop).
+ */
+static void whpx_handle_init_sipi(CPUState *cpu, uint64_t icr)
+{
+    static int logged;
+    uint32_t mode = (icr >> 8) & 7, shorthand = (icr >> 18) & 3;
+    bool level_deassert = (icr & (1 << 15)) && !(icr & (1 << 14));
+    bool logical = icr & (1 << 11);
+    uint32_t dest = X86_CPU(cpu)->env.features[FEAT_1_ECX] & CPUID_EXT_X2APIC &&
+                    (cpu_get_apic_base(X86_CPU(cpu)->apic_state) & MSR_IA32_APICBASE_EXTD) ?
+                    icr >> 32 : icr >> 56;
+    CPUState *c;
+
+    if (logged++ < 32) {
+        trace_whpx_init_sipi(cpu->cpu_index, icr);
+    }
+    if ((mode != APIC_DM_INIT && mode != APIC_DM_SIPI) || level_deassert) {
+        return;
+    }
+    bql_lock();
+    CPU_FOREACH(c) {
+        X86CPU *x = X86_CPU(c);
+        bool hit;
+
+        switch (shorthand) {
+        case 1: hit = c == cpu; break;              /* self */
+        case 2: hit = true; break;                  /* all including self */
+        case 3: hit = c != cpu; break;              /* all excluding self */
+        default:
+            hit = logical ? (dest & (1u << x->apic_id)) != 0 : x->apic_id == dest;
+        }
+        if (!hit || !x->apic_state) {
+            continue;
+        }
+        if (mode == APIC_DM_INIT) {
+            cpu_interrupt(c, CPU_INTERRUPT_INIT);
+        } else if (x->apic_state->wait_for_sipi || cpu_test_interrupt(c, CPU_INTERRUPT_INIT)) {
+            /* the target may not have processed the INIT sent just before yet */
+            x->apic_state->sipi_vector = icr & 0xff;
+            cpu_interrupt(c, CPU_INTERRUPT_SIPI);
+        }
+    }
+    bql_unlock();
+}
+
 int whpx_vcpu_run(CPUState *cpu)
 {
     HRESULT hr;
@@ -2493,6 +2562,11 @@ int whpx_vcpu_run(CPUState *cpu)
             ioapic_eoi_broadcast(vcpu->exit_ctx.ApicEoi.InterruptVector);
             break;
 
+        case WHvRunVpExitReasonX64ApicInitSipiTrap:
+            whpx_handle_init_sipi(cpu, vcpu->exit_ctx.ApicInitSipi.ApicIcr);
+            ret = 0;
+            break;
+
         case WHvRunVpExitReasonX64Halt:
             /*
              * Used for kernel-irqchip=off
diff --git a/target/i386/whpx/whpx-apic.c b/target/i386/whpx/whpx-apic.c
index cc272f8..0f819db 100644
--- a/target/i386/whpx/whpx-apic.c
+++ b/target/i386/whpx/whpx-apic.c
@@ -313,8 +313,10 @@ static const MemoryRegionOps whpx_apic_io_ops = {
 
 static void whpx_apic_reset(APICCommonState *s)
 {
-    /* Not used by WHPX. */
-    s->wait_for_sipi = 0;
+    /*
+     * wait_for_sipi stays as apic_init_reset() set it: QEMU delivers INIT and STARTUP IPIs
+     * (whpx_handle_init_sipi), so an AP waits here for its STARTUP IPI.
+     */
 
     run_on_cpu(CPU(s->cpu), whpx_apic_put, RUN_ON_CPU_HOST_PTR(s));
 }
