+/*
+ * A shader samples one of the pass's own colour attachments (RenderBox backdrop reads). Vulkan
+ * cannot sample an image it renders into, so suspend rendering, copy the attachment into a
+ * scratch image (keyed by ref | 1 << 31) and resume with LOAD. Returns the copy to bind.
+ */
+static HostImage *feedback_snapshot(PVGExec *e, uint32_t task, Attachment *a,
+                                    VkRenderingAttachmentInfo *ca, uint32_t natt,
+                                    const VkRenderingInfo *ri)
+{
+    HostImage *snap = host_image(e, task, a->ref | 0x80000000u, &a->gi, false);
+    VkImageCopy r = {
+        .srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+        .dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+        .extent = { a->gi.width, a->gi.height, 1 },
+    };
+
+    if (!snap) {
+        return NULL;
+    }
+    vkCmdEndRendering(e->cmd);
+    barrier(e, a->img->image, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
+            VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+    barrier(e, snap->image, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+    vkCmdCopyImage(e->cmd, a->img->image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, snap->image,
+                   VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &r);
+    barrier(e, a->img->image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+            VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);
+    barrier(e, snap->image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+            VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+    for (uint32_t i = 0; i < natt; i++) {
+        ca[i].loadOp = ca[i].imageView ? VK_ATTACHMENT_LOAD_OP_LOAD :
+                       VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+    }
+    vkCmdBeginRendering(e->cmd, ri);
+    e->stats.feedback_copies++;
+    return snap;
+}
