+/* SetDepthStencilState: object type 7 kind 4, descriptor at body + 12 */
+static void ds_state_decode(PVGExec *e, uint32_t task, uint32_t ref, RenderState *st)
+{
+    uint8_t obj[MAX_OBJ];
+    uint32_t len;
+
+    st->ds_w0 = 7;      /* no state: compare Always, no write, no stencil */
+    memset(st->ds_face, 0, sizeof(st->ds_face));
+    if (!ref || object(e, task, ref, obj, &len) != OBJ_SERIALIZED || len < 12 + 28) {
+        return;
+    }
+    if (ldl(obj) != 4 && e->ds_kind_logged++ < 5) {
+        elog(e, "task %u depth/stencil state %u: unexpected kind %u", task, ref, ldl(obj));
+    }
+    st->ds_w0 = ldl(obj + 12);
+    for (int f = 0; f < 2; f++) {
+        for (int k = 0; k < 3; k++) {
+            st->ds_face[f][k] = ldl(obj + 16 + 12 * f + 4 * k);
+        }
+    }
+}
