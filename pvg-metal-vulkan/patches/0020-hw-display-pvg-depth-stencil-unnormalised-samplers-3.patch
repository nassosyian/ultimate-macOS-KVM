+/* per stage (vertex, fragment): sampler slots currently bound to unnormalised samplers */
+static const uint32_t *unnorm_masks(PVGExec *e, uint32_t task, const RenderState *st,
+                                    uint32_t out[2])
+{
+    out[0] = out[1] = 0;
+    for (int i = 0; i < MAX_SLOTS; i++) {
+        gint64 kv = key_of(task, st->vsmp[i]), kf = key_of(task, st->fsmp[i]);
+
+        sampler_get(e, task, st->vsmp[i]);      /* decodes (and records) unseen samplers */
+        sampler_get(e, task, st->fsmp[i]);
+        out[0] |= st->vsmp[i] && g_hash_table_contains(e->unnorm, &kv) ? 1u << i : 0;
+        out[1] |= st->fsmp[i] && g_hash_table_contains(e->unnorm, &kf) ? 1u << i : 0;
+    }
+    return out;
+}
