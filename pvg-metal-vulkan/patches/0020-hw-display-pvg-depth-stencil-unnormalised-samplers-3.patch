+/* Metal compare functions and stencil operations number like VkCompareOp / VkStencilOp */
+static void ds_apply(PVGExec *e, const RenderState *st, bool has_depth, bool has_stencil)
+{
+    VkCommandBuffer cb = e->cmd;
+    uint32_t cmp = st->ds_w0 & 7;
+    bool write = st->ds_w0 >> 3 & 1;
+
+    vkCmdSetDepthTestEnable(cb, has_depth && (cmp != 7 || write));
+    vkCmdSetDepthWriteEnable(cb, has_depth && write);
+    vkCmdSetDepthCompareOp(cb, (VkCompareOp)cmp);
+    vkCmdSetStencilTestEnable(cb, has_stencil && (st->ds_w0 & 0x30));
+    for (int f = 0; f < 2; f++) {
+        VkStencilFaceFlags face = f ? VK_STENCIL_FACE_BACK_BIT : VK_STENCIL_FACE_FRONT_BIT;
+        bool set = st->ds_w0 >> (4 + f) & 1;
+        uint32_t ops = set ? st->ds_face[f][0] : 7;     /* default: Always, Keep */
+
+        vkCmdSetStencilOp(cb, face, (VkStencilOp)(ops >> 3 & 7), (VkStencilOp)(ops >> 9 & 7),
+                          (VkStencilOp)(ops >> 6 & 7), (VkCompareOp)(ops & 7));
+        vkCmdSetStencilCompareMask(cb, face, set ? st->ds_face[f][1] : 0xff);
+        vkCmdSetStencilWriteMask(cb, face, set ? st->ds_face[f][2] : 0xff);
+        vkCmdSetStencilReference(cb, face, st->stencil_ref[f]);
+    }
+}
