+/* DescribeRenderPass depth (bytes 0..39) and stencil (40..75) attachments */
+typedef struct DSAttachment {
+    uint32_t depth_ref, stencil_ref, depth_load, stencil_load;
+    double clear_depth;
+    uint32_t clear_stencil;
+} DSAttachment;
+
+#define DS_FORMAT   VK_FORMAT_D32_SFLOAT_S8_UINT
+
+/* dimensions of a depth/stencil texture object (its format is not a colour format) */
+static bool ds_texture_dims(PVGExec *e, uint32_t task, uint32_t ref, uint32_t *w, uint32_t *h)
+{
+    uint8_t obj[MAX_OBJ];
+    uint32_t len, mips, tail;
+    uint8_t type = object(e, task, ref, obj, &len);
+    uint16_t fmt;
+
+    if ((type != OBJ_TEXTURE_2 && type != OBJ_TEXTURE_3) || len < 0x74) {
+        return false;
+    }
+    mips = (len - 0x50) / 0x24;
+    tail = 0x18 + mips * 0x24;
+    if (tail + 0x38 > len || tail + 0x38 > MAX_OBJ) {
+        return false;
+    }
+    /* MTLPixelFormat Depth16 250, Depth32Float 252, Stencil8 253, Depth24_Stencil8 255,
+     * Depth32Float_Stencil8 260, X32_Stencil8 261, X24_Stencil8 262 */
+    fmt = lduw(obj + tail + 0x18 + 2);
+    if (fmt != 250 && fmt != 252 && fmt != 253 && fmt != 255 && fmt != 260 && fmt != 261 &&
+        fmt != 262) {
+        return false;
+    }
+    *w = ldl(obj + tail);
+    *h = ldl(obj + tail + 4);
+    return *w && *h && *w <= 16384 && *h <= 16384;
+}
+
+static void ds_barrier(PVGExec *e, VkImage img, VkImageLayout from, VkImageLayout to)
+{
+    VkImageMemoryBarrier b = {
+        .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+        .srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT,
+        .dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT,
+        .oldLayout = from, .newLayout = to,
+        .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+        .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+        .image = img, .subresourceRange = {
+            VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT, 0, 1, 0, 1 },
+    };
+
+    vkCmdPipelineBarrier(e->cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                         VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 0, NULL, 0, NULL, 1, &b);
+}
+
+/* host-only depth/stencil image of a texture object (Metal keeps these on the GPU too) */
+static HostImage *ds_image(PVGExec *e, uint32_t task, uint32_t ref, uint32_t w, uint32_t h)
+{
+    PVGGpu *g = e->gpu;
+    gint64 key = key_of(task, ref | 0x40000000u);
+    HostImage *hi = g_hash_table_lookup(e->images, &key);
+    VkImageCreateInfo ici = {
+        .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO, .imageType = VK_IMAGE_TYPE_2D,
+        .format = DS_FORMAT, .extent = { w, h, 1 }, .mipLevels = 1, .arrayLayers = 1,
+        .samples = VK_SAMPLE_COUNT_1_BIT, .tiling = VK_IMAGE_TILING_OPTIMAL,
+        .usage = VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT,
+        .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+    };
+    VkImageViewCreateInfo vci = {
+        .sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO, .viewType = VK_IMAGE_VIEW_TYPE_2D,
+        .format = DS_FORMAT,
+        .subresourceRange = { VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT,
+                              0, 1, 0, 1 },
+    };
+    VkMemoryRequirements req;
+    VkMemoryAllocateInfo mai = { .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO };
+
+    if (hi && hi->width == w && hi->height == h) {
+        return hi;
+    }
+    if (hi) {
+        vkQueueWaitIdle(g->queue);
+        g_hash_table_remove(e->images, &key);
+    }
+    hi = g_new0(HostImage, 1);
