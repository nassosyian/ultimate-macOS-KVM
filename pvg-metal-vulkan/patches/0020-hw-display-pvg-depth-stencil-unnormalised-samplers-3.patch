 }
 
+static bool is_bool(LLVMTypeRef t);
+static uint32_t emit(Ctx *c, uint16_t op, uint32_t type, uint32_t result, const uint32_t *ops,
+                     size_t n);
+
+/*
+ * 8/16-bit stage inputs/outputs need storageInputOutput16, which NVIDIA lacks: such
+ * interface variables are declared 32-bit and converted at the load/store. Returns the
+ * widened type, or 0 when t is used as is.
+ */
+static uint32_t io_widen(Ctx *c, LLVMTypeRef t)
+{
+    LLVMTypeRef et = LLVMGetTypeKind(t) == LLVMVectorTypeKind ? LLVMGetElementType(t) : t;
+    unsigned n = LLVMGetTypeKind(t) == LLVMVectorTypeKind ? LLVMGetVectorSize(t) : 1;
+    uint32_t w;
+
+    if (LLVMGetTypeKind(et) == LLVMHalfTypeKind) {
+        w = c->t_f32;
+    } else if (LLVMGetTypeKind(et) == LLVMIntegerTypeKind && LLVMGetIntTypeWidth(et) < 32 &&
+               !is_bool(et)) {
+        w = c->t_u32;
+    } else {
+        return 0;
+    }
+    return n > 1 ? spv_type_vec(&c->m, w, n) : w;
+}
+
+/* convert between an interface value of type 'from' and LLVM type t (either direction) */
+static uint32_t io_convert(Ctx *c, uint32_t v, LLVMTypeRef t, uint32_t to)
+{
+    LLVMTypeRef et = LLVMGetTypeKind(t) == LLVMVectorTypeKind ? LLVMGetElementType(t) : t;
+
+    return emit(c, LLVMGetTypeKind(et) == LLVMHalfTypeKind ? SpvOpFConvert : SpvOpUConvert,
+                to, 0, &v, 1);
+}
