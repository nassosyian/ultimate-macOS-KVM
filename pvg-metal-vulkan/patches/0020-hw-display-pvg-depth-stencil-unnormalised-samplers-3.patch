     uint32_t pc_var, pc_elem_ptr;
+    uint32_t unnorm_spec;       /* OpSpecConstant A2S_SPEC_UNNORMALIZED, 0 = not yet */
     uint32_t out_vars[16];      /* fragment render targets / vertex outputs */
+    uint32_t out_io_type[16];   /* widened type of an output, 0 = as declared */
