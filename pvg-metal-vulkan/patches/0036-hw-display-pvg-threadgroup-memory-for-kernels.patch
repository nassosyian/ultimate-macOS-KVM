 #define A2S_SPEC_LOCAL_Z        3
 /* kernels: push-constant uvec3 grid size (threads); threads beyond it return at entry */
 #define A2S_PUSH_GRID           128
+/* kernels: length in 32-bit words of threadgroup buffer i (setThreadgroupMemoryLength) */
+#define A2S_SPEC_THREADGROUP    8
+#define A2S_MAX_THREADGROUP     8
 
 /*
  * AIR constant sampler state word (inferred from the shader corpus): bits 0-2/3-5/6-8 s/t/r
@@ -51,6 +54,7 @@ typedef struct A2SResult {
     uint32_t sampler_mask;
