From 1b5d9dd19b312cdceaf8561863a3d33189041fc3 Mon Sep 17 00:00:00 2001
From: Nassos Yiannopoulos <nassosyian@gmail.com>
Date: Thu, 29 Oct 2026 21:08:18 +0200
Subject: [PATCH 36/54] hw/display/pvg: threadgroup memory for kernels

air.buffer arguments in address space 3 are threadgroup buffers, not
device buffers: they now become Workgroup word arrays sized by spec
constants 8+index (setThreadgroupMemoryLength), and address-space-3
globals fixed-size Workgroup arrays, both through the private-memory
path. Before, a threadgroup buffer aliased device buffer slot of the same
index (VideoToolbox scaler: its scratch overwrote the parameter buffer).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hw/display/pvg/air2spv.c  | 68 ++++++++++++++++++++++++++++++++++++++-
 hw/display/pvg/air2spv.h  |  4 +++
 hw/display/pvg/pvg-exec.c | 52 +++++++++++++++++++++++++-----
 3 files changed, 115 insertions(+), 9 deletions(-)

diff --git a/hw/display/pvg/air2spv.c b/hw/display/pvg/air2spv.c
index f46cf3b..e70e955 100644
--- a/hw/display/pvg/air2spv.c
+++ b/hw/display/pvg/air2spv.c
@@ -30,6 +30,7 @@ enum ArgKind {
     /* kernel builtins */
     ARG_GLOBAL_ID, ARG_LOCAL_ID, ARG_GROUP_ID, ARG_GROUPS, ARG_LOCAL_INDEX, ARG_THREADS_PER_GROUP,
     ARG_GRID_SIZE, ARG_SIMD_LANE, ARG_SIMD_GROUP, ARG_SIMD_SIZE,
+    ARG_THREADGROUP,            /* air.buffer in address space 3: threadgroup memory */
 };
 
 enum Interp { INTERP_PERSPECTIVE, INTERP_NOPERSPECTIVE, INTERP_FLAT };
@@ -467,7 +468,10 @@ static int parse_entry(Ctx *c)
         if (arg->kind != ARG_NONE) {
             continue;
         } else if (!strcmp(kind, "air.buffer")) {
-            arg->kind = ARG_BUFFER;
+            int as = md_find(a, n, "air.address_space");
+
+            arg->kind = as >= 0 && as + 1 < n && md_int(a[as + 1]) == 3 ? ARG_THREADGROUP :
+                        ARG_BUFFER;
         } else if (!strcmp(kind, "air.texture")) {
             arg->kind = ARG_TEXTURE;
             p = md_find(a, n, "air.arg_type_name");
@@ -783,6 +787,34 @@ static int setup_interface(Ctx *c)
                                  spv_type_vec(&c->m, c->t_u32, 3), bi[a->kind]);
             break;
         }
+        case ARG_THREADGROUP: {
+            uint32_t sc[3] = { c->t_u32, spv_id(&c->m), 1024 }, arr[2], arr_t, ops[3];
+
+            if (c->stage != A2S_STAGE_COMPUTE || a->index >= A2S_MAX_THREADGROUP ||
+                c->npriv == 64) {
+                return fail(c, "unsupported threadgroup buffer %d", a->index);
+            }
+            spv_emit(&c->m, SPV_SEC_TYPES, SpvOpSpecConstant, sc, 3);
+            decorate1(c, sc[1], SpvDecorationSpecId, A2S_SPEC_THREADGROUP + a->index);
+            arr[0] = c->t_u32;
+            arr[1] = sc[1];
+            arr_t = spv_type(&c->m, SpvOpTypeArray, arr, 2);
+            ops[0] = spv_type_ptr(&c->m, SpvStorageWorkgroup, arr_t);
+            ops[1] = spv_id(&c->m);
+            ops[2] = SpvStorageWorkgroup;
+            spv_emit(&c->m, SPV_SEC_TYPES, SpvOpVariable, ops, 3);
+            if (c->niface < 128) {
+                c->iface[c->niface++] = ops[1];
+            }
+            c->priv[c->npriv].v = LLVMGetParam(c->fn, i);
+            c->priv[c->npriv].var = ops[1];
+            c->priv[c->npriv].off = spv_const_u32(&c->m, 0);
+            c->priv[c->npriv].words = 1u << 20;     /* runtime length: no static bound */
+            c->priv[c->npriv].ptr_t = spv_type_ptr(&c->m, SpvStorageWorkgroup, c->t_u32);
+            c->npriv++;
+            c->res->threadgroup_mask |= 1u << a->index;
+            break;
+        }
         case ARG_THREADS_PER_GROUP: case ARG_GRID_SIZE:
             if (c->stage != A2S_STAGE_COMPUTE) {
                 return fail(c, "kernel builtin outside a kernel");
@@ -2097,6 +2129,34 @@ static int declare_constant_global(Ctx *c, LLVMValueRef g)
     return 0;
 }
 
+/* `threadgroup` variables of a kernel: module-scope Workgroup word arrays */
+static int declare_threadgroup_global(Ctx *c, LLVMValueRef g)
+{
+    uint64_t size = LLVMABISizeOfType(c->td, LLVMGlobalGetValueType(g));
+    uint32_t arr[2], arr_t, ops[3];
+
+    if (c->stage != A2S_STAGE_COMPUTE || !size || size > 64 * 1024 || c->npriv == 64) {
+        return fail(c, "unsupported threadgroup global %s", vname(g, NULL));
+    }
+    arr[0] = c->t_u32;
+    arr[1] = spv_const_u32(&c->m, (uint32_t)((size + 3) / 4));
+    arr_t = spv_type(&c->m, SpvOpTypeArray, arr, 2);
+    ops[0] = spv_type_ptr(&c->m, SpvStorageWorkgroup, arr_t);
+    ops[1] = spv_id(&c->m);
+    ops[2] = SpvStorageWorkgroup;
+    spv_emit(&c->m, SPV_SEC_TYPES, SpvOpVariable, ops, 3);
+    if (c->niface < 128) {
+        c->iface[c->niface++] = ops[1];
+    }
+    c->priv[c->npriv].v = g;
+    c->priv[c->npriv].var = ops[1];
+    c->priv[c->npriv].off = spv_const_u32(&c->m, 0);
+    c->priv[c->npriv].words = (uint32_t)((size + 3) / 4);
+    c->priv[c->npriv].ptr_t = spv_type_ptr(&c->m, SpvStorageWorkgroup, c->t_u32);
+    c->npriv++;
+    return 0;
+}
+
 static int declare_constant_globals(Ctx *c)
 {
     for (LLVMValueRef g = LLVMGetFirstGlobal(c->mod); g; g = LLVMGetNextGlobal(g)) {
@@ -2105,6 +2165,12 @@ static int declare_constant_globals(Ctx *c)
         if (!LLVMGetFirstUse(g) || resource_for(c, g) || !strncmp(n, "llvm.", 5)) {
             continue;
         }
+        if (LLVMGetPointerAddressSpace(LLVMTypeOf(g)) == 3) {
+            if (declare_threadgroup_global(c, g)) {
+                return -1;
+            }
+            continue;
+        }
         if (declare_constant_global(c, g)) {
             return -1;
         }
diff --git a/hw/display/pvg/air2spv.h b/hw/display/pvg/air2spv.h
index c150178..24adc4d 100644
