     uint32_t buffer_write_mask; /* buffer indices the function may write */
+    uint32_t threadgroup_mask;  /* kernels: threadgroup buffer indices (address space 3) */
     uint32_t push_base;         /* in: byte offset of this stage's buffer table */
     uint32_t push_size;         /* out: end offset of the push constants used */
     int nconst_samplers;
