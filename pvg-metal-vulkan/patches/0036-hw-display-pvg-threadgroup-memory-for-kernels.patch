     PlEntry ents[16];
     A2SResult cs = { 0 };
     VkShaderModule csm = VK_NULL_HANDLE;
@@ -2555,11 +2558,18 @@ static Pipeline *compute_pipeline_get(PVGExec *e, uint32_t task, uint32_t ref,
         VkPipelineLayoutCreateInfo lci = {
             .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO, .setLayoutCount = 1,
             .pSetLayouts = &p->dsl, .pushConstantRangeCount = 1, .pPushConstantRanges = &pcr };
-        VkSpecializationMapEntry sme[4] = {
+        VkSpecializationMapEntry sme[4 + A2S_MAX_THREADGROUP] = {
             { A2S_SPEC_UNNORMALIZED, 0, 4 }, { A2S_SPEC_LOCAL_X, 4, 4 },
