From 868b11d9ed142752b3c523fac881584b9df223f3 Mon Sep 17 00:00:00 2001
From: Nassos Yiannopoulos <nassosyian@gmail.com>
Date: Fri, 30 Oct 2026 01:15:34 +0200
Subject: [PATCH 48/54] hw/display/pvg/pvg-exec: content-addressed translation
 cache and VkPipelineCache

Shaders come back under new object ids per process (VideoToolbox per stream):
~5900 translations reused in a short session, slowest command buffer 1.3 s ->
~18 ms. Pipeline build time and reuse reported by pvg_linux_exec_pipelines.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hw/display/pvg-linux-pci.c |  2 +
 hw/display/pvg/pvg-exec.c  | 83 +++++++++++++++++++++++++++++++++++---
 hw/display/pvg/pvg-exec.h  |  1 +
 hw/display/trace-events    |  1 +
 4 files changed, 82 insertions(+), 5 deletions(-)

diff --git a/hw/display/pvg-linux-pci.c b/hw/display/pvg-linux-pci.c
index 637a127..8f79a78 100644
--- a/hw/display/pvg-linux-pci.c
+++ b/hw/display/pvg-linux-pci.c
@@ -1421,6 +1421,8 @@ static void pvg_cmd_exec_indirect2(PVGLinuxPCIState *s, const uint8_t *p,
                                           s->exec_read_bytes >> 20, s->exec_write_us / 1000,
                                           s->exec_write_bytes >> 20,
                                           pvg_exec_stats(s->exec)->gpu_wait_us / 1000);
+                trace_pvg_linux_exec_pipelines(pvg_exec_stats(s->exec)->pipeline_us / 1000,
+                                               pvg_exec_stats(s->exec)->spv_cache_hits);
                 s->exec_us = s->exec_max_us = s->exec_read_us = s->exec_write_us = 0;
                 s->exec_read_bytes = s->exec_write_bytes = 0;
                 s->exec_window_start = t0 + dt;
diff --git a/hw/display/pvg/pvg-exec.c b/hw/display/pvg/pvg-exec.c
index e880989..361b1a6 100644
--- a/hw/display/pvg/pvg-exec.c
+++ b/hw/display/pvg/pvg-exec.c
@@ -158,6 +158,8 @@ struct PVGExec {
     GHashTable *uploaded;       /* per command buffer: task << 32 | id → arena offset + 1 */
     GHashTable *samplers;       /* task << 32 | id → VkSampler (as pointer) */
     uint32_t upload_failures, ds_kind_logged, ds_states_logged, ds_dumps, blends_logged;
+    GHashTable *spv_cache;      /* SHA-256 of translator inputs -> A2SResult */
+    VkPipelineCache vk_cache;
     uint8_t unhandled_seen[3][128];   /* command ids already reported */
     uint32_t texfail_logged, blit_unhandled, resolve_logged, cwb_logged, cio_dumps, buffail_logged, ccmd_logged;
     DSAttachmentSave last_ds;
@@ -1077,6 +1079,58 @@ static int objlist(const uint8_t *base, uint32_t off, uint32_t end, uint32_t *of
     return n < (uint32_t)max ? (int)n : max;
 }
 
+/*
+ * Translation cache: the same shader comes back under new object ids in every process (and
+ * VideoToolbox recreates its kernels per stream), so translations are reused by content.
+ * The key covers the inputs the translator reads: bitcode, buffer table base, paired varyings.
+ */
+static char *spv_cache_key(const void *bc, size_t bclen, const A2SResult *r)
+{
+    g_autoptr(GChecksum) ck = g_checksum_new(G_CHECKSUM_SHA256);
+
+    g_checksum_update(ck, bc, bclen);
+    g_checksum_update(ck, (const guchar *)&r->push_base, sizeof(r->push_base));
+    g_checksum_update(ck, (const guchar *)&r->nvaryings, sizeof(r->nvaryings));
+    for (int i = 0; i < r->nvaryings && i < A2S_MAX_VARYINGS; i++) {
+        g_checksum_update(ck, (const guchar *)r->varyings[i], strlen(r->varyings[i]) + 1);
+    }
+    return g_strdup(g_checksum_get_string(ck));
+}
+
+static bool spv_cache_lookup(PVGExec *e, const char *key, A2SResult *r)
+{
+    const A2SResult *hit = g_hash_table_lookup(e->spv_cache, key);
+
+    if (!hit) {
+        return false;
+    }
+    *r = *hit;
+    r->spirv = malloc(hit->nwords * 4);
+    memcpy(r->spirv, hit->spirv, hit->nwords * 4);
+    e->stats.spv_cache_hits++;
+    return true;
+}
+
+static void spv_cache_store(PVGExec *e, const char *key, const A2SResult *r)
+{
+    A2SResult *copy;
+
+    if (!r->spirv || g_hash_table_size(e->spv_cache) >= 8192) {
+        return;
+    }
+    copy = g_memdup2(r, sizeof(*r));
+    copy->spirv = g_memdup2(r->spirv, r->nwords * 4);
+    g_hash_table_replace(e->spv_cache, g_strdup(key), copy);
+}
+
+static void spv_cache_free(gpointer p)
+{
+    A2SResult *r = p;
+
+    g_free(r->spirv);
+    g_free(r);
+}
+
 static uint32_t *function_spirv(PVGExec *e, uint32_t task, uint32_t fn, A2SResult *r)
 {
     uint8_t obj[MAX_OBJ];
@@ -1084,6 +1138,7 @@ static uint32_t *function_spirv(PVGExec *e, uint32_t task, uint32_t fn, A2SResul
     uint64_t lib_va;
     uint32_t lib_len;
     g_autofree uint8_t *lib = NULL;
+    g_autofree char *key = NULL;
     const void *bc;
     size_t bclen;
 
@@ -1102,8 +1157,13 @@ static uint32_t *function_spirv(PVGExec *e, uint32_t task, uint32_t fn, A2SResul
         elog(e, "task %u: function %u: no metallib", task, fn);
         return NULL;
     }
-    if (air2spv_translate(bc, bclen, r)) {
-        elog(e, "task %u: function %u: %s", task, fn, r->error);
+    key = spv_cache_key(bc, bclen, r);    /* before translating: r holds the inputs */
+    if (!spv_cache_lookup(e, key, r)) {
+        if (air2spv_translate(bc, bclen, r)) {
+            elog(e, "task %u: function %u: %s", task, fn, r->error);
+        } else {
+            spv_cache_store(e, key, r);
+        }
     }
     if (e->dump_dir) {
         g_autofree char *path = g_strdup_printf("%s/fn-t%u-%u-%s%s.metallib", e->dump_dir, task,
@@ -1440,7 +1500,7 @@ static Pipeline *pipeline_get(PVGExec *e, uint32_t task, uint32_t ref, const VkF
             .pMultisampleState = &ms, .pDepthStencilState = &ds, .pColorBlendState = &cb,
             .pDynamicState = &dy, .layout = p->layout };
 
-        if (vkCreateGraphicsPipelines(g->device, VK_NULL_HANDLE, 1, &gci, NULL, &p->pipe) !=
+        if (vkCreateGraphicsPipelines(g->device, e->vk_cache, 1, &gci, NULL, &p->pipe) !=
             VK_SUCCESS) {
             elog(e, "task %u pipeline %u: vkCreateGraphicsPipelines failed", task, ref);
             goto fail;
@@ -2387,9 +2447,12 @@ static void exec_render_segment(PVGExec *e, uint32_t task, const uint8_t *p, uin
                 e->stats.skipped_draws++;
                 break;
             }
+            int64_t pt0 = g_get_monotonic_time();
+
             pp = st.pipeline ? pipeline_get(e, task, st.pipeline, formats, natt, dfmt, sfmt,
                                                    unnorm_masks(e, task, &st, unnorm),
                                                    topology_class(prim)) : NULL;
+            e->stats.pipeline_us += g_get_monotonic_time() - pt0;
             if (pp && pp->draws_logged < 3) {
                 pp->draws_logged++;
                 elog(e, "task %u pipeline %u draw 0x%x prim %u count %u first %u inst %u "
@@ -2801,7 +2864,7 @@ static Pipeline *compute_pipeline_get(PVGExec *e, uint32_t task, uint32_t ref,
             goto fail;
         }
         cci.layout = p->layout;
-        if (vkCreateComputePipelines(g->device, VK_NULL_HANDLE, 1, &cci, NULL, &p->pipe) !=
+        if (vkCreateComputePipelines(g->device, e->vk_cache, 1, &cci, NULL, &p->pipe) !=
             VK_SUCCESS) {
             elog(e, "task %u compute pipeline %u: vkCreateComputePipelines failed", task, ref);
             goto fail;
@@ -3528,7 +3591,7 @@ static gboolean match_task_str(gpointer key, gpointer value, gpointer task)
 
 void pvg_exec_reset_wait(PVGExec *e)
 {
-    e->stats.gpu_wait_us = 0;
+    e->stats.gpu_wait_us = e->stats.pipeline_us = 0;
 }
 
 void pvg_exec_object_deleted(PVGExec *e, uint32_t task, uint32_t id)
@@ -3649,6 +3712,12 @@ PVGExec *pvg_exec_new(PVGGpu *gpu, const PVGExecHost *host)
     free_ctx = e;
     e->images = g_hash_table_new_full(g_int64_hash, g_int64_equal, g_free, image_free);
     e->pipelines = g_hash_table_new_full(g_str_hash, g_str_equal, g_free, pipeline_free);
+    e->spv_cache = g_hash_table_new_full(g_str_hash, g_str_equal, g_free, spv_cache_free);
+    {
+        VkPipelineCacheCreateInfo pci = { .sType = VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO };
+
+        vkCreatePipelineCache(gpu->device, &pci, NULL, &e->vk_cache);
+    }
     e->uploaded = g_hash_table_new_full(g_int64_hash, g_int64_equal, g_free, NULL);
     e->samplers = g_hash_table_new_full(g_int64_hash, g_int64_equal, g_free, NULL);
     e->unnorm = g_hash_table_new_full(g_int64_hash, g_int64_equal, g_free, NULL);
@@ -3691,6 +3760,10 @@ void pvg_exec_free(PVGExec *e)
     free_ctx = e;
     g_hash_table_destroy(e->images);
     g_hash_table_destroy(e->pipelines);
+    g_hash_table_destroy(e->spv_cache);
+    if (e->vk_cache) {
+        vkDestroyPipelineCache(e->gpu->device, e->vk_cache, NULL);
+    }
     g_hash_table_destroy(e->uploaded);
     {
         GHashTableIter it;
diff --git a/hw/display/pvg/pvg-exec.h b/hw/display/pvg/pvg-exec.h
index b1da442..3cb7842 100644
--- a/hw/display/pvg/pvg-exec.h
+++ b/hw/display/pvg/pvg-exec.h
@@ -29,6 +29,7 @@ typedef struct PVGExecStats {
     uint64_t uploads, writebacks, blits, skipped_passes, continuations, feedback_copies;
     uint64_t compute_segments, dispatches;
     uint64_t gpu_wait_us;       /* since pvg_exec_reset_wait() */
+    uint64_t spv_cache_hits, pipeline_us;   /* translations reused; time building pipelines */
 } PVGExecStats;
 
 typedef struct PVGExec PVGExec;
diff --git a/hw/display/trace-events b/hw/display/trace-events
index c6941b4..86b7e84 100644
--- a/hw/display/trace-events
+++ b/hw/display/trace-events
@@ -255,6 +255,7 @@ pvg_linux_ref(uint32_t task, const char *cmd, uint32_t slot, uint32_t ref, uint3
 pvg_linux_exec(const char *msg) "%s"
 pvg_linux_exec_stats(uint64_t cmdbufs, uint64_t passes, uint64_t draws, uint64_t skipped, uint64_t pipelines, uint64_t pipe_fail, uint64_t writebacks, uint64_t blits, uint64_t feedback, uint64_t dispatches) "cmdbufs=%"PRIu64" passes=%"PRIu64" draws=%"PRIu64" skipped=%"PRIu64" pipelines=%"PRIu64" failed=%"PRIu64" writebacks=%"PRIu64" blits=%"PRIu64" feedback=%"PRIu64" dispatches=%"PRIu64
 pvg_linux_exec_time(uint64_t cmdbufs, int64_t exec_ms, int64_t wall_ms, int64_t max_us, int64_t read_ms, uint64_t read_mb, int64_t write_ms, uint64_t write_mb, uint64_t wait_ms) "cmdbufs=%"PRIu64" exec %"PRId64" ms of %"PRId64" ms wall, slowest %"PRId64" us; guest read %"PRId64" ms %"PRIu64" MiB, write %"PRId64" ms %"PRIu64" MiB, gpu wait %"PRIu64" ms"
+pvg_linux_exec_pipelines(uint64_t pipe_ms, uint64_t spv_hits) "building pipelines %"PRIu64" ms, translations reused %"PRIu64
 pvg_linux_child_poke(uint32_t index, uint32_t written, uint32_t read, uint32_t length) "child FIFO %u written=0x%x read=0x%x length=0x%x"
