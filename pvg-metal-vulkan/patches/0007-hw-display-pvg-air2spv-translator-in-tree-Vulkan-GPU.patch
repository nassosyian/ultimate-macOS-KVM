+/* ---- builder ---- */
+
+typedef struct SpvBuf {
+    uint32_t *w;
+    size_t len, cap;
+} SpvBuf;
+
+enum {
+    SPV_SEC_CAPS, SPV_SEC_EXTS, SPV_SEC_IMPORTS, SPV_SEC_MEMMODEL, SPV_SEC_ENTRY, SPV_SEC_EXECMODE,
+    SPV_SEC_DEBUG, SPV_SEC_ANNOT, SPV_SEC_TYPES, SPV_SEC_FUNCS, SPV_SEC_COUNT,
+};
+
+typedef struct SpvModule {
+    SpvBuf sec[SPV_SEC_COUNT];
+    uint32_t next_id;
+    /* dedup cache for types and constants: instruction words without the result id */
+    struct { uint32_t *key; size_t n; uint32_t id; } *cache;
+    size_t ncache, capcache;
+    uint64_t caps_seen[2];      /* small capabilities bitmap (< 128) */
+    uint32_t big_caps[8];
+    size_t nbig_caps;
+    uint32_t glsl;              /* GLSL.std.450 import id */
+} SpvModule;
+
+void spv_init(SpvModule *m);
+void spv_free(SpvModule *m);
+uint32_t spv_id(SpvModule *m);
+void spv_emit(SpvModule *m, int sec, uint16_t op, const uint32_t *ops, size_t n);
+void spv_emit_str(SpvModule *m, int sec, uint16_t op, const uint32_t *pre, size_t npre,
