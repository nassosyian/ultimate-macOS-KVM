+    SpvBuiltInPointCoord = 16, SpvBuiltInFrontFacing = 17, SpvBuiltInSampleId = 18,
+    SpvBuiltInSampleMask = 20, SpvBuiltInFragDepth = 22, SpvBuiltInVertexIndex = 42,
+    SpvBuiltInInstanceIndex = 43,
+};
+
+enum { SpvMemoryAccessAligned = 2 };
+enum { SpvImageOperandsBias = 1, SpvImageOperandsLod = 2, SpvImageOperandsConstOffset = 8 };
+
+enum {
