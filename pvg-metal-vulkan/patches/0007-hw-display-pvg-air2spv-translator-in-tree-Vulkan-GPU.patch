+void spv_capability(SpvModule *m, uint32_t cap);
+void spv_extension(SpvModule *m, const char *name);
+/* type/constant with dedup: ops[0] is NOT the result id, the builder inserts it */
+uint32_t spv_type(SpvModule *m, uint16_t op, const uint32_t *ops, size_t n);
+uint32_t spv_const(SpvModule *m, uint16_t op, uint32_t type, const uint32_t *ops, size_t n);
+uint32_t spv_type_int(SpvModule *m, uint32_t bits, bool sign);
+uint32_t spv_type_float(SpvModule *m, uint32_t bits);
+uint32_t spv_type_vec(SpvModule *m, uint32_t elem, uint32_t n);
+uint32_t spv_type_ptr(SpvModule *m, uint32_t sc, uint32_t elem);
+uint32_t spv_const_u32(SpvModule *m, uint32_t v);
+uint32_t spv_const_u64(SpvModule *m, uint64_t v);
+uint32_t spv_const_f32(SpvModule *m, float v);
+void spv_decorate(SpvModule *m, uint32_t id, uint32_t dec, const uint32_t *ops, size_t n);
+void spv_member_decorate(SpvModule *m, uint32_t id, uint32_t member, uint32_t dec, uint32_t v);
+void spv_name(SpvModule *m, uint32_t id, const char *name);
+/* final binary; caller frees */
+uint32_t *spv_finish(SpvModule *m, size_t *nwords);
