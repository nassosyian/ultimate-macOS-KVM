+};
+
+enum { SpvDim1D = 0, SpvDim2D = 1, SpvDim3D = 2, SpvDimCube = 3, SpvDimBuffer = 5 };
+
+enum {
+    SpvDecorationBlock = 2, SpvDecorationArrayStride = 6, SpvDecorationBuiltIn = 11,
+    SpvDecorationNoPerspective = 13, SpvDecorationFlat = 14, SpvDecorationCentroid = 16,
+    SpvDecorationSample = 17, SpvDecorationNonWritable = 24, SpvDecorationLocation = 30,
+    SpvDecorationIndex = 32, SpvDecorationBinding = 33, SpvDecorationDescriptorSet = 34,
+    SpvDecorationOffset = 35,
+};
+
+enum {
