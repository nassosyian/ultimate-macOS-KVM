+/* CmdSetObjectList {u32 task, u32 list_page, u32 list_len} */
+static void pvg_cmd_set_object_list(PVGLinuxPCIState *s, const uint8_t *p,
+                                    uint32_t len)
+{
+    uint32_t task;
+
+    if (len < 12) {
+        return;
+    }
+    task = ldl_le_p(p);
+    if (task >= PVG_MAX_TASKS) {
+        return;
+    }
+    s->tasks[task].object_list_va = (uint64_t)ldl_le_p(p + 4) << 12;
+    s->tasks[task].object_list_len = ldl_le_p(p + 8);
+    trace_pvg_linux_object_list(task, s->tasks[task].object_list_va,
+                                s->tasks[task].object_list_len);
+}
+
+/* Read object 'id' of a task into buf; returns its type (0 = invalid) */
+static uint8_t pvg_task_object(PVGLinuxPCIState *s, uint32_t task, uint32_t id,
+                               void *buf, uint32_t bufsize, uint32_t *objlen)
+{
+    PVGTask *t = &s->tasks[task];
+    uint8_t entry[PVG_OBJ_ENTRY_SIZE];
+    uint32_t head;
+
+    if (!t->object_list_va ||
+        (uint64_t)(id + 1) * PVG_OBJ_ENTRY_SIZE > t->object_list_len ||
+        !pvg_task_read(s, task, t->object_list_va + id * PVG_OBJ_ENTRY_SIZE,
+                       entry, sizeof(entry))) {
+        return 0;
+    }
+    head = ldl_le_p(entry);
+    *objlen = head >> 8;
+    if (!(head & 0xff) || *objlen > bufsize ||
+        !pvg_task_read(s, task, ldq_le_p(entry + 4), buf, *objlen)) {
+        return 0;
+    }
+    return head & 0xff;
+}
+
+/* Copy a presented BGRA backing (kernel task) into the console */
+static void pvg_display_scanout(PVGLinuxPCIState *s, uint32_t surface_id)
+{
+    uint8_t obj[0x100];
+    uint32_t objlen, fourcc, offset, width, height, row_bytes, *fb;
+    uint64_t base;
+    uint32_t missing = 0, nonzero = 0;
+    int stride;
+
+    if (!s->con) {
+        return;
+    }
+    if (pvg_task_object(s, 0, surface_id, obj, sizeof(obj), &objlen) !=
+        PVG_OBJ_BACKING || objlen < 0x24 || ldl_le_p(obj + 0x10) < 1) {
+        trace_pvg_linux_scanout_skip(surface_id, "not a backing");
+        return;
+    }
+    fourcc = ldl_le_p(obj + 0x0c);
+    base = (uint64_t)ldl_le_p(obj + 0x08) << 12;
+    offset = ldl_le_p(obj + 0x14);
+    width = ldl_le_p(obj + 0x18);
+    height = ldl_le_p(obj + 0x1c);
+    row_bytes = ldl_le_p(obj + 0x20) & 0xffffff;
+    if (fourcc != PVG_FOURCC_BGRA || (ldl_le_p(obj + 0x20) >> 24) != 4 ||
+        !width || !height || width > 8192 || height > 8192 ||
+        row_bytes < width * 4) {
+        trace_pvg_linux_scanout_skip(surface_id, "unsupported format");
+        return;
+    }
+    pvg_display_ensure_surface(s, width, height);
+    fb = surface_data(s->surface);
+    stride = surface_stride(s->surface);
+    for (uint32_t y = 0; y < height; y++) {
+        uint32_t *row = (uint32_t *)((uint8_t *)fb + y * stride);
+
+        if (!pvg_task_read(s, 0, base + offset + (uint64_t)y * row_bytes,
+                           row, width * 4)) {
+            memset(row, 0, width * 4);
+            missing++;
+        } else if (y % 64 == 0) {
+            for (uint32_t x = 0; x < width; x += 16) {
+                nonzero += (row[x] & 0xffffff) != 0;
+            }
+        }
+    }
+    s->scanout_valid = true;
+    trace_pvg_linux_scanout(surface_id, width, height, base, missing, nonzero);
+    qemu_console_update_full(s->con);
+}
+
+/* ---- Metal command stream (ExecIndirect2 -> _PGDeserializer) ---- */
+
+#define PVG_MAX_CMDBUF          (4 * MiB)
+#define PVG_SEG_HDR_SIZE        8   /* u32 length, u8 encoder, u8 continuation, u8 end, u8 */
+
+static const char *const pvg_encoder_names[] = {
+    [0] = "render", [1] = "compute", [2] = "blit", [4] = "info", [5] = "protection",
+};
+
+static void pvg_parse_cmdbuf(PVGLinuxPCIState *s, uint32_t task,
+                             const uint8_t *buf, uint64_t len)
+{
+    uint64_t off = 0;
+
+    while (off + PVG_SEG_HDR_SIZE <= len) {
+        uint32_t seglen = ldl_le_p(buf + off);
+        uint8_t enc = buf[off + 4];
+        const char *name = enc < ARRAY_SIZE(pvg_encoder_names) &&
+                           pvg_encoder_names[enc] ? pvg_encoder_names[enc] : "?";
+
+        if (seglen < PVG_SEG_HDR_SIZE || off + seglen > len) {
+            trace_pvg_linux_segment_bad(task, off, seglen, len);
+            return;
+        }
+        trace_pvg_linux_segment(task, off, seglen, name, buf[off + 5],
+                                buf[off + 6]);
+        off += seglen;
+    }
+}
+
+/*
+ * CmdExecIndirect2 {u32 user task, u32 resource count, u32 cmd buffer count,
+ * resources[] (24 B), cmd buffers[] {u64 va, u64 len}}
+ * (-[PGLocalTask doExecIndirect:cmdBuffers:resourceList:...]).
+ */
+static void pvg_cmd_exec_indirect2(PVGLinuxPCIState *s, const uint8_t *p,
+                                   uint32_t len)
+{
+    uint32_t task, nres, ncb;
+    const uint8_t *cbs;
+
+    if (len < 12) {
+        return;
+    }
+    task = ldl_le_p(p);
+    nres = ldl_le_p(p + 4);
+    ncb = ldl_le_p(p + 8);
+    if (task >= PVG_MAX_TASKS || nres > len / 24 || ncb > len / 16 ||
+        12 + 24ull * nres + 16ull * ncb > len) {
+        return;
+    }
+    cbs = p + 12 + 24 * nres;
+    for (uint32_t i = 0; i < ncb; i++) {
+        uint64_t va = ldq_le_p(cbs + 16 * i), cblen = ldq_le_p(cbs + 16 * i + 8);
+        g_autofree uint8_t *buf = NULL;
+
+        if (!cblen || cblen > PVG_MAX_CMDBUF) {
+            continue;
+        }
+        buf = g_malloc(cblen);
+        if (!pvg_task_read(s, task, va, buf, cblen)) {
+            trace_pvg_linux_task_fault(task, va);
+            continue;
+        }
+        trace_pvg_linux_cmdbuf(task, nres, va, cblen);
+        if (s->dump_dir && s->dumped < s->dump_max) {
+            g_autofree char *path = g_strdup_printf("%s/cb-%05u-t%u.bin",
+                                                    s->dump_dir, s->dumped++,
+                                                    task);
+            g_file_set_contents(path, (const char *)buf, cblen, NULL);
+        }
+        pvg_parse_cmdbuf(s, task, buf, cblen);
+    }
+}
