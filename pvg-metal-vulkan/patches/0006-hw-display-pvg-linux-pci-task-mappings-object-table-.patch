+/* Host mappings first (the guest may drop PTEs after MapMemory2), then a walk */
+static bool pvg_task_translate(PVGLinuxPCIState *s, uint32_t task,
+                               uint64_t va, uint64_t *gpa)
+{
+    PVGTask *t;
+
+    if (task >= PVG_MAX_TASKS || !s->tasks[task].root) {
+        return false;
+    }
+    t = &s->tasks[task];
+    for (guint i = 0; t->mappings && i < t->mappings->len; i++) {
+        PVGTaskMapping *m = &g_array_index(t->mappings, PVGTaskMapping, i);
+
+        if (va >= m->va && va - m->va < m->len) {
+            uint64_t page = m->gpa[(va - m->va) >> 12];
+
+            if (page) {
+                *gpa = page | (va & 0xfff);
+                return true;
+            }
+            break;
+        }
+    }
+    return pvg_task_walk(s, task, va, gpa);
+}
+
+static void pvg_task_mapping_free(gpointer p)
+{
+    g_free(((PVGTaskMapping *)p)->gpa);
+}
+
+static void pvg_task_unmap(PVGLinuxPCIState *s, uint32_t task, uint64_t va,
+                           uint64_t len)
+{
+    GArray *maps = s->tasks[task].mappings;
+
+    for (guint i = 0; maps && i < maps->len;) {
+        PVGTaskMapping *m = &g_array_index(maps, PVGTaskMapping, i);
+
+        if (m->va >= va && m->va + m->len <= va + len) {
+            g_array_remove_index_fast(maps, i);
+        } else {
+            i++;
+        }
+    }
+}
+
+/* CmdMapMemory2 / CmdUnmapMemory {u32 task, u64 va, u64 len} */
+static void pvg_cmd_map_memory(PVGLinuxPCIState *s, const uint8_t *p,
+                               uint32_t len, bool map)
+{
+    uint32_t task;
+    uint64_t va, size;
+    PVGTaskMapping m;
+
+    if (len < 20) {
+        return;
+    }
+    task = ldl_le_p(p);
+    va = ldq_le_p(p + 4);
+    size = ldq_le_p(p + 12);
+    if (task >= PVG_MAX_TASKS || !s->tasks[task].root || (va | size) & 0xfff ||
+        size > 4 * GiB) {
+        qemu_log_mask(LOG_GUEST_ERROR, "pvg: bad map task %u va 0x%" PRIx64
+                      " len 0x%" PRIx64 "\n", task, va, size);
+        return;
+    }
+    pvg_task_unmap(s, task, va, size);
+    if (!map) {
+        return;
+    }
+    m.va = va;
+    m.len = size;
+    m.gpa = g_new0(uint64_t, size >> 12);
+    for (uint64_t off = 0; off < size; off += 0x1000) {
+        uint64_t gpa;
+
+        if (pvg_task_walk(s, task, va + off, &gpa)) {
+            m.gpa[off >> 12] = gpa;
+        }
+    }
+    if (!s->tasks[task].mappings) {
+        s->tasks[task].mappings = g_array_new(false, false,
+                                              sizeof(PVGTaskMapping));
+        g_array_set_clear_func(s->tasks[task].mappings, pvg_task_mapping_free);
+    }
+    g_array_append_val(s->tasks[task].mappings, m);
+}
