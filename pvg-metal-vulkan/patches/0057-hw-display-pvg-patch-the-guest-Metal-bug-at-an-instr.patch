From 28be21f3bc39e6597fe2fec91c7adc2cbe57fec7 Mon Sep 17 00:00:00 2001
From: Nassos Yiannopoulos <nassosyian@gmail.com>
Date: Fri, 30 Oct 2026 20:36:21 +0200
Subject: [PATCH] hw/display/pvg: patch the guest Metal bug at an instruction
 breakpoint

The nil-architecture assertion lives in the dyld shared cache, which is
compressed and sealed on disk: it can only be patched in RAM, and its page
is first read in by the very call that aborts, so the RAM scan always lost
that race (iconservicesagent and Spotlight crashed once per boot; apps
open at that moment kept placeholder icons).

The cache is mapped at its unslid address plus a per-boot slide in every
process. Find the slide from the cache header in a vCPU's page tables
(sampled while a vCPU runs user code) and put a KVM instruction breakpoint
on the branch: when any process reaches it, the page is resident and gets
patched before the instruction executes. Re-armed on device reset (new
slide). The RAM scan stays as a fallback.

kvm: kvm_set_host_breakpoint() (one host-owned x86 execute breakpoint,
handled without the gdbstub) and kvm_walk_user_pages().

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hw/display/pvg-linux-pci.c        |   1 +
 hw/display/pvg/pvg-guest-fixups.c | 131 +++++++++++++++++++++++++++++-
 hw/display/pvg/pvg-guest-fixups.h |   2 +
 include/system/kvm.h              |  20 +++++
 target/i386/kvm/kvm.c             | 102 +++++++++++++++++++++++
 5 files changed, 252 insertions(+), 4 deletions(-)

diff --git a/hw/display/pvg-linux-pci.c b/hw/display/pvg-linux-pci.c
index f7cf800..e611e89 100644
--- a/hw/display/pvg-linux-pci.c
+++ b/hw/display/pvg-linux-pci.c
@@ -2252,6 +2252,7 @@ static void pvg_linux_reset(DeviceState *dev)
 {
     PVGLinuxPCIState *s = PVG_LINUX_PCI(dev);
 
+    pvg_guest_fixups_reset(s->guest_fixups);
     pvg_exec_drain(s);
     if (s->exec_thread_started) {
         qemu_mutex_lock(&s->exec_lock);
diff --git a/hw/display/pvg/pvg-guest-fixups.c b/hw/display/pvg/pvg-guest-fixups.c
index 847b8ca..6bddecf 100644
--- a/hw/display/pvg/pvg-guest-fixups.c
+++ b/hw/display/pvg/pvg-guest-fixups.c
@@ -11,9 +11,15 @@
  * continue with a nil architecture (slice id 0: no archive slice matches and RenderBox
  * compiles the shaders from source, as on a device without binary archives).
  *
- * The shared cache text is shared by every process and stays resident, but a clean page can
- * be dropped and read back from disk, so a background thread scans guest RAM for each
- * signature and re-checks the patched sites every few seconds.
+ * The code is in the dyld shared cache, which is compressed and sealed on disk, so it can only
+ * be patched in RAM, and its page is first read in by the very call that crashes: scanning RAM
+ * always loses that race. So with KVM the branch also gets an instruction breakpoint: the
+ * cache is mapped at the same address (its unslid address plus a per-boot slide, found from
+ * the cache header in a vCPU's page tables) in every process, and when any process reaches the
+ * branch its page is resident and is patched before the instruction runs.
+ *
+ * A clean page can be dropped and read back from disk: a background thread also scans guest
+ * RAM for each signature (fallback without KVM) and re-checks the patched sites.
  *
  * Copyright (c) 2026
  * SPDX-License-Identifier: GPL-2.0-or-later
@@ -25,6 +31,11 @@
 #include "qemu/rcu.h"
 #include "system/ramlist.h"
 #include "system/ramblock.h"
+#include "qemu/timer.h"
+#include "hw/core/cpu.h"
+#include "system/kvm.h"
+#include "system/hw_accel.h"
+#include "system/address-spaces.h"
 #include "pvg-guest-fixups.h"
 
 typedef struct GuestFixup {
@@ -71,6 +82,15 @@ static const GuestFixup fixups[] = {
       sizeof(slice_branch_sig), 0x36a, 13, je_next, sizeof(je_next) },
 };
 
+/* dyld shared cache of this macOS build: unslid base and the branch's `je` (fixups[1] + 12) */
+#define SHARED_CACHE_BASE   0x7ff800000000ULL
+#define BRANCH_JE_UNSLID    0x7ff80f5b7376ULL
+#define BRANCH_FIXUP        1
+/* vCPUs are rarely caught in user mode: sample often (a cheap walk) until it is armed */
+#define SLIDE_SEARCH_MS     50
+
+static const uint8_t cache_magic[16] = "dyld_v1 x86_64h";
+
 #define MAX_SITES       16
 #define CHECK_MS        1000
 #define SCAN_MISSING_MS 200        /* a page-offset scan of 8 GiB takes ~10-20 ms */
@@ -86,6 +106,9 @@ struct PVGGuestFixups {
     uint8_t *sites[ARRAY_SIZE(fixups)][MAX_SITES];
     unsigned nsites[ARRAY_SIZE(fixups)];
     uint64_t patches;
+    QEMUTimer *bp_timer;        /* main loop: looks for the cache slide until the bp is armed */
+    uint64_t bp_addr;           /* armed instruction breakpoint (0: none) */
+    uint64_t bp_hits;
 };
 
 static void fx_log(PVGGuestFixups *f, const char *fmt, ...) G_GNUC_PRINTF(2, 3);
@@ -194,7 +217,7 @@ static void *fixup_thread(void *opaque)
             found_any |= f->nsites[i] != 0;
         }
         /* either site fixes the bug (the .cold page may never be paged in once the branch is) */
-        missing = !found_any;
+        missing = !found_any && !qatomic_read(&f->bp_addr);
         /* full scans are expensive (all of guest RAM): often until found, then rarely */
         if (now - last_scan >= (missing ? SCAN_MISSING_MS : RESCAN_MS)) {
             ScanCtx c = { .f = f };
@@ -211,6 +234,96 @@ static void *fixup_thread(void *opaque)
     return NULL;
 }
 
+/* vCPU thread, CPU state synchronized: the branch is about to run, so its page is resident */
+static void branch_bp_hit(CPUState *cs, uint64_t pc, void *opaque)
+{
+    PVGGuestFixups *f = opaque;
+    const GuestFixup *fx = &fixups[BRANCH_FIXUP];
+    TranslateForDebugResult tr;
+    uint8_t buf[sizeof(slice_branch_sig)];
+    hwaddr site;
+
+    f->bp_hits++;
+    if (!cpu_translate_for_debug(cs, pc, &tr)) {
+        return;
+    }
+    site = (tr.physaddr & ~(hwaddr)0xfff) + fx->page_off;
+    if (address_space_read(&address_space_memory, site, MEMTXATTRS_UNSPECIFIED, buf,
+                           fx->sig_len) != MEMTX_OK ||
+        memcmp(buf, fx->sig, fx->sig_len)) {
+        return;     /* already patched, or not this code (another shared cache) */
+    }
+    address_space_write(&address_space_memory, site + fx->patch_off, MEMTXATTRS_UNSPECIFIED,
+                        fx->patch, fx->patch_len);
+    qemu_mutex_lock(&f->lock);
+    f->patches++;
+    fx_log(f, "guest fixup: %s patched (breakpoint, hit #%" PRIu64 ") at guest physical 0x%"
+           HWADDR_PRIx " (patch #%" PRIu64 ")", fx->name, f->bp_hits, site, f->patches);
+    qemu_mutex_unlock(&f->lock);
+}
+
+typedef struct SlideCtx {
+    uint64_t header_va;         /* lowest mapped page of the cache region, if it is the header */
+} SlideCtx;
+
+static bool check_cache_header(uint64_t va, uint64_t pa, void *opaque)
+{
+    SlideCtx *c = opaque;
+    uint8_t hdr[0xe8];
+
+    if (address_space_read(&address_space_memory, pa, MEMTXATTRS_UNSPECIFIED, hdr,
+                           sizeof(hdr)) == MEMTX_OK &&
+        !memcmp(hdr, cache_magic, sizeof(cache_magic)) &&
+        ldq_le_p(hdr + 0xe0) == SHARED_CACHE_BASE) {
+        c->header_va = va;
+    }
+    return true;    /* the cache starts at the region's first mapped page: look no further */
+}
+
+static void find_cache_header(CPUState *cs, run_on_cpu_data data)
+{
+    SlideCtx *c = data.host_ptr;
+
+    cpu_synchronize_state(cs);
+    /* the slid cache lies above its unslid base, below the end of user space */
+    kvm_walk_user_pages(cs, SHARED_CACHE_BASE, 1ULL << 47, check_cache_header, c);
+}
+
+/* main loop: find the shared cache slide from any vCPU's address space, then arm the bp */
+static void bp_search(void *opaque)
+{
+    PVGGuestFixups *f = opaque;
+    CPUState *cs;
+
+    CPU_FOREACH(cs) {
+        SlideCtx c = { 0 };
+
+        run_on_cpu(cs, find_cache_header, RUN_ON_CPU_HOST_PTR(&c));
+        if (c.header_va) {
+            uint64_t slide = c.header_va - SHARED_CACHE_BASE;
+
+            qatomic_set(&f->bp_addr, BRANCH_JE_UNSLID + slide);
+            kvm_set_host_breakpoint(f->bp_addr, branch_bp_hit, f);
+            fx_log(f, "guest fixup: shared cache slide 0x%" PRIx64 ", breakpoint at 0x%" PRIx64,
+                   slide, f->bp_addr);
+            return;
+        }
+    }
+    timer_mod(f->bp_timer, qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + SLIDE_SEARCH_MS);
+}
+
+void pvg_guest_fixups_reset(PVGGuestFixups *f)
+{
+    if (!f || !f->bp_timer) {
+        return;
+    }
+    if (f->bp_addr) {
+        qatomic_set(&f->bp_addr, 0);
+        kvm_set_host_breakpoint(0, NULL, NULL);     /* the next boot has another slide */
+    }
+    timer_mod(f->bp_timer, qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + SLIDE_SEARCH_MS);
+}
+
 PVGGuestFixups *pvg_guest_fixups_start(PVGGuestFixupLog log, void *opaque)
 {
     PVGGuestFixups *f = g_new0(PVGGuestFixups, 1);
@@ -220,6 +333,10 @@ PVGGuestFixups *pvg_guest_fixups_start(PVGGuestFixupLog log, void *opaque)
     qemu_mutex_init(&f->lock);
     qemu_cond_init(&f->cond);
     qemu_thread_create(&f->thread, "pvg-fixups", fixup_thread, f, QEMU_THREAD_JOINABLE);
+    if (kvm_enabled()) {
+        f->bp_timer = timer_new_ms(QEMU_CLOCK_REALTIME, bp_search, f);
+        timer_mod(f->bp_timer, qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + SLIDE_SEARCH_MS);
+    }
     return f;
 }
 
@@ -228,6 +345,12 @@ void pvg_guest_fixups_stop(PVGGuestFixups *f)
     if (!f) {
         return;
     }
+    if (f->bp_timer) {
+        timer_free(f->bp_timer);
+        if (f->bp_addr) {
+            kvm_set_host_breakpoint(0, NULL, NULL);
+        }
+    }
     qemu_mutex_lock(&f->lock);
     f->stop = true;
     qemu_cond_signal(&f->cond);
diff --git a/hw/display/pvg/pvg-guest-fixups.h b/hw/display/pvg/pvg-guest-fixups.h
index 8ee91e2..7ed6e67 100644
--- a/hw/display/pvg/pvg-guest-fixups.h
+++ b/hw/display/pvg/pvg-guest-fixups.h
@@ -13,5 +13,7 @@ typedef void (*PVGGuestFixupLog)(void *opaque, const char *msg);
 /* Start the background thread that finds and patches known guest bugs in guest RAM */
 PVGGuestFixups *pvg_guest_fixups_start(PVGGuestFixupLog log, void *opaque);
 void pvg_guest_fixups_stop(PVGGuestFixups *f);
+/* the guest is rebooting: find the next boot's shared cache slide again */
+void pvg_guest_fixups_reset(PVGGuestFixups *f);
 
 #endif
diff --git a/include/system/kvm.h b/include/system/kvm.h
index 714b8c7..82c4ad8 100644
--- a/include/system/kvm.h
+++ b/include/system/kvm.h
@@ -461,6 +461,26 @@ int kvm_arch_on_vmfd_change(MachineState *ms, KVMState *s);
 
 void kvm_cpu_synchronize_state(CPUState *cpu);
 
+/*
+ * One instruction breakpoint at guest linear address addr on every vCPU, owned by host code
+ * rather than the gdbstub (x86 KVM only). fn runs on the vCPU thread with the CPU state
+ * synchronized; the vCPU then executes the instruction and continues. addr 0 removes it.
+ * Call with the BQL held, outside vCPU threads.
+ */
+typedef void KVMHostBreakpointFn(CPUState *cpu, uint64_t pc, void *opaque);
+void kvm_set_host_breakpoint(uint64_t addr, KVMHostBreakpointFn *fn, void *opaque);
+
+/*
+ * x86: call fn(va, pa) for each present page of start..end (page aligned) in cpu's current
+ * address space, in address order, until it returns true. Only while the vCPU runs in user
+ * mode (its page tables then map that process); returns false otherwise. Call on the vCPU's
+ * thread with its state synchronized.
+ */
+typedef bool KVMUserPageFn(uint64_t va, uint64_t pa, void *opaque);
+bool kvm_walk_user_pages(CPUState *cpu, uint64_t start, uint64_t end, KVMUserPageFn *fn,
+                         void *opaque);
+
+
 void kvm_init_cpu_signals(CPUState *cpu);
 
 /**
diff --git a/target/i386/kvm/kvm.c b/target/i386/kvm/kvm.c
index 644c45f..caeb841 100644
--- a/target/i386/kvm/kvm.c
+++ b/target/i386/kvm/kvm.c
@@ -6240,6 +6240,93 @@ void kvm_arch_remove_all_gdbstub_hw_breakpoints(void)
 
 static CPUWatchpoint hw_watchpoint;
 
+/* one instruction breakpoint owned by host code, after the gdbstub's (kvm_set_host_breakpoint) */
+static struct {
+    uint64_t addr;
+    KVMHostBreakpointFn *fn;
+    void *opaque;
+} host_bp;
+
+static void kvm_host_bp_update(CPUState *cpu, run_on_cpu_data data)
+{
+    kvm_update_guest_debug(cpu, 0);
+}
+
+void kvm_set_host_breakpoint(uint64_t addr, KVMHostBreakpointFn *fn, void *opaque)
+{
+    CPUState *cpu;
+
+    host_bp.fn = fn;
+    host_bp.opaque = opaque;
+    host_bp.addr = addr;
+    CPU_FOREACH(cpu) {
+        run_on_cpu(cpu, kvm_host_bp_update, RUN_ON_CPU_NULL);
+    }
+}
+
+bool kvm_walk_user_pages(CPUState *cs, uint64_t start, uint64_t end, KVMUserPageFn *fn,
+                         void *opaque)
+{
+    CPUX86State *env = &X86_CPU(cs)->env;
+    const uint64_t addr_mask = 0x000ffffffffff000ULL;
+    uint64_t pml4, va;
+
+    /* user mode, 4-level long mode paging, lower half only */
+    if ((env->hflags & HF_CPL_MASK) != 3 || !(env->hflags & HF_LMA_MASK) ||
+        (env->cr[4] & CR4_LA57_MASK) || end > (1ULL << 47) || start >= end) {
+        return false;
+    }
+    pml4 = env->cr[3] & addr_mask;
+    for (va = start; va < end;) {
+        uint64_t e = x86_ldq_phys(cs, pml4 + ((va >> 39) & 0x1ff) * 8);
+        uint64_t next = (va | ((1ULL << 39) - 1)) + 1;
+
+        if (e & PG_PRESENT_MASK) {
+            uint64_t pdpt = e & addr_mask;
+
+            for (; va < MIN(next, end);) {
+                uint64_t e3 = x86_ldq_phys(cs, pdpt + ((va >> 30) & 0x1ff) * 8);
+                uint64_t next3 = (va | ((1ULL << 30) - 1)) + 1;
+
+                if ((e3 & PG_PRESENT_MASK) && (e3 & PG_PSE_MASK)) {
+                    if (fn(va, (e3 & addr_mask & ~((1ULL << 30) - 1)) + (va & ((1ULL << 30) - 1)),
+                           opaque)) {
+                        return true;
+                    }
+                } else if (e3 & PG_PRESENT_MASK) {
+                    uint64_t pd = e3 & addr_mask;
+
+                    for (; va < MIN(next3, end);) {
+                        uint64_t e2 = x86_ldq_phys(cs, pd + ((va >> 21) & 0x1ff) * 8);
+                        uint64_t next2 = (va | ((1ULL << 21) - 1)) + 1;
+
+                        if ((e2 & PG_PRESENT_MASK) && (e2 & PG_PSE_MASK)) {
+                            if (fn(va, (e2 & addr_mask & ~((1ULL << 21) - 1)) +
+                                   (va & ((1ULL << 21) - 1)), opaque)) {
+                                return true;
+                            }
+                        } else if (e2 & PG_PRESENT_MASK) {
+                            uint64_t pt = e2 & addr_mask;
+
+                            for (; va < MIN(next2, end); va += 4096) {
+                                uint64_t e1 = x86_ldq_phys(cs, pt + ((va >> 12) & 0x1ff) * 8);
+
+                                if ((e1 & PG_PRESENT_MASK) && fn(va, e1 & addr_mask, opaque)) {
+                                    return true;
+                                }
+                            }
+                        }
+                        va = next2;
+                    }
+                }
+                va = next3;
+            }
+        }
+        va = next;
+    }
+    return true;
+}
+
 static int kvm_handle_debug(X86CPU *cpu,
                             struct kvm_debug_exit_arch *arch_info)
 {
@@ -6248,6 +6335,15 @@ static int kvm_handle_debug(X86CPU *cpu,
     int ret = 0;
     int n;
 
+    if (host_bp.addr && arch_info->exception == EXCP01_DB &&
+        !(arch_info->dr6 & DR6_BS) && arch_info->pc == host_bp.addr) {
+        cpu_synchronize_state(cs);
+        if (host_bp.fn) {
+            host_bp.fn(cs, arch_info->pc, host_bp.opaque);
+        }
+        env->eflags |= RF_MASK;     /* resume: execute the instruction without trapping again */
+        return 0;
+    }
     if (arch_info->exception == EXCP01_DB) {
         if (arch_info->dr6 & DR6_BS) {
             if (cpu_single_stepping(cs)) {
@@ -6318,6 +6414,12 @@ void kvm_arch_update_guest_debug(CPUState *cpu, struct kvm_guest_debug *dbg)
                 ((uint32_t)len_code[hw_breakpoint[n].len] << (18 + n*4));
         }
     }
+    if (host_bp.addr && nb_hw_breakpoint < 4) {
+        /* execute breakpoint (type 0, length 1) in the next free slot, globally enabled */
+        dbg->control |= KVM_GUESTDBG_ENABLE | KVM_GUESTDBG_USE_HW_BP;
+        dbg->arch.debugreg[7] |= 0x0600 | (2 << (nb_hw_breakpoint * 2));
+        dbg->arch.debugreg[nb_hw_breakpoint] = host_bp.addr;
+    }
 }
 
 static int kvm_install_msr_filters(KVMState *s)
-- 
