+/*
+ * Transaction3 gamma table (sent only when it changes): kernel-task VA of entries x 3 planar
+ * float32 channels (R[entries], G[entries], B[entries]), identity by default.
+ */
+static void pvg_display_set_gamma(PVGLinuxPCIState *s, uint64_t va, uint64_t len,
+                                  uint32_t entries)
+{
+    g_autofree float *t = NULL;
+    bool identity = true;
+
+    if (entries < 2 || entries > 4096 || len < (uint64_t)entries * 12) {
+        return;
+    }
+    t = g_new(float, entries * 3);
+    if (!pvg_task_read(s, 0, va, t, entries * 12)) {
+        return;
+    }
+    for (int c = 0; c < 3; c++) {
+        for (int v = 0; v < 256; v++) {
+            float f = t[c * entries + v * (entries - 1) / 255];
+            int o = (int)(f * 255.0f + 0.5f);
+
+            s->gamma_lut[c][v] = o < 0 ? 0 : o > 255 ? 255 : o;
+            identity &= s->gamma_lut[c][v] == v;
+        }
+    }
+    s->gamma_active = !identity;
+}
