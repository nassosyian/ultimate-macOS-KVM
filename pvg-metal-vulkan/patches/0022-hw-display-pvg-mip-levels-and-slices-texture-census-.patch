+/*
+ * Diagnostics (dump mode): first sight of each sampled texture (task, ref, va, size): log its
+ * shape and how much of it is non-zero, and dump it (to find layers that never reach the screen).
+ */
+static void tex_census(PVGExec *e, uint32_t task, uint32_t ref, const GuestImage *gi)
+{
+    g_autofree char *key = NULL;
+    g_autofree uint8_t *px = NULL;
+    uint64_t size = (uint64_t)gi->row_bytes * gi->height, nz = 0, n = 0;
+
+    if (!e->dump_dir || e->census_count >= 600 || size > (16u << 20)) {
+        return;
+    }
+    key = g_strdup_printf("%u:%u:%" G_GINT64_MODIFIER "x:%ux%u", task, ref, gi->va, gi->width,
+                          gi->height);
+    if (g_hash_table_contains(e->census, key)) {
+        return;
+    }
+    g_hash_table_add(e->census, g_steal_pointer(&key));
+    e->census_count++;
+    px = g_malloc(size);
+    if (!e->host.read(e->host.opaque, gi->task, gi->va, px, size)) {
+        elog(e, "census task %u ref %u %ux%u fmt %d: unreadable", task, ref, gi->width,
+             gi->height, gi->format);
+        return;
+    }
+    for (uint64_t k = 0; k < size; k += 61, n++) {
+        nz += px[k] != 0;
+    }
+    elog(e, "census task %u ref %u %ux%ux%u view %d fmt %d stride %u: nonzero %" G_GUINT64_FORMAT
+         "/%" G_GUINT64_FORMAT, task, ref, gi->width, gi->height, gi->layers, gi->view_type,
+         gi->format, gi->row_bytes, nz, n);
+    if (gi->layers * gi->depth == 1) {
+        g_autofree char *path = g_strdup_printf("%s/tex-%04u-t%u-r%u-fmt%d-%ux%u-s%u.raw",
+                                                e->dump_dir, e->census_count, task, ref,
+                                                gi->format, gi->width, gi->height, gi->row_bytes);
+
+        g_file_set_contents(path, (const char *)px, (gssize)size, NULL);
+    }
+}
