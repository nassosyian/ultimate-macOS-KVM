+        } else {
+            if (s->gamma_active) {
+                for (uint32_t x = 0; x < width; x++) {
+                    uint32_t p = row[x];
+
+                    row[x] = (p & 0xff000000) | s->gamma_lut[0][p >> 16 & 0xff] << 16 |
+                             s->gamma_lut[1][p >> 8 & 0xff] << 8 | s->gamma_lut[2][p & 0xff];
+                }
+            }
+            if (y % 64 == 0) {
+                for (uint32_t x = 0; x < width; x += 16) {
+                    nonzero += (row[x] & 0xffffff) != 0;
+                }
             }
         }
     }
