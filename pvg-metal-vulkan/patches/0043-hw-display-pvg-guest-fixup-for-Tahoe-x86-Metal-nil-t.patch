                 if_true: [files('pvg-linux-pci.c', 'pvg/pvg-gpu.c', 'pvg/pvg-exec.c', 'pvg/air2spv.c',
-                                'pvg/spv.c'),
+                                'pvg/spv.c', 'pvg/pvg-guest-fixups.c'),
                           pvg_vulkan, pvg_llvm])
 else
-  system_ss.add(when: 'CONFIG_PVG_LINUX_PCI', if_true: files('pvg-linux-pci.c'))
+  system_ss.add(when: 'CONFIG_PVG_LINUX_PCI', if_true: files('pvg-linux-pci.c', 'pvg/pvg-guest-fixups.c'))
 endif
 
 if config_all_devices.has_key('CONFIG_VIRTIO_GPU')
