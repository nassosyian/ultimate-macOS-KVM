From f7de6dcba2872718b097e3d710c1910728679c0d Mon Sep 17 00:00:00 2001
From: Nassos Yiannopoulos <nassosyian@gmail.com>
Date: Thu, 29 Oct 2026 20:07:17 +0200
Subject: [PATCH 34/54] hw/display/pvg/pvg-exec: clamp image write-backs to the
 object span; compute I/O diagnostics

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hw/display/pvg/pvg-exec.c | 80 +++++++++++++++++++++++++++++++++++----
 1 file changed, 73 insertions(+), 7 deletions(-)

diff --git a/hw/display/pvg/pvg-exec.c b/hw/display/pvg/pvg-exec.c
index 3dd13c4..60982a8 100644
--- a/hw/display/pvg/pvg-exec.c
+++ b/hw/display/pvg/pvg-exec.c
@@ -91,6 +91,7 @@ typedef struct GuestImage {
     uint32_t depth, layers;     /* 3D depth; array layers (6 per cube) */
     uint64_t slice_bytes;       /* bytes per 2D image / array layer */
     uint32_t mips;              /* levels described below (1 for a single level/slice view) */
+    uint64_t span;              /* bytes from va that belong to the object (0 = unknown) */
     uint64_t mip_off[MAX_MIPS], mip_slice[MAX_MIPS];   /* relative to va; bytes per image */
     uint32_t mip_row[MAX_MIPS];
     VkImageViewType view_type;
@@ -155,7 +156,7 @@ struct PVGExec {
     GHashTable *uploaded;       /* per command buffer: task << 32 | id → arena offset + 1 */
     GHashTable *samplers;       /* task << 32 | id → VkSampler (as pointer) */
     uint32_t upload_failures, ds_kind_logged, ds_states_logged, ds_dumps, blends_logged;
-    uint32_t texfail_logged;
+    uint32_t texfail_logged, cwb_logged, cio_dumps;
     DSAttachmentSave last_ds;
     HostImage dummy[7];         /* 1x1 placeholders per VkImageViewType */
     GHashTable *written;
@@ -490,6 +491,7 @@ static bool guest_image_ex(PVGExec *e, uint32_t task, uint32_t ref, int level, u
         rec = obj + 0x24 + first * 0x24;
         gi->task = task;
         gi->va = ((uint64_t)ldl(obj + 8) << 12) + ldq(obj + 0x10) + ldq(rec);
+        gi->span = ldl(obj) > ldq(rec) ? ldl(obj) - ldq(rec) : 0;
         gi->row_bytes = (uint32_t)ldq(rec + 0x10);
         gi->slice_bytes = ldq(rec + 8);
         gi->width = ldl(rec + 0x18);
@@ -517,6 +519,7 @@ static bool guest_image_ex(PVGExec *e, uint32_t task, uint32_t ref, int level, u
                 return false;
             }
             gi->va += slice * gi->slice_bytes;
+            gi->span = gi->span > slice * gi->slice_bytes ? gi->span - slice * gi->slice_bytes : 0;
             gi->view_type = gi->height > 1 || gi->view_type != VK_IMAGE_VIEW_TYPE_1D_ARRAY ?
                             VK_IMAGE_VIEW_TYPE_2D : VK_IMAGE_VIEW_TYPE_1D;
             gi->layers = gi->depth = 1;
@@ -556,6 +559,7 @@ static bool guest_image_ex(PVGExec *e, uint32_t task, uint32_t ref, int level, u
         gi->width = ldl(desc + 4) ? ldl(desc + 4) : ldl(pl + 4);
         gi->height = ldl(desc + 8) ? ldl(desc + 8) : ldl(pl + 8);
         gi->row_bytes = ldl(pl + 12) & 0xffffff;
+        gi->span = (uint64_t)ldl(pl + 8) * gi->row_bytes;     /* the plane's own rows */
         gi->view_type = VK_IMAGE_VIEW_TYPE_2D;
         gi->depth = gi->layers = 1;
         gi->mips = 1;
@@ -592,6 +596,12 @@ static bool guest_image_ex(PVGExec *e, uint32_t task, uint32_t ref, int level, u
            guest_image_size(gi) <= (64u << 20);
 }
 
+/* bytes of an image to write back: never beyond the memory the object owns */
+static uint64_t wb_size(const GuestImage *gi, uint64_t size)
+{
+    return gi->span && gi->span < size ? gi->span : size;
+}
+
 static bool guest_image(PVGExec *e, uint32_t task, uint32_t ref, GuestImage *gi)
 {
     return guest_image_ex(e, task, ref, -1, 0, gi);
@@ -2286,6 +2296,12 @@ static void exec_render_segment(PVGExec *e, uint32_t task, const uint8_t *p, uin
     }
     vkCmdEndRendering(e->cmd);
     if (att[0].img && att[0].gi.task == 0 && att[0].gi.width >= 1024 && e->stats.segments < 20000) {
+        uint64_t g0 = 0;
+
+        if (e->host.translate) {
+            e->host.translate(e->host.opaque, 0, att[0].gi.va, &g0);
+        }
+        elog(e, "segment gpa 0x%" G_GINT64_MODIFIER "x", g0);
         elog(e, "segment task %u -> kernel 0x%" G_GINT64_MODIFIER "x %ux%u load %u: draws %u "
              "skipped %u dummy-tex %u pipelines %u %u %u %u", task, att[0].gi.va, rw, rh,
              att[0].load, seg_draws, seg_skipped, seg_dummy, nseg_pipes > 0 ? seg_pipes[0] : 0,
@@ -2397,11 +2413,11 @@ static void exec_render_segment(PVGExec *e, uint32_t task, const uint8_t *p, uin
             }
         }
         if (att[i].wb_off != UINT64_MAX) {
-            note_write(e, att[i].gi.task, att[i].gi.va,
-                       (uint64_t)att[i].gi.row_bytes * att[i].gi.height, 'R');
+            uint64_t n = wb_size(&att[i].gi, (uint64_t)att[i].gi.row_bytes * att[i].gi.height);
+
+            note_write(e, att[i].gi.task, att[i].gi.va, n, 'R');
             e->host.write(e->host.opaque, att[i].gi.task, att[i].gi.va,
-                          e->arena_ptr + att[i].wb_off,
-                          (uint64_t)att[i].gi.row_bytes * att[i].gi.height);
+                          e->arena_ptr + att[i].wb_off, n);
             e->stats.writebacks++;
         }
     }
@@ -2577,6 +2593,15 @@ fail:
     return p;
 }
 
+/* diagnostics: compute I/O dumps only for kernels whose name contains $PVG_CIO_FILTER */
+static bool cio_match(PVGExec *e, const char *kernel)
+{
+    const char *f = getenv("PVG_CIO_FILTER");
+
+    (void)e;
+    return !f || !*f || strstr(kernel, f);
+}
+
 typedef struct ComputeState {
     uint32_t pipeline;
     Binding buf[MAX_SLOTS];
@@ -2603,6 +2628,7 @@ static void exec_compute_segment(PVGExec *e, uint32_t task, const uint8_t *p, ui
     ComputeState cs = { 0 };
     ComputeOutput out[64];
     uint32_t nout = 0, off = 0, dispatches = 0;
+    bool cio_last = false;      /* diagnostics: a dispatch of this segment matched the filter */
     VkCommandBufferBeginInfo bi = { .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
                                     .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT };
     VkSubmitInfo si = { .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO, .commandBufferCount = 1,
@@ -2732,6 +2758,19 @@ static void exec_compute_segment(PVGExec *e, uint32_t task, const uint8_t *p, ui
                         image_upload(e, &gi, hi, general ? VK_IMAGE_LAYOUT_GENERAL :
                                      VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
                         up_ref[nup++] = cs.tex[i];
+                        if (e->dump_dir && e->cio_dumps < 12 && gi.layers * gi.depth == 1 &&
+                            cio_match(e, pp->fs_name)) {
+                            uint64_t n = (uint64_t)gi.row_bytes * gi.height;
+                            g_autofree uint8_t *px = n <= (32u << 20) ? g_malloc(n) : NULL;
+                            g_autofree char *path = g_strdup_printf(
+                                "%s/cio-%02u-in-t%u-%s-slot%d-r%u-fmt%d-%ux%u-s%u.raw",
+                                e->dump_dir, e->cio_dumps, task, pp->fs_name, i, cs.tex[i],
+                                gi.format, gi.width, gi.height, gi.row_bytes);
+
+                            if (px && e->host.read(e->host.opaque, gi.task, gi.va, px, n)) {
+                                g_file_set_contents(path, (const char *)px, (gssize)n, NULL);
+                            }
+                        }
                     }
                     if (storage && nout < G_N_ELEMENTS(out)) {
                         out[nout++] = (ComputeOutput){ .image = true, .gi = gi, .hi = hi };
@@ -2799,6 +2838,7 @@ static void exec_compute_segment(PVGExec *e, uint32_t task, const uint8_t *p, ui
                 e->push_descriptor(e->cmd, VK_PIPELINE_BIND_POINT_COMPUTE, pp->layout, 0, nw, w);
             }
             vkCmdDispatch(e->cmd, groups[0], groups[1], groups[2]);
+            cio_last |= cio_match(e, pp->fs_name);
             {
                 /* later dispatches / the read-back see this one's writes */
                 VkMemoryBarrier mb = { .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
@@ -2851,10 +2891,33 @@ static void exec_compute_segment(PVGExec *e, uint32_t task, const uint8_t *p, ui
         if (out[i].arena_off == UINT64_MAX || !out[i].size) {
             continue;
         }
+        if (e->dump_dir && e->host.translate && e->cwb_logged < 400) {
+            uint32_t t = out[i].image ? out[i].gi.task : task;
+            uint64_t va = out[i].image ? out[i].gi.va : out[i].va, g0 = 0, g1 = 0;
+
+            e->cwb_logged++;
+            e->host.translate(e->host.opaque, t, va, &g0);
+            e->host.translate(e->host.opaque, t, va + out[i].size - 1, &g1);
+            elog(e, "compute writeback task %u %s va 0x%" G_GINT64_MODIFIER "x size 0x%"
+                 G_GINT64_MODIFIER "x gpa 0x%" G_GINT64_MODIFIER "x..0x%" G_GINT64_MODIFIER "x"
+                 " (%ux%u row %u)", t, out[i].image ? "image" : "buffer", va, out[i].size, g0,
+                 g1, out[i].gi.width, out[i].gi.height, out[i].gi.row_bytes);
+        }
         if (out[i].image) {
-            note_write(e, out[i].gi.task, out[i].gi.va, out[i].size, 'C');
+            uint64_t n = wb_size(&out[i].gi, out[i].size);
+
+            if (e->dump_dir && e->cio_dumps < 12 && cio_last) {
+                g_autofree char *path = g_strdup_printf(
+                    "%s/cio-%02u-out-t%u-fmt%d-%ux%u-s%u.raw", e->dump_dir, e->cio_dumps,
+                    out[i].gi.task, out[i].gi.format, out[i].gi.width, out[i].gi.height,
+                    out[i].gi.row_bytes);
+
+                g_file_set_contents(path, (const char *)(e->arena_ptr + out[i].arena_off),
+                                    (gssize)n, NULL);
+            }
+            note_write(e, out[i].gi.task, out[i].gi.va, n, 'C');
             e->host.write(e->host.opaque, out[i].gi.task, out[i].gi.va,
-                          e->arena_ptr + out[i].arena_off, out[i].size);
+                          e->arena_ptr + out[i].arena_off, n);
         } else {
             note_write(e, task, out[i].va, out[i].size, 'C');
             e->host.write(e->host.opaque, task, out[i].va, e->arena_ptr + out[i].arena_off,
@@ -2862,6 +2925,9 @@ static void exec_compute_segment(PVGExec *e, uint32_t task, const uint8_t *p, ui
         }
         e->stats.writebacks++;
     }
+    if (e->dump_dir && nout && e->cio_dumps < 12 && cio_last) {
+        e->cio_dumps++;
+    }
     /* uploads were only valid for this submission */
     e->arena_used = 0;
     g_hash_table_remove_all(e->uploaded);
-- 
2.43.0

