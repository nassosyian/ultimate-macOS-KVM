+typedef struct PVGRamBlocks {
+    uint64_t (*blocks)[3];
+    uint32_t n, max;
+} PVGRamBlocks;
+
+static int pvg_exec_ram_block(RAMBlock *rb, void *opaque)
+{
+    PVGRamBlocks *c = opaque;
+
+    /* guest system RAM only (ROMs, VGA RAM and option ROMs are small) */
+    if (c->n < c->max && qemu_ram_get_host_addr(rb) && qemu_ram_get_used_length(rb) >= 256 * MiB) {
+        c->blocks[c->n][0] = qemu_ram_get_offset(rb);
+        c->blocks[c->n][1] = (uintptr_t)qemu_ram_get_host_addr(rb);
+        c->blocks[c->n][2] = qemu_ram_get_used_length(rb);
+        c->n++;
+    }
+    return 0;
+}
+
+static uint32_t pvg_exec_ram_blocks(void *opaque, uint64_t (*blocks)[3], uint32_t max)
+{
+    PVGRamBlocks c = { .blocks = blocks, .max = max };
+
+    RCU_READ_LOCK_GUARD();
+    qemu_ram_foreach_block(pvg_exec_ram_block, &c);
+    return c.n;
+}
+
+/* the GPU wrote guest RAM directly: keep dirty tracking (migration, VGA log) in step */
+static void pvg_exec_mark_dirty(void *opaque, uint64_t ram, uint64_t len)
+{
+    physical_memory_set_dirty_range(ram, len, DIRTY_CLIENTS_NOCODE);
+}
