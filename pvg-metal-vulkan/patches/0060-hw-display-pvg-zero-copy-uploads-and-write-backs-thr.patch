+/*
+ * Guest memory -> arena offset off, for the GPU: a GPU gather into the twin with zero-copy;
+ * otherwise (and as fallback) a CPU copy into the arena, then copied on into the twin.
+ */
+static bool guest_to_arena_in(PVGExec *e, uint32_t task, uint64_t cva, uint64_t clen,
+                              uint64_t va, uint64_t off, uint64_t len)
+{
+    VkBufferCopy r = { .srcOffset = off, .dstOffset = off, .size = len };
+
+    if (e->zc && zc_copy(e, task, cva, clen, va, len, off, false)) {
+        return true;
+    }
+    if (!e->host.read(e->host.opaque, task, va, e->arena_ptr + off, len)) {
+        return false;
+    }
+    if (e->zc && len) {
+        vkCmdCopyBuffer(zc_cmd(e, false), e->arena, e->stage, 1, &r);
+        e->stats.zc_fallbacks++;
+    }
+    return true;
+}
+
+/*
+ * Arena offset off (written by the GPU in this submission) -> task va..va+len, as a GPU
+ * scatter recorded for after the submission (true: done when it completes). false: the
+ * caller writes it from the arena with the CPU after the submission (with zero-copy the
+ * twin's bytes are copied into the arena for that).
+ */
+static bool arena_to_guest_in(PVGExec *e, uint32_t task, uint64_t cva, uint64_t clen,
+                              uint64_t va, uint64_t off, uint64_t len)
+{
+    VkBufferCopy r = { .srcOffset = off, .dstOffset = off, .size = len };
+
+    if (!e->zc) {
+        return false;
+    }
+    if (zc_copy(e, task, cva, clen, va, len, off, true)) {
+        return true;
+    }
+    if (len) {
+        vkCmdCopyBuffer(zc_cmd(e, true), e->stage, e->arena, 1, &r);
+        e->stats.zc_fallbacks++;
+    }
+    return false;
+}
+
+/* the same for a whole range (its own enclosing range) */
+static bool guest_to_arena(PVGExec *e, uint32_t task, uint64_t va, uint64_t off, uint64_t len)
+{
+    return guest_to_arena_in(e, task, va, len, va, off, len);
+}
+
+static bool arena_to_guest(PVGExec *e, uint32_t task, uint64_t va, uint64_t off, uint64_t len)
+{
+    return arena_to_guest_in(e, task, va, len, va, off, len);
+}
+
+/* end of one image's or buffer's write-back: later (possibly overlapping) ones come after it */
+static void zc_writeback_done(PVGExec *e)
+{
+    if (e->zc_post_open) {
+        zc_full_barrier(e->zc_post);
+    }
+}
+
+/* gathers/scatters recorded for a command buffer that was never submitted */
+static void zc_discard(PVGExec *e)
+{
+    if (e->zc_pre_open) {
+        vkEndCommandBuffer(e->zc_pre);
+        e->zc_pre_open = false;
+    }
+    if (e->zc_post_open) {
+        vkEndCommandBuffer(e->zc_post);
+        e->zc_post_open = false;
+    }
+}
+
+/* the arena is reused from the start: uploads were only valid for the last submission */
+static void arena_reset(PVGExec *e)
+{
+    e->arena_used = 0;
+    zc_discard(e);
+}
