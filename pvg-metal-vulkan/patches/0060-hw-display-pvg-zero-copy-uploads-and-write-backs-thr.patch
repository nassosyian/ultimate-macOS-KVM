+/* ---- zero-copy: guest RAM imported into Vulkan, copied by GPU transfers ---- */
+
+typedef struct ZCKey {
+    uint64_t va, len;
+    uint32_t task;
+} ZCKey;
+
+typedef struct ZCRuns {
+    uint32_t n;
+    uint64_t base;              /* va of the first page */
+    uint64_t runs[][3];         /* {RAM offset, length, offset from base} */
+} ZCRuns;
+
+#define ZC_CACHE_MAX    8192
+
+static guint zc_key_hash(gconstpointer p)
+{
+    const ZCKey *k = p;
+
+    return g_int64_hash(&k->va) ^ (guint)(k->len * 0x9e3779b1u) ^ k->task;
+}
+
+static gboolean zc_key_equal(gconstpointer a, gconstpointer b)
+{
+    const ZCKey *x = a, *y = b;
+
+    return x->va == y->va && x->len == y->len && x->task == y->task;
+}
+
+/* RAM runs of task va..va+len (page granular), cached until the range is remapped */
+static const ZCRuns *zc_runs(PVGExec *e, uint32_t task, uint64_t va, uint64_t len)
+{
+    ZCKey key = { .va = va, .len = len, .task = task };
+    ZCRuns *r = g_hash_table_lookup(e->zc_cache, &key);
+    uint32_t pages = (uint32_t)((((va + len + 0xfff) & ~0xfffull) - (va & ~0xfffull)) >> 12);
+    uint32_t n;
+
+    if (r) {
+        return r;
+    }
+    if (pages + 1 > e->zc_runs_max) {
+        e->zc_runs_max = pages + 1;
+        e->zc_runs = g_realloc(e->zc_runs, e->zc_runs_max * sizeof(*e->zc_runs));
+    }
+    n = e->host.ram_runs(e->host.opaque, task, va, len, e->zc_runs, e->zc_runs_max);
+    if (!n) {
+        return NULL;
+    }
+    if (g_hash_table_size(e->zc_cache) >= ZC_CACHE_MAX) {
+        g_hash_table_remove_all(e->zc_cache);
+    }
+    r = g_malloc(sizeof(*r) + n * sizeof(r->runs[0]));
+    r->n = n;
+    r->base = va & ~0xfffull;
+    uint64_t at = 0;
+
+    for (uint32_t i = 0; i < n; at += e->zc_runs[i][1], i++) {
+        r->runs[i][0] = e->zc_runs[i][0];
+        r->runs[i][1] = e->zc_runs[i][1];
+        r->runs[i][2] = at;
+    }
+    g_hash_table_insert(e->zc_cache, g_memdup2(&key, sizeof(key)), r);
+    return r;
+}
+
+void pvg_exec_mapping_changed(PVGExec *e, uint32_t task, uint64_t va, uint64_t len)
+{
+    GHashTableIter it;
+    gpointer k;
+
+    if (!e->zc_cache) {
+        return;
+    }
+    g_hash_table_iter_init(&it, e->zc_cache);
+    while (g_hash_table_iter_next(&it, &k, NULL)) {
+        const ZCKey *z = k;
+
+        if (z->task == task && (!len || (z->va < va + len && va < z->va + z->len))) {
+            g_hash_table_iter_remove(&it);
+        }
+    }
+}
+
+static bool zc_import(PVGExec *e, uint64_t ram, uint8_t *host, uint64_t len)
+{
+    PVGGpu *g = e->gpu;
+    PFN_vkGetMemoryHostPointerPropertiesEXT get_props = (PFN_vkGetMemoryHostPointerPropertiesEXT)
+        vkGetDeviceProcAddr(g->device, "vkGetMemoryHostPointerPropertiesEXT");
+    VkMemoryHostPointerPropertiesEXT hp = {
+        .sType = VK_STRUCTURE_TYPE_MEMORY_HOST_POINTER_PROPERTIES_EXT,
+    };
+    VkExternalMemoryBufferCreateInfo ext = {
+        .sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_BUFFER_CREATE_INFO,
+        .handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT,
+    };
+    VkBufferCreateInfo bci = {
+        .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO, .pNext = &ext, .size = len,
+        .usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+    };
+    VkImportMemoryHostPointerInfoEXT imp = {
+        .sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_HOST_POINTER_INFO_EXT,
+        .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT,
+        .pHostPointer = host,
+    };
+    VkMemoryAllocateInfo mai = { .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO, .pNext = &imp,
+                                 .allocationSize = len };
+    VkMemoryRequirements req;
+    uint32_t bits;
+
+    if (!get_props || e->zc_nram == ZC_MAX_CHUNKS ||
+        get_props(g->device, VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT, host,
+                  &hp) != VK_SUCCESS ||
+        vkCreateBuffer(g->device, &bci, NULL, &e->zc_ram[e->zc_nram].buf) != VK_SUCCESS) {
+        return false;
+    }
+    vkGetBufferMemoryRequirements(g->device, e->zc_ram[e->zc_nram].buf, &req);
+    bits = req.memoryTypeBits & hp.memoryTypeBits;
+    mai.memoryTypeIndex = bits ? (uint32_t)__builtin_ctz(bits) : 0;
+    if (!bits ||
+        vkAllocateMemory(g->device, &mai, NULL, &e->zc_ram[e->zc_nram].mem) != VK_SUCCESS) {
+        vkDestroyBuffer(g->device, e->zc_ram[e->zc_nram].buf, NULL);
+        return false;
+    }
+    if (vkBindBufferMemory(g->device, e->zc_ram[e->zc_nram].buf, e->zc_ram[e->zc_nram].mem,
+                           0) != VK_SUCCESS) {
+        vkFreeMemory(g->device, e->zc_ram[e->zc_nram].mem, NULL);
+        vkDestroyBuffer(g->device, e->zc_ram[e->zc_nram].buf, NULL);
+        return false;
+    }
+    e->zc_ram[e->zc_nram].ram = ram;
+    e->zc_ram[e->zc_nram].len = len;
+    e->zc_nram++;
+    return true;
+}
+
+static void zc_fini(PVGExec *e)
+{
+    VkDevice d = e->gpu->device;
+
+    for (uint32_t i = 0; i < e->zc_nram; i++) {
+        vkDestroyBuffer(d, e->zc_ram[i].buf, NULL);
+        vkFreeMemory(d, e->zc_ram[i].mem, NULL);
+    }
+    e->zc_nram = 0;
+    if (e->stage) {
+        vkDestroyBuffer(d, e->stage, NULL);
+        e->stage = VK_NULL_HANDLE;
+    }
+    if (e->stage_mem) {
+        vkFreeMemory(d, e->stage_mem, NULL);
+        e->stage_mem = VK_NULL_HANDLE;
+    }
+    e->zc = false;
+    if (e->zc_cache) {
+        g_hash_table_destroy(e->zc_cache);
+        e->zc_cache = NULL;
+    }
+    e->gbuf = e->arena;
+    e->gaddr = e->arena_addr;
+}
+
+/* a device-local twin of the arena (same offsets, same uses) */
+static bool zc_stage_init(PVGExec *e)
+{
+    PVGGpu *g = e->gpu;
+    VkBufferCreateInfo bci = {
+        .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO, .size = ARENA_SIZE,
+        .usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT |
+                 VK_BUFFER_USAGE_VERTEX_BUFFER_BIT | VK_BUFFER_USAGE_INDEX_BUFFER_BIT |
+                 VK_BUFFER_USAGE_STORAGE_BUFFER_BIT |
+                 VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT,
+    };
+    VkMemoryAllocateFlagsInfo flags = {
+        .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_FLAGS_INFO,
+        .flags = VK_MEMORY_ALLOCATE_DEVICE_ADDRESS_BIT,
+    };
+    VkMemoryAllocateInfo mai = { .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO, .pNext = &flags };
+    VkBufferDeviceAddressInfo bdai = { .sType = VK_STRUCTURE_TYPE_BUFFER_DEVICE_ADDRESS_INFO };
+    VkMemoryRequirements req;
+    int mt;
+
+    if (vkCreateBuffer(g->device, &bci, NULL, &e->stage) != VK_SUCCESS) {
+        return false;
+    }
+    vkGetBufferMemoryRequirements(g->device, e->stage, &req);
+    mt = pvg_gpu_memory_type(g, req.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+    if (mt < 0) {
+        return false;
+    }
+    mai.allocationSize = req.size;
+    mai.memoryTypeIndex = mt;
+    if (vkAllocateMemory(g->device, &mai, NULL, &e->stage_mem) != VK_SUCCESS ||
+        vkBindBufferMemory(g->device, e->stage, e->stage_mem, 0) != VK_SUCCESS) {
+        return false;
+    }
+    bdai.buffer = e->stage;
+    e->gbuf = e->stage;
+    e->gaddr = vkGetBufferDeviceAddress(g->device, &bdai);
+    return true;
+}
+
+bool pvg_exec_set_zero_copy(PVGExec *e, bool on)
+{
+    uint64_t blocks[8][3];
+    uint32_t n;
+
+    vkQueueWaitIdle(e->gpu->queue);
+    zc_fini(e);
+    if (!on || e->dump_dir || !e->gpu->host_import || !e->host.ram_blocks ||
+        !e->host.ram_runs) {
+        return false;   /* dumps and captures read GPU results through the arena */
+    }
+    n = e->host.ram_blocks(e->host.opaque, blocks, G_N_ELEMENTS(blocks));
+    for (uint32_t i = 0; i < n; i++) {
+        for (uint64_t o = 0; o < blocks[i][2]; o += ZC_CHUNK) {
+            if (!zc_import(e, blocks[i][0] + o, (uint8_t *)(uintptr_t)blocks[i][1] + o,
+                           MIN(ZC_CHUNK, blocks[i][2] - o))) {
+                elog(e, "zero-copy: importing guest RAM at 0x%" G_GINT64_MODIFIER "x failed",
+                     blocks[i][0] + o);
+                zc_fini(e);
+                return false;
+            }
+        }
+    }
+    if (!e->zc_nram || !zc_stage_init(e)) {
+        zc_fini(e);
+        return false;
+    }
+    e->zc = true;
+    e->zc_cache = g_hash_table_new_full(zc_key_hash, zc_key_equal, g_free, g_free);
+    elog(e, "zero-copy: guest RAM imported in %u pieces", e->zc_nram);
+    return true;
+}
+
+static void zc_full_barrier(VkCommandBuffer c);
+
+/* begin the gather (pre) or scatter (post) command buffer of the next submission */
+static VkCommandBuffer zc_cmd(PVGExec *e, bool post)
+{
+    VkCommandBufferBeginInfo bi = { .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+                                    .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT };
+    VkCommandBuffer c = post ? e->zc_post : e->zc_pre;
+    bool *open = post ? &e->zc_post_open : &e->zc_pre_open;
+
+    if (!*open) {
+        vkBeginCommandBuffer(c, &bi);
+        *open = true;
+        if (post) {
+            zc_full_barrier(c);     /* after the main command buffer's writes */
+        }
+    }
+    return c;
+}
+
+/* everything before in submission order -> everything after */
+static void zc_full_barrier(VkCommandBuffer c)
+{
+    VkMemoryBarrier mb = {
+        .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+        .srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT,
+        .dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT,
+    };
+
+    vkCmdPipelineBarrier(c, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                         VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 1, &mb, 0, NULL, 0, NULL);
+}
+
+static int zc_piece(PVGExec *e, uint64_t ram)
+{
+    for (uint32_t k = 0; k < e->zc_nram; k++) {
+        if (ram >= e->zc_ram[k].ram && ram < e->zc_ram[k].ram + e->zc_ram[k].len) {
+            return (int)k;
+        }
+    }
+    return -1;
+}
+
+static void zc_flush_regions(PVGExec *e, VkCommandBuffer c, int piece, uint32_t nr,
+                             bool to_guest)
+{
+    if (!nr) {
+        return;
+    }
+    if (to_guest) {
+        vkCmdCopyBuffer(c, e->stage, e->zc_ram[piece].buf, nr, e->zc_regs);
+    } else {
+        vkCmdCopyBuffer(c, e->zc_ram[piece].buf, e->stage, nr, e->zc_regs);
+    }
+}
+
+/*
+ * Record copies between task va..va+len and arena offset off: guest RAM -> twin (pre) or
+ * twin -> guest RAM (post), one region per contiguous run of guest pages. The pages are
+ * looked up for the enclosing range cva..cva+clen (an image, a buffer), so its rows share
+ * one cached lookup. false: some page is not in imported RAM (then nothing is recorded).
+ */
+static bool zc_copy(PVGExec *e, uint32_t task, uint64_t cva, uint64_t clen, uint64_t va,
+                    uint64_t len, uint64_t off, bool to_guest)
+{
+    uint32_t lo, hi, nr = 0;
+    int last = -1;
+    VkCommandBuffer c;
+    const ZCRuns *rr;
+    uint64_t rel;
+
+    if (!len) {
+        return true;
+    }
+    if (va < cva || va + len > cva + clen) {
+        cva = va;
+        clen = len;
+    }
+    rr = zc_runs(e, task, cva, clen);
+    if (!rr) {
+        return false;
+    }
+    /* first run containing va: binary search on the runs' offsets */
