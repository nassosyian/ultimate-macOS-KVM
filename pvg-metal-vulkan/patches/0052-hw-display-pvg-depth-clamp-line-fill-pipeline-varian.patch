             c->res->sampler_mask |= 1u << a->index;
             break;
         }
@@ -939,7 +944,7 @@ static int setup_interface(Ctx *c)
             r->type = spv_type(&c->m, SpvOpTypeSampler, NULL, 0);
             r->var = global_var(c, SpvStorageUniformConstant, r->type);
             decorate1(c, r->var, SpvDecorationDescriptorSet, 0);
-            decorate1(c, r->var, SpvDecorationBinding, A2S_CONST_SAMPLER_BINDING + nconst);
+            decorate1(c, r->var, SpvDecorationBinding, A2S_CONST_SAMPLER_BINDING + nconst + stage_binding_offset(c));
             init = LLVMGetInitializer(g);
             c->res->const_sampler_state[nconst] =
                 init && LLVMIsAConstantInt(init) ? LLVMConstIntGetZExtValue(init) :
@@ -1662,6 +1667,285 @@ static int texture_call(Ctx *c, LLVMValueRef call, const char *name, uint32_t re
     return 0;
 }
 
+static int priv_find(Ctx *c, LLVMValueRef v);
+static uint32_t priv_word_ptr(Ctx *c, int pi, uint32_t k);
+
+/* air.atomic.fence(...): memory is coherent within our execution model; no barrier needed */
+static bool fence_like(const char *rest)
+{
+    return !strncmp(rest, "fence", 5);
+}
+
+/* this invocation's lane in the subgroup (for quad lane arithmetic) */
+static uint32_t kernel_lane_id(Ctx *c)
+{
+    uint32_t v = builtin_var(c, SpvStorageInput, c->t_u32, SpvBuiltInSubgroupLocalInvocationId);
+
+    spv_capability(&c->m, SpvCapabilityGroupNonUniform);
+    if (c->stage == A2S_STAGE_FRAGMENT) {
+        decorate1(c, v, SpvDecorationFlat, 0);
+    }
+    return emit(c, SpvOpLoad, c->t_u32, 0, &v, 1);
+}
+
+/*
+ * air.atomic.{global,local}.<op>[.s|.u].<type>: device memory through a physical storage
+ * buffer pointer (Device scope), threadgroup/private word arrays (Workgroup scope).
+ * Operands: (ptr, [value | expected ptr, desired], memory order, scope, volatile); all orders
+ * are relaxed in MSL except fences, so semantics are Relaxed.
+ */
+static int atomic_call(Ctx *c, LLVMValueRef call, const char *rest, uint32_t result)
+{
+    static const struct { const char *name; uint16_t s, u; } ops[] = {
+        { "add", SpvOpAtomicIAdd, SpvOpAtomicIAdd }, { "sub", SpvOpAtomicISub, SpvOpAtomicISub },
+        { "min", SpvOpAtomicSMin, SpvOpAtomicUMin }, { "max", SpvOpAtomicSMax, SpvOpAtomicUMax },
+        { "and", SpvOpAtomicAnd, SpvOpAtomicAnd }, { "or", SpvOpAtomicOr, SpvOpAtomicOr },
+        { "xor", SpvOpAtomicXor, SpvOpAtomicXor }, { "xchg", SpvOpAtomicExchange, SpvOpAtomicExchange },
+        { "load", SpvOpAtomicLoad, SpvOpAtomicLoad }, { "store", SpvOpAtomicStore, SpvOpAtomicStore },
+        { "cmpxchg", SpvOpAtomicCompareExchange, SpvOpAtomicCompareExchange },
+    };
+    LLVMValueRef p = LLVMGetOperand(call, 0);
+    const char *dot = strchr(rest, '.');
+    bool local = !strncmp(rest, "local.", 6);
+    char op[16];
+    int k = -1, pi;
+    LLVMTypeRef vt;
+    uint32_t vty, ptr, scope, sem = spv_const_u32(&c->m, 0), w[8];
+
+    if (fence_like(rest)) {
+        return 0;
+    }
+    if (!dot || (strncmp(rest, "global.", 7) && !local)) {
+        return fail(c, "unsupported atomic %s", rest);
+    }
+    snprintf(op, sizeof(op), "%.*s", (int)strcspn(dot + 1, "."), dot + 1);
+    for (size_t i = 0; i < sizeof(ops) / sizeof(ops[0]); i++) {
+        if (!strcmp(op, ops[i].name)) {
+            k = (int)i;
+        }
+    }
+    if (k < 0) {
+        return fail(c, "unsupported atomic operation %s", rest);
+    }
+    vt = !strcmp(op, "store") ? LLVMTypeOf(LLVMGetOperand(call, 1)) :
+         !strcmp(op, "cmpxchg") ? LLVMTypeOf(LLVMGetOperand(call, 2)) : LLVMTypeOf(call);
+    if (LLVMGetTypeKind(vt) == LLVMFloatTypeKind && strcmp(op, "xchg") && strcmp(op, "load") &&
+        strcmp(op, "store")) {
+        return fail(c, "unsupported float atomic %s", rest);
+    }
+    vty = ty(c, vt);
+    if (LLVMGetTypeKind(vt) == LLVMIntegerTypeKind && LLVMGetIntTypeWidth(vt) == 64) {
+        spv_capability(&c->m, SpvCapabilityInt64Atomics);
+    }
+    pi = priv_find(c, p);
+    if (pi >= 0) {
+        if (LLVMGetTypeKind(vt) == LLVMIntegerTypeKind && LLVMGetIntTypeWidth(vt) != 32) {
+            return fail(c, "64-bit threadgroup atomic");
+        }
+        ptr = priv_word_ptr(c, pi, 0);
+        if (vty != c->t_u32) {
+            /* word arrays hold u32: float exchange/load/store go through a u32 view */
+            return fail(c, "non-u32 threadgroup atomic");
+        }
+        scope = spv_const_u32(&c->m, SpvScopeWorkgroup);
+    } else {
+        ptr = psb_ptr(c, val(c, p), vty);
+        scope = spv_const_u32(&c->m, SpvScopeDevice);
+    }
+    if (!strcmp(op, "store")) {
+        w[0] = ptr; w[1] = scope; w[2] = sem; w[3] = val(c, LLVMGetOperand(call, 1));
+        spv_emit(&c->m, SPV_SEC_FUNCS, SpvOpAtomicStore, w, 4);
+        return 0;
+    }
+    if (!strcmp(op, "load")) {
+        w[0] = ptr; w[1] = scope; w[2] = sem;
+        emit(c, SpvOpAtomicLoad, vty, result, w, 3);
+        return 0;
+    }
+    if (!strcmp(op, "cmpxchg")) {
+        /* (obj, expected*, desired, ...) -> bool; the old value goes back to *expected */
+        LLVMValueRef ep = LLVMGetOperand(call, 1);
+        int epi = priv_find(c, ep);
+        uint32_t eptr, expected, old, eq[2];
+
+        if (epi < 0 || vty != c->t_u32) {
+            return fail(c, "unsupported compare-exchange form");
+        }
+        eptr = priv_word_ptr(c, epi, 0);
+        expected = emit(c, SpvOpLoad, c->t_u32, 0, &eptr, 1);
+        w[0] = ptr; w[1] = scope; w[2] = sem; w[3] = sem;
+        w[4] = val(c, LLVMGetOperand(call, 2)); w[5] = expected;
+        old = emit(c, SpvOpAtomicCompareExchange, vty, 0, w, 6);
+        eq[0] = eptr;
+        eq[1] = old;
+        spv_emit(&c->m, SPV_SEC_FUNCS, SpvOpStore, eq, 2);
+        eq[0] = old;
+        eq[1] = expected;
+        if (is_bool(LLVMTypeOf(call))) {
+            emit(c, SpvOpIEqual, c->t_bool, result, eq, 2);
+        } else {
+            uint32_t b = emit(c, SpvOpIEqual, c->t_bool, 0, eq, 2);
+            uint32_t sel[3] = { b, spv_const_u32(&c->m, 1), spv_const_u32(&c->m, 0) };
+
+            emit(c, SpvOpSelect, ty(c, LLVMTypeOf(call)), result, sel, 3);
+        }
+        return 0;
+    }
+    w[0] = ptr; w[1] = scope; w[2] = sem; w[3] = val(c, LLVMGetOperand(call, 1));
+    emit(c, strstr(dot, ".s.") ? ops[k].s : ops[k].u, vty, result, w, 4);
+    return 0;
+}
+
+/*
+ * air.simd_* / air.quad_*: subgroup operations (threadExecutionWidth 32 = the host subgroup).
+ * Quad reductions are clustered reductions of 4 lanes.
+ */
+static int simd_call(Ctx *c, LLVMValueRef call, const char *base, const char *rest,
+                     uint32_t result)
+{
+    static const struct { const char *name; uint16_t i, u, f; int gop; } red[] = {
+        { "sum", SpvOpGroupNonUniformIAdd, SpvOpGroupNonUniformIAdd, SpvOpGroupNonUniformFAdd, 0 },
+        { "product", SpvOpGroupNonUniformIMul, SpvOpGroupNonUniformIMul,
+          SpvOpGroupNonUniformFMul, 0 },
+        { "min", SpvOpGroupNonUniformSMin, SpvOpGroupNonUniformUMin, SpvOpGroupNonUniformFMin, 0 },
+        { "max", SpvOpGroupNonUniformSMax, SpvOpGroupNonUniformUMax, SpvOpGroupNonUniformFMax, 0 },
+        { "and", SpvOpGroupNonUniformBitwiseAnd, SpvOpGroupNonUniformBitwiseAnd, 0, 0 },
+        { "or", SpvOpGroupNonUniformBitwiseOr, SpvOpGroupNonUniformBitwiseOr, 0, 0 },
+        { "xor", SpvOpGroupNonUniformBitwiseXor, SpvOpGroupNonUniformBitwiseXor, 0, 0 },
+        { "prefix_inclusive_sum", SpvOpGroupNonUniformIAdd, SpvOpGroupNonUniformIAdd,
+          SpvOpGroupNonUniformFAdd, SpvGroupOperationInclusiveScan },
+        { "prefix_exclusive_sum", SpvOpGroupNonUniformIAdd, SpvOpGroupNonUniformIAdd,
+          SpvOpGroupNonUniformFAdd, SpvGroupOperationExclusiveScan },
+        { "prefix_inclusive_product", SpvOpGroupNonUniformIMul, SpvOpGroupNonUniformIMul,
+          SpvOpGroupNonUniformFMul, SpvGroupOperationInclusiveScan },
+        { "prefix_exclusive_product", SpvOpGroupNonUniformIMul, SpvOpGroupNonUniformIMul,
+          SpvOpGroupNonUniformFMul, SpvGroupOperationExclusiveScan },
+    };
+    bool quad = base[0] == 'q';
+    const char *name = base + 5;        /* after "simd_" / "quad_" */
+    LLVMTypeRef rt = LLVMTypeOf(call);
+    uint32_t rty = ty(c, rt), sg = spv_const_u32(&c->m, SpvScopeSubgroup), w[6];
+    unsigned nargs = LLVMGetNumArgOperands(call);
+
+    spv_capability(&c->m, SpvCapabilityGroupNonUniform);
+    for (size_t i = 0; i < sizeof(red) / sizeof(red[0]); i++) {
+        if (!strcmp(name, red[i].name)) {
+            LLVMTypeRef et = LLVMGetTypeKind(rt) == LLVMVectorTypeKind ? LLVMGetElementType(rt) : rt;
+            bool fl = LLVMGetTypeKind(et) == LLVMFloatTypeKind || LLVMGetTypeKind(et) == LLVMHalfTypeKind;
+            uint16_t opc = fl ? red[i].f : rest && !strncmp(rest, "u.", 2) ? red[i].u : red[i].i;
+
+            if (!opc) {
+                return fail(c, "unsupported %s on floats", base);
+            }
+            spv_capability(&c->m, SpvCapabilityGroupNonUniformArithmetic);
+            w[0] = sg;
+            w[1] = quad ? SpvGroupOperationClusteredReduce : (uint32_t)red[i].gop;
+            w[2] = val(c, LLVMGetOperand(call, 0));
+            if (quad) {
+                if (red[i].gop) {
+                    return fail(c, "unsupported %s", base);
+                }
+                spv_capability(&c->m, SpvCapabilityGroupNonUniformClustered);
+                w[3] = spv_const_u32(&c->m, 4);
+            }
+            emit(c, opc, rty, result, w, quad ? 4 : 3);
+            return 0;
+        }
+    }
+    if (!strcmp(name, "all") || !strcmp(name, "any")) {
+        spv_capability(&c->m, SpvCapabilityGroupNonUniformVote);
+        w[0] = sg;
+        w[1] = val(c, LLVMGetOperand(call, 0));
+        if (quad) {
+            return fail(c, "unsupported %s", base);
+        }
+        emit(c, name[1] == 'l' ? SpvOpGroupNonUniformAll : SpvOpGroupNonUniformAny, rty, result,
+             w, 2);
+        return 0;
+    }
+    if (!strcmp(name, "is_first") && !quad) {
+        w[0] = sg;
+        emit(c, SpvOpGroupNonUniformElect, rty, result, w, 1);
+        return 0;
+    }
+    if (!strcmp(name, "broadcast_first") && !quad) {
+        spv_capability(&c->m, SpvCapabilityGroupNonUniformBallot);
+        w[0] = sg;
+        w[1] = val(c, LLVMGetOperand(call, 0));
+        emit(c, SpvOpGroupNonUniformBroadcastFirst, rty, result, w, 2);
+        return 0;
+    }
+    if ((!strcmp(name, "ballot") || !strcmp(name, "active_threads_mask")) && !quad) {
+        /* uvec4 ballot -> the 64-bit (or narrower) mask Metal returns */
+        uint32_t uv4 = spv_type_vec(&c->m, c->t_u32, 4), b, lo, hi, t[2];
+
+        spv_capability(&c->m, SpvCapabilityGroupNonUniformBallot);
+        w[0] = sg;
+        w[1] = name[0] == 'b' && nargs ? val(c, LLVMGetOperand(call, 0)) : spv_const(&c->m, SpvOpConstantTrue, c->t_bool, NULL, 0);
+        b = emit(c, SpvOpGroupNonUniformBallot, uv4, 0, w, 2);
+        t[0] = b;
+        t[1] = 0;
+        lo = emit(c, SpvOpCompositeExtract, c->t_u32, 0, t, 2);
+        if (rty == c->t_u32) {
+            emit(c, SpvOpCopyObject, rty, result, &lo, 1);
+            return 0;
+        }
+        t[1] = 1;
+        hi = emit(c, SpvOpCompositeExtract, c->t_u32, 0, t, 2);
+        lo = emit(c, SpvOpUConvert, c->t_u64, 0, &lo, 1);
+        hi = emit(c, SpvOpUConvert, c->t_u64, 0, &hi, 1);
+        t[0] = hi;
+        t[1] = spv_const_u32(&c->m, 32);
+        hi = emit(c, SpvOpShiftLeftLogical, c->t_u64, 0, t, 2);
+        t[0] = hi;
+        t[1] = lo;
+        emit(c, SpvOpBitwiseOr, rty, result, t, 2);
+        return 0;
+    }
+    if (!strncmp(name, "shuffle", 7) || !strcmp(name, "broadcast")) {
+        uint32_t v = val(c, LLVMGetOperand(call, 0)), arg;
+        uint16_t opc;
+
+        if (nargs < 2) {
+            return fail(c, "%s without lane operand", base);
+        }
+        arg = val(c, LLVMGetOperand(call, 1));
+        if (LLVMGetIntTypeWidth(LLVMTypeOf(LLVMGetOperand(call, 1))) != 32) {
+            arg = emit(c, SpvOpUConvert, c->t_u32, 0, &arg, 1);
+        }
+        if (quad && (!strcmp(name, "broadcast") || !strcmp(name, "shuffle"))) {
+            /* quad lane -> subgroup lane: (lane & ~3) | quad_lane */
+            uint32_t id = kernel_lane_id(c), t[2];
+
+            t[0] = id;
+            t[1] = spv_const_u32(&c->m, ~3u);
+            id = emit(c, SpvOpBitwiseAnd, c->t_u32, 0, t, 2);
+            t[0] = id;
+            t[1] = arg;
+            arg = emit(c, SpvOpBitwiseOr, c->t_u32, 0, t, 2);
+        } else if (quad && strcmp(name, "shuffle_xor")) {
+            return fail(c, "unsupported %s", base);
+        }
+        opc = !strcmp(name, "shuffle_xor") ? SpvOpGroupNonUniformShuffleXor :
+              !strcmp(name, "shuffle_up") ? SpvOpGroupNonUniformShuffleUp :
+              !strcmp(name, "shuffle_down") ? SpvOpGroupNonUniformShuffleDown :
+              !strcmp(name, "shuffle") || !strcmp(name, "broadcast") ?
+              SpvOpGroupNonUniformShuffle : 0;
+        if (!opc) {
+            return fail(c, "unsupported %s", base);
+        }
+        spv_capability(&c->m, opc >= SpvOpGroupNonUniformShuffleUp ?
+                       SpvCapabilityGroupNonUniformShuffleRelative :
+                       SpvCapabilityGroupNonUniformShuffle);
+        w[0] = sg;
+        w[1] = v;
+        w[2] = arg;
+        emit(c, opc, rty, result, w, 3);
+        return 0;
+    }
+    return fail(c, "unsupported %s", base);
+}
+
 static int call_inst(Ctx *c, LLVMValueRef call, uint32_t result)
 {
     LLVMValueRef callee = LLVMGetCalledValue(call);
@@ -1749,6 +2033,12 @@ static int call_inst(Ctx *c, LLVMValueRef call, uint32_t result)
             }
         }
     }
+    if (!strcmp(base, "atomic") && dot) {
+        return atomic_call(c, call, dot + 1, result);
+    }
+    if (!strncmp(base, "simd_", 5) || !strncmp(base, "quad_", 5)) {
+        return simd_call(c, call, base, dot ? dot + 1 : NULL, result);
+    }
     if (!strcmp(base, "wg") && dot && !strncmp(dot + 1, "barrier", 7)) {
         /* air.wg.barrier(i32 mem_flags: 1 device, 2 threadgroup, 4 texture; i32 scope) */
         LLVMValueRef fl = nargs > 0 ? LLVMGetOperand(call, 0) : NULL;
@@ -2425,7 +2715,8 @@ static int instruction(Ctx *c, Cfg *g, int bi, LLVMValueRef inst)
         LLVMValueRef o = LLVMGetOperand(inst, i);
 
         if (priv_find(c, o) >= 0 && !(op == LLVMCall && LLVMGetCalledValue(inst) &&
-            !strncmp(vname(LLVMGetCalledValue(inst), NULL), "llvm.lifetime.", 14))) {
+            (!strncmp(vname(LLVMGetCalledValue(inst), NULL), "llvm.lifetime.", 14) ||
+             !strncmp(vname(LLVMGetCalledValue(inst), NULL), "air.atomic.", 11)))) {
             return fail(c, "unsupported use of private memory (opcode %d)", op);
         }
     }
