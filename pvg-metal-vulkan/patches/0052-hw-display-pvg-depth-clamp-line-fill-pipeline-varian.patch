--- a/hw/display/pvg/air2spv.c
+++ b/hw/display/pvg/air2spv.c
@@ -550,6 +550,11 @@ static void decorate1(Ctx *c, uint32_t id, uint32_t dec, uint32_t v)
 }
 
 /* one variable per input builtin: an entry point may not list the same builtin twice */
+static uint32_t stage_binding_offset(const Ctx *c)
+{
+    return c->stage == A2S_STAGE_VERTEX ? A2S_VERTEX_BINDING_OFFSET : 0;
+}
+
 static uint32_t builtin_var(Ctx *c, uint32_t sc, uint32_t type, uint32_t builtin)
 {
     bool memo = sc == SpvStorageInput && builtin < sizeof(c->builtin_in) / sizeof(c->builtin_in[0]);
@@ -841,7 +846,7 @@ static int setup_interface(Ctx *c)
             }
             r->var = global_var(c, SpvStorageUniformConstant, r->type);
             decorate1(c, r->var, SpvDecorationDescriptorSet, 0);
-            decorate1(c, r->var, SpvDecorationBinding, A2S_TEXTURE_BINDING + a->index);
+            decorate1(c, r->var, SpvDecorationBinding, A2S_TEXTURE_BINDING + a->index + stage_binding_offset(c));
             c->res->texture_mask |= 1u << a->index;
             if (a->index < 32) {
                 c->res->texture_view[a->index] =
@@ -861,7 +866,7 @@ static int setup_interface(Ctx *c)
             r->type = spv_type(&c->m, SpvOpTypeSampler, NULL, 0);
             r->var = global_var(c, SpvStorageUniformConstant, r->type);
