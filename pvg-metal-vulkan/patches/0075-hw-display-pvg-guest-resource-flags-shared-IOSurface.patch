+static void pvg_scan_release(PVGLinuxPCIState *s)
+{
+    for (int i = 0; i < PVG_SCANOUT_BUFS; i++) {
+        if (s->scan_buf[i]) {
+            qemu_console_gl_release_dmabuf(s->con, s->scan_buf[i]);
+            qemu_dmabuf_close(s->scan_buf[i]);
+            g_clear_pointer(&s->scan_buf[i], qemu_dmabuf_free);
+        }
