+    if (e->disabled || e->dry_run) {
+        return -1;
+    }
+    if ((e->scan_info.width != width || e->scan_info.height != height) &&
+        !scanout_init(e, width, height)) {
+        return -1;
+    }
+    for (guint i = 0; e->priv_imgs && i < e->priv_imgs->len; i++) {
+        HostImage *c = g_ptr_array_index(e->priv_imgs, i);
+
+        if (c->guest_stale && c->resident && c->pgi.task == task && c->pgi.va == va &&
+            c->pgi.width == width && c->pgi.height == height && c->pgi.mips == 1 &&
+            (c->format == VK_FORMAT_B8G8R8A8_UNORM || c->format == VK_FORMAT_B8G8R8A8_SRGB) &&
+            c->layout != VK_IMAGE_LAYOUT_UNDEFINED) {
+            hi = c;
+            break;
+        }
+    }
+    idx = e->scan_next;
+    e->scan_next = (e->scan_next + 1) % PVG_SCANOUT_BUFS;
+    vkResetCommandBuffer(e->cmd, 0);
+    vkBeginCommandBuffer(e->cmd, &bi);
+    barrier(e, e->scan[idx].image, VK_IMAGE_LAYOUT_UNDEFINED,
+            VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+    if (hi) {
+        VkImageCopy c = {
+            .srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+            .dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+            .extent = { width, height, 1 },
+        };
+
+        barrier(e, hi->image, hi->layout, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+        hi->layout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+        vkCmdCopyImage(e->cmd, hi->image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                       e->scan[idx].image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &c);
+    } else {
+        VkBufferImageCopy r = {
+            .bufferRowLength = row_bytes / 4,
+            .imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+            .imageExtent = { width, height, 1 },
+        };
+        uint64_t size = (uint64_t)row_bytes * (height - 1) + width * 4;
+
+        off = arena_alloc(e, size);
+        if (off == UINT64_MAX || !guest_to_arena(e, task, va, off, size)) {
+            vkEndCommandBuffer(e->cmd);
+            e->arena_used = mark;
+            return -1;
+        }
+        r.bufferOffset = off;
+        vkCmdCopyBufferToImage(e->cmd, e->gbuf, e->scan[idx].image,
+                               VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &r);
+    }
+    /* hand the image to the display's GL context (another queue family: foreign) */
+    {
+        VkImageMemoryBarrier b = {
+            .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+            .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+            .oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+            .newLayout = VK_IMAGE_LAYOUT_GENERAL,
+            .srcQueueFamilyIndex = e->gpu->queue_family,
+            .dstQueueFamilyIndex = VK_QUEUE_FAMILY_FOREIGN_EXT,
+            .image = e->scan[idx].image,
+            .subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 },
+        };
+
+        vkCmdPipelineBarrier(e->cmd, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                             VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, 0, 0, NULL, 0, NULL, 1, &b);
+    }
+    vkEndCommandBuffer(e->cmd);
+    if (!submit_wait(e, &si)) {
+        e->arena_used = mark;
+        return -1;
+    }
+    e->arena_used = mark;
+    e->stats.surface_reads += hi != NULL;
+    *info = e->scan_info;
+    return (int)idx;
+}
