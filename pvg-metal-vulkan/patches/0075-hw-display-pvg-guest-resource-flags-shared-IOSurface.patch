+static void pvg_exec_job_run(PVGLinuxPCIState *s, PVGExecJob *job)
+{
+    if (job->cmd) {
+        gsize n;
+        const uint8_t *p = g_bytes_get_data(job->cmd, &n);
+
+        pvg_dispatch_now(s, &job->cmd_hdr, p, n, true);
+    }
+    if (job->gamma[0]) {
+        pvg_display_set_gamma(s, job->gamma[0], job->gamma[1], (uint32_t)job->gamma[2]);
+    }
+    if (job->present) {
+        pvg_present_run(s, job->present);
+    }
+    if (job->res) {
+        gsize n;
+        const uint8_t *r = g_bytes_get_data(job->res, &n);
+
+        pvg_exec_resources(s->exec, job->task, r, n / 24);
+    }
+    for (guint i = 0; job->bufs && i < job->bufs->len; i++) {
+        gsize n;
+        const uint8_t *b = g_bytes_get_data(g_ptr_array_index(job->bufs, i), &n);
+
+        pvg_exec_run_buf(s, job->task, b, n);
+    }
+}
