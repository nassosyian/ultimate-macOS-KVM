+            return false;
+        }
+        *rtask = task;
+        *va = (uint64_t)ldl(obj + 8) << 12;
+        *len = ldq(obj);
+        return *len != 0;
+    case OBJ_BACKING_REF_TEX:
+        return olen >= 4 && object_range(e, 0, ldl(obj), rtask, va, len);
+    case OBJ_TEXTURE_2: case OBJ_TEXTURE_3: case OBJ_DERIVED_TEX:
+        if (!guest_image(e, task, id, &gi)) {
+            return false;
+        }
+        *rtask = gi.task;
+        *va = gi.va;
+        *len = guest_image_size(&gi);
+        return true;
+    }
+    return false;
