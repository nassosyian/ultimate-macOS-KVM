+static void scanout_free(PVGExec *e)
+{
+    VkDevice d = e->gpu->device;
+
+    for (uint32_t i = 0; i < PVG_SCANOUT_BUFS; i++) {
+        if (e->scan[i].fd >= 0 && e->scan[i].image) {
+            close(e->scan[i].fd);
+        }
+        if (e->scan[i].image) {
+            vkDestroyImage(d, e->scan[i].image, NULL);
+            vkFreeMemory(d, e->scan[i].mem, NULL);
+        }
+        e->scan[i].image = VK_NULL_HANDLE;
+        e->scan[i].mem = VK_NULL_HANDLE;
+        e->scan[i].fd = -1;
+    }
+}
+
+/* exportable BGRA images of the frame size; the driver picks a modifier it can share */
+static bool scanout_init(PVGExec *e, uint32_t w, uint32_t h)
+{
+    PVGGpu *g = e->gpu;
+    PFN_vkGetMemoryFdKHR get_fd = (PFN_vkGetMemoryFdKHR)
+        vkGetDeviceProcAddr(g->device, "vkGetMemoryFdKHR");
+    PFN_vkGetImageDrmFormatModifierPropertiesEXT get_mod =
+        (PFN_vkGetImageDrmFormatModifierPropertiesEXT)
+        vkGetDeviceProcAddr(g->device, "vkGetImageDrmFormatModifierPropertiesEXT");
+    VkDrmFormatModifierPropertiesEXT mp[32];
+    VkDrmFormatModifierPropertiesListEXT ml = {
+        .sType = VK_STRUCTURE_TYPE_DRM_FORMAT_MODIFIER_PROPERTIES_LIST_EXT,
+        .drmFormatModifierCount = 32, .pDrmFormatModifierProperties = mp,
+    };
+    VkFormatProperties2 fp = { .sType = VK_STRUCTURE_TYPE_FORMAT_PROPERTIES_2, .pNext = &ml };
+    uint64_t mods[32];
+    uint32_t nmods = 0;
+
+    scanout_free(e);
+    if (!g->dmabuf || !get_fd || !get_mod) {
+        return false;
+    }
+    vkGetPhysicalDeviceFormatProperties2(g->phys, VK_FORMAT_B8G8R8A8_UNORM, &fp);
+    for (uint32_t i = 0; i < ml.drmFormatModifierCount && i < 32; i++) {
+        if (mp[i].drmFormatModifierPlaneCount == 1 &&
+            (mp[i].drmFormatModifierTilingFeatures & VK_FORMAT_FEATURE_TRANSFER_DST_BIT)) {
+            mods[nmods++] = mp[i].drmFormatModifier;
+        }
+    }
+    if (!nmods) {
+        return false;
+    }
+    for (uint32_t i = 0; i < PVG_SCANOUT_BUFS; i++) {
+        VkImageDrmFormatModifierListCreateInfoEXT mlci = {
+            .sType = VK_STRUCTURE_TYPE_IMAGE_DRM_FORMAT_MODIFIER_LIST_CREATE_INFO_EXT,
+            .drmFormatModifierCount = nmods, .pDrmFormatModifiers = mods,
+        };
+        VkExternalMemoryImageCreateInfo emi = {
+            .sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO, .pNext = &mlci,
+            .handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+        };
+        VkImageCreateInfo ici = {
+            .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO, .pNext = &emi,
+            .imageType = VK_IMAGE_TYPE_2D, .format = VK_FORMAT_B8G8R8A8_UNORM,
+            .extent = { w, h, 1 }, .mipLevels = 1, .arrayLayers = 1,
+            .samples = VK_SAMPLE_COUNT_1_BIT, .tiling = VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT,
+            .usage = VK_IMAGE_USAGE_TRANSFER_DST_BIT,
+            .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+        };
+        VkMemoryDedicatedAllocateInfo dai = {
+            .sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO,
+        };
+        VkExportMemoryAllocateInfo exp = {
+            .sType = VK_STRUCTURE_TYPE_EXPORT_MEMORY_ALLOCATE_INFO, .pNext = &dai,
+            .handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+        };
+        VkMemoryAllocateInfo mai = { .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+                                     .pNext = &exp };
+        VkImageDrmFormatModifierPropertiesEXT imp = {
+            .sType = VK_STRUCTURE_TYPE_IMAGE_DRM_FORMAT_MODIFIER_PROPERTIES_EXT,
+        };
+        VkImageSubresource sub = { VK_IMAGE_ASPECT_MEMORY_PLANE_0_BIT_EXT, 0, 0 };
+        VkMemoryGetFdInfoKHR gfi = { .sType = VK_STRUCTURE_TYPE_MEMORY_GET_FD_INFO_KHR,
+                                     .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT };
+        VkSubresourceLayout sl;
+        VkMemoryRequirements req;
+
+        if (vkCreateImage(g->device, &ici, NULL, &e->scan[i].image) != VK_SUCCESS) {
+            e->scan[i].image = VK_NULL_HANDLE;
+            goto fail;
+        }
+        vkGetImageMemoryRequirements(g->device, e->scan[i].image, &req);
+        dai.image = e->scan[i].image;
+        mai.allocationSize = req.size;
+        mai.memoryTypeIndex = pvg_gpu_memory_type(g, req.memoryTypeBits,
+                                                  VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+        if (vkAllocateMemory(g->device, &mai, NULL, &e->scan[i].mem) != VK_SUCCESS) {
+            vkDestroyImage(g->device, e->scan[i].image, NULL);
+            e->scan[i].image = VK_NULL_HANDLE;
+            goto fail;
+        }
+        vkBindImageMemory(g->device, e->scan[i].image, e->scan[i].mem, 0);
+        gfi.memory = e->scan[i].mem;
+        if (get_fd(g->device, &gfi, &e->scan[i].fd) != VK_SUCCESS ||
+            get_mod(g->device, e->scan[i].image, &imp) != VK_SUCCESS) {
+            e->scan[i].fd = -1;
+            goto fail;
+        }
+        vkGetImageSubresourceLayout(g->device, e->scan[i].image, &sub, &sl);
+        e->scan_info.fd[i] = e->scan[i].fd;
+        e->scan_info.stride = (uint32_t)sl.rowPitch;
+        e->scan_info.offset = (uint32_t)sl.offset;
+        e->scan_info.modifier = imp.drmFormatModifier;
+    }
+    e->scan_info.width = w;
+    e->scan_info.height = h;
+    e->scan_info.generation++;
+    elog(e, "dmabuf scanout %ux%u: modifier 0x%" G_GINT64_MODIFIER "x stride %u", w, h,
+         e->scan_info.modifier, e->scan_info.stride);
+    return true;
+fail:
+    elog(e, "dmabuf scanout %ux%u: export failed", w, h);
+    scanout_free(e);
+    e->scan_info.width = 0;
+    return false;
+}
