+static void pvg_irqfd_teardown(PVGLinuxPCIState *s)
+{
+    if (s->irqfd_ready) {
+        qatomic_set(&s->irqfd_ready, false);
+        accel_irqchip_remove_irqfd_notifier_gsi(&s->irq_notifier, s->irq_virq);
+        accel_irqchip_release_virq(s->irq_virq);
+        event_notifier_cleanup(&s->irq_notifier);
+    }
+}
+
+/* main loop: the irqfd for completion interrupts follows the guest's MSI setup */
+static void pvg_irqfd_update(PVGLinuxPCIState *s)
+{
+    PCIDevice *d = PCI_DEVICE(s);
+    MSIMessage msg;
+
+    if (!s->irqfd || !accel_msi_via_irqfd_enabled() || !msi_enabled(d)) {
+        pvg_irqfd_teardown(s);
+        return;
+    }
+    msg = msi_get_message(d, 0);
+    if (!s->irqfd_ready) {
+        AccelRouteChange c = accel_irqchip_begin_route_changes();
+        int virq = accel_irqchip_add_msi_route(&c, 0, d);
+
+        if (virq < 0) {
+            s->irqfd = false;
+            return;
+        }
+        accel_irqchip_commit_route_changes(&c);
+        if (event_notifier_init(&s->irq_notifier, 0) < 0) {
+            accel_irqchip_release_virq(virq);
+            s->irqfd = false;
+            return;
+        }
+        if (accel_irqchip_add_irqfd_notifier_gsi(&s->irq_notifier, NULL, virq) < 0) {
+            event_notifier_cleanup(&s->irq_notifier);
+            accel_irqchip_release_virq(virq);
+            s->irqfd = false;
+            return;
+        }
+        s->irq_virq = virq;
+        s->irq_msg = msg;
+        qatomic_set(&s->irqfd_ready, true);
+    } else if (msg.address != s->irq_msg.address || msg.data != s->irq_msg.data) {
+        accel_irqchip_update_msi_route(s->irq_virq, msg, d);
+        accel_irqchip_commit_routes();
+        s->irq_msg = msg;
     }
 }
 
