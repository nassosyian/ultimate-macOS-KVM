+/* main loop: a frame the worker copied into a scanout image; false: none (CPU frame) */
+static bool pvg_present_show_dmabuf(PVGLinuxPCIState *s)
+{
+    PVGScanout info;
+    int idx;
+
+    qemu_mutex_lock(&s->present_lock);
+    if (!s->scan_new) {
+        qemu_mutex_unlock(&s->present_lock);
+        if (s->scan_shown) {
+            /* back to frames in the console surface (a gamma table, a failed copy) */
+            qemu_console_gl_scanout_disable(s->con);
+            s->scan_shown = false;
+            s->present_full = true;
+        }
+        return false;
+    }
+    s->scan_new = false;
+    info = s->scan_info;
+    idx = s->scan_next;
+    qemu_mutex_unlock(&s->present_lock);
+    if (info.generation != s->scan_gen || !s->scan_buf[idx]) {
+        pvg_scan_release(s);
+        for (int i = 0; i < PVG_SCANOUT_BUFS; i++) {
+            int32_t fd = dup(info.fd[i]);
+
+            s->scan_buf[i] = qemu_dmabuf_new(info.width, info.height, &info.offset,
+                                             &info.stride, 0, 0, info.width, info.height,
+                                             DRM_FORMAT_XRGB8888, info.modifier, &fd, 1,
+                                             false, false);
+        }
+        s->scan_gen = info.generation;
+        qemu_console_resize(s->con, info.width, info.height);
+    }
+    qemu_console_gl_scanout_dmabuf(s->con, s->scan_buf[idx]);
+    qemu_console_gl_update(s->con, 0, 0, info.width, info.height);
+    s->scan_shown = true;
+    s->scanout_valid = true;
+    return true;
+}
