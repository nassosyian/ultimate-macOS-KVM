+/* ---- GPU-only contents of guest RAM pages (any mapping) ---- */
+
+static void priv_flush(PVGExec *e, HostImage *hi);
+
+static bool stale_test(PVGExec *e, uint64_t page)
+{
+    return page < e->stale_npages &&
+           (e->stale_bits[page / 64] >> (page % 64) & 1);
+}
+
+static void stale_pages_remove(PVGExec *e, HostImage *hi)
+{
+    if (!hi->stale_pages || !hi->stale_pages->len) {
+        return;
+    }
+    for (guint i = 0; i < hi->stale_pages->len; i++) {
+        uint64_t page = g_array_index(hi->stale_pages, uint32_t, i);
+
+        if (g_hash_table_lookup(e->stale_owner, GSIZE_TO_POINTER(page)) == hi) {
+            g_hash_table_remove(e->stale_owner, GSIZE_TO_POINTER(page));
+            e->stale_bits[page / 64] &= ~(1ull << (page % 64));
+            e->block_stale[page >> 9]--;
+        }
+    }
+    g_array_set_size(hi->stale_pages, 0);
+    e->stale_images--;
+}
+
+/* the images owning GPU-only contents of task va..va+len's pages (at most max, no duplicates) */
+static uint32_t stale_owners(PVGExec *e, uint32_t task, uint64_t va, uint64_t len,
+                             const HostImage *except, HostImage **out, uint32_t max)
+{
+    const ZCRuns *rr;
+    uint32_t n = 0;
+
+    if (!e->stale_images || !len || !(rr = zc_runs(e, task, va, len))) {
+        return 0;
+    }
+    for (uint32_t i = 0; i < rr->n; i++) {
+        for (uint64_t page = rr->runs[i][0] >> 12;
+             page <= (rr->runs[i][0] + rr->runs[i][1] - 1) >> 12; page++) {
+            HostImage *o;
+            uint32_t k;
+
+            if (!stale_test(e, page) ||
+                !(o = g_hash_table_lookup(e->stale_owner, GSIZE_TO_POINTER(page))) ||
+                o == except) {
+                continue;
+            }
+            for (k = 0; k < n && out[k] != o; k++) {
+            }
+            if (k == n && n < max) {
+                out[n++] = o;
+            }
+        }
+    }
+    return n;
+}
+
+/* the guest side is about to read task va..va+len: GPU-only contents there first */
+static void stale_flush_phys(PVGExec *e, uint32_t task, uint64_t va, uint64_t len,
+                             const HostImage *except)
+{
+    HostImage *own[16];
+    uint32_t n = stale_owners(e, task, va, len, except, own, 16);
+
+    for (uint32_t i = 0; i < n; i++) {
+        e->flush_why = "alias";
+        priv_flush(e, own[i]);
+    }
+}
+
+/* hi now holds the only copy of its memory's newest contents */
+static void stale_set(PVGExec *e, HostImage *hi)
+{
+    const ZCRuns *rr;
+    HostImage *prev[16];
+    uint32_t n;
+
+    if (hi->guest_stale) {
+        return;
+    }
+    hi->guest_stale = true;
+    if (!e->stale_bits ||
+        !(rr = zc_runs(e, hi->pgi.task, hi->pgi.va, guest_image_size(&hi->pgi)))) {
+        return;
+    }
+    /* another image's GPU-only contents of the same pages: in guest memory first */
+    n = stale_owners(e, hi->pgi.task, hi->pgi.va, guest_image_size(&hi->pgi), hi, prev, 16);
+    for (uint32_t i = 0; i < n; i++) {
+        e->flush_why = "alias-writer";
+        priv_flush(e, prev[i]);
+    }
+    rr = zc_runs(e, hi->pgi.task, hi->pgi.va, guest_image_size(&hi->pgi));
+    if (!rr) {
+        return;
+    }
+    if (!hi->stale_pages) {
+        hi->stale_pages = g_array_new(false, false, sizeof(uint32_t));
+    }
+    for (uint32_t i = 0; i < rr->n; i++) {
+        for (uint64_t page = rr->runs[i][0] >> 12;
+             page <= (rr->runs[i][0] + rr->runs[i][1] - 1) >> 12; page++) {
+            uint32_t p32 = (uint32_t)page;
+
+            if (page >= e->stale_npages) {
+                continue;
+            }
+            if (!(e->stale_bits[page / 64] >> (page % 64) & 1)) {
+                e->block_stale[page >> 9]++;
+            }
+            e->stale_bits[page / 64] |= 1ull << (page % 64);
+            g_hash_table_insert(e->stale_owner, GSIZE_TO_POINTER(page), hi);
+            g_array_append_val(hi->stale_pages, p32);
+        }
+    }
+    e->stale_images++;
+}
+
+static void stale_clear(PVGExec *e, HostImage *hi)
+{
+    if (hi->guest_stale) {
+        hi->guest_stale = false;
+        stale_pages_remove(e, hi);
+    }
+}
