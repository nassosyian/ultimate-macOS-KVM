+/*
+ * Present for a GL display: copy a BGRA surface (task va, width x height, row_bytes) into the
+ * next exportable scanout image, from its GPU image when that holds the newest contents, else
+ * from guest memory. Returns the buffer index (info describes the set), -1 on failure.
+ */
+int pvg_exec_scanout(PVGExec *e, uint32_t task, uint64_t va, uint32_t width, uint32_t height,
+                     uint32_t row_bytes, PVGScanout *info)
+{
+    VkCommandBufferBeginInfo bi = { .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
