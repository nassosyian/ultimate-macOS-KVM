+/* pipelines are built per topology class: Vulkan only lets the topology vary within one */
+static VkPrimitiveTopology topology_class(uint32_t t)
+{
+    return t == 0 ? VK_PRIMITIVE_TOPOLOGY_POINT_LIST :
+           t == 1 || t == 2 ? VK_PRIMITIVE_TOPOLOGY_LINE_LIST :
+           VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+}
+
 static VkPrimitiveTopology mtl_topology(uint32_t t)
 {
     switch (t) {
@@ -740,6 +750,7 @@ static bool image_upload(PVGExec *e, const GuestImage *gi, HostImage *hi, VkImag
     vkCmdCopyBufferToImage(e->cmd, e->arena, hi->image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
                            gi->mips, r);
     barrier(e, hi->image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, final);
+    hi->layout = final;
     e->stats.uploads++;
     return true;
 }
