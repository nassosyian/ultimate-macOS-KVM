-    unsigned n;
-    uint32_t parts[16];
     LLVMTypeRef et = LLVMGetTypeKind(t) == LLVMVectorTypeKind ? LLVMGetElementType(t) : t;
-    uint32_t etid = ty(c, et);
+    unsigned n = LLVMGetTypeKind(t) == LLVMVectorTypeKind ? LLVMGetVectorSize(t) : 1;
+    unsigned esize = (unsigned)LLVMABISizeOfType(c->td, et);
+    uint32_t etid = ty(c, et), parts[16];
+    bool fp = LLVMGetTypeKind(et) == LLVMFloatTypeKind || LLVMGetTypeKind(et) == LLVMHalfTypeKind;
 
-    if (!priv_type_ok(t, &n)) {
+    if (n > 16 || (esize != 1 && esize != 2 && esize != 4) ||
+        (LLVMGetTypeKind(et) != LLVMIntegerTypeKind && !fp) || is_bool(et)) {
         return fail(c, "private load of an unsupported type");
     }
     for (unsigned k = 0; k < n; k++) {
-        uint32_t ptr = priv_word_ptr(c, pi, k);
-        uint32_t w = emit(c, SpvOpLoad, c->t_u32, 0, &ptr, 1);
+        uint32_t w = priv_component(c, pi, esize, k);
 
-        parts[k] = etid == c->t_u32 ? w : emit(c, SpvOpBitcast, etid, 0, &w, 1);
+        if (esize == 4) {
+            parts[k] = etid == c->t_u32 ? w : emit(c, SpvOpBitcast, etid, 0, &w, 1);
+        } else {
+            uint32_t it = spv_type_int(&c->m, esize * 8, false);
+            uint32_t narrow = emit(c, SpvOpUConvert, it, 0, &w, 1);
+
+            parts[k] = fp ? emit(c, SpvOpBitcast, etid, 0, &narrow, 1) : narrow;
+        }
     }
     if (n == 1) {
         emit(c, SpvOpCopyObject, etid, result, parts, 1);
@@ -2174,7 +2346,8 @@ int air2spv_translate(const void *bitcode, size_t len, A2SResult *io)
     c.t_u64 = spv_type_int(&c.m, 64, false);
     c.t_f32 = spv_type_float(&c.m, 32);
 
