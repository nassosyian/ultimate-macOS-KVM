+/* byte image of a constant (data layout of the module), for constant globals */
+static bool const_bytes(Ctx *c, LLVMValueRef v, uint8_t *buf, uint64_t size)
+{
+    LLVMTypeRef t = LLVMTypeOf(v);
+    LLVMTypeKind k = LLVMGetTypeKind(t);
+    uint64_t tsize = LLVMABISizeOfType(c->td, t);
+
+    if (tsize > size) {
+        return false;
+    }
+    if (LLVMIsAConstantAggregateZero(v) || LLVMIsUndef(v) || LLVMIsPoison(v) ||
+        LLVMIsAConstantPointerNull(v)) {
+        memset(buf, 0, tsize);
+        return true;
+    }
+    if (LLVMIsAConstantInt(v)) {
+        uint64_t x = LLVMConstIntGetZExtValue(v);
+
+        memcpy(buf, &x, tsize < 8 ? tsize : 8);
+        return true;
+    }
+    if (LLVMIsAConstantFP(v)) {
+        LLVMBool loses;
+        double d = LLVMConstRealGetDouble(v, &loses);
+
+        if (k == LLVMFloatTypeKind) {
+            float f = (float)d;
+
+            memcpy(buf, &f, 4);
+        } else if (k == LLVMDoubleTypeKind) {
+            memcpy(buf, &d, 8);
+        } else if (k == LLVMHalfTypeKind) {
+            uint16_t h = (uint16_t)f32_to_f16((float)d);
+
+            memcpy(buf, &h, 2);
+        } else {
+            return false;
+        }
+        return true;
+    }
+    if (k == LLVMArrayTypeKind || k == LLVMVectorTypeKind || k == LLVMStructTypeKind) {
+        unsigned n = k == LLVMStructTypeKind ? LLVMCountStructElementTypes(t) :
+                     k == LLVMVectorTypeKind ? LLVMGetVectorSize(t) : (unsigned)LLVMGetArrayLength2(t);
+
+        memset(buf, 0, tsize);
+        for (unsigned i = 0; i < n; i++) {
+            LLVMTypeRef et = k == LLVMStructTypeKind ? LLVMStructGetTypeAtIndex(t, i) :
+                             LLVMGetElementType(t);
+            uint64_t off = k == LLVMStructTypeKind ? LLVMOffsetOfElement(c->td, t, i) :
+                           i * LLVMABISizeOfType(c->td, et);
+            LLVMValueRef e = LLVMGetAggregateElement(v, i);
+
+            if (!e || !const_bytes(c, e, buf + off, tsize - off)) {
+                return false;
+            }
+        }
+        return true;
+    }
+    return false;
+}
+
+/* module-scope Private uint[] holding a constant global's initializer */
+static int declare_constant_global(Ctx *c, LLVMValueRef g)
+{
+    LLVMValueRef init = LLVMGetInitializer(g);
+    LLVMTypeRef t = LLVMGlobalGetValueType(g);
+    uint64_t size = LLVMABISizeOfType(c->td, t);
+    uint32_t nwords = (uint32_t)((size + 3) / 4), arr[2], arr_t, ptr_t, ops[4], *words;
+    uint8_t *bytes;
+
+    if (!init || !size || size > 64 * 1024 || c->npriv == 64) {
+        return fail(c, "unsupported global %s", vname(g, NULL));
+    }
+    bytes = calloc(nwords, 4);
+    if (!const_bytes(c, init, bytes, (uint64_t)nwords * 4)) {
+        free(bytes);
+        return fail(c, "unsupported initializer of %s", vname(g, NULL));
+    }
+    words = calloc(nwords, sizeof(*words));
+    for (uint32_t i = 0; i < nwords; i++) {
+        uint32_t w;
+
+        memcpy(&w, bytes + 4 * i, 4);
+        words[i] = spv_const_u32(&c->m, w);
+    }
+    free(bytes);
+    arr[0] = c->t_u32;
+    arr[1] = spv_const_u32(&c->m, nwords);
+    arr_t = spv_type(&c->m, SpvOpTypeArray, arr, 2);
+    ptr_t = spv_type_ptr(&c->m, SpvStoragePrivate, arr_t);
+    ops[0] = ptr_t;
+    ops[1] = spv_id(&c->m);
+    ops[2] = SpvStoragePrivate;
+    ops[3] = spv_const(&c->m, SpvOpConstantComposite, arr_t, words, nwords);
+    free(words);
+    spv_emit(&c->m, SPV_SEC_TYPES, SpvOpVariable, ops, 4);
+    if (c->niface < 128) {
+        c->iface[c->niface++] = ops[1];
+    }
+    c->priv[c->npriv].v = g;
+    c->priv[c->npriv].var = ops[1];
+    c->priv[c->npriv].off = spv_const_u32(&c->m, 0);
+    c->priv[c->npriv].words = nwords;
+    c->priv[c->npriv].ptr_t = spv_type_ptr(&c->m, SpvStoragePrivate, c->t_u32);
+    c->npriv++;
+    return 0;
+}
+
+static int declare_constant_globals(Ctx *c)
+{
+    for (LLVMValueRef g = LLVMGetFirstGlobal(c->mod); g; g = LLVMGetNextGlobal(g)) {
+        const char *n = vname(g, NULL);
+
+        if (!LLVMGetFirstUse(g) || resource_for(c, g) || !strncmp(n, "llvm.", 5)) {
+            continue;
+        }
+        if (declare_constant_global(c, g)) {
+            return -1;
+        }
+    }
+    return 0;
 }
 
 static bool priv_type_ok(LLVMTypeRef t, unsigned *n)
@@ -1638,21 +1770,61 @@ static bool priv_type_ok(LLVMTypeRef t, unsigned *n)
