+/* component k of element size esize (1, 2 or 4 bytes) at the private offset, as a u32 */
+static uint32_t priv_component(Ctx *c, int pi, unsigned esize, unsigned k)
+{
+    uint32_t ops[3], co, word, w, shift;
+
+    ops[0] = c->priv[pi].off;
+    ops[1] = spv_const_u32(&c->m, esize * k);
+    co = k ? emit(c, SpvOpIAdd, c->t_u32, 0, ops, 2) : c->priv[pi].off;
+    ops[0] = co;
+    ops[1] = spv_const_u32(&c->m, 2);
+    word = emit(c, SpvOpShiftRightLogical, c->t_u32, 0, ops, 2);
+    ops[0] = c->priv[pi].var;
+    ops[1] = word;
+    w = emit(c, SpvOpAccessChain, c->priv[pi].ptr_t, 0, ops, 2);
+    w = emit(c, SpvOpLoad, c->t_u32, 0, &w, 1);
+    if (esize == 4) {
+        return w;
+    }
+    ops[0] = co;
+    ops[1] = spv_const_u32(&c->m, 3);
+    shift = emit(c, SpvOpBitwiseAnd, c->t_u32, 0, ops, 2);
+    ops[0] = shift;
+    ops[1] = spv_const_u32(&c->m, 3);
+    shift = emit(c, SpvOpShiftLeftLogical, c->t_u32, 0, ops, 2);
+    ops[0] = w;
+    ops[1] = shift;
+    w = emit(c, SpvOpShiftRightLogical, c->t_u32, 0, ops, 2);
+    ops[0] = w;
+    ops[1] = spv_const_u32(&c->m, esize == 2 ? 0xffff : 0xff);
+    return emit(c, SpvOpBitwiseAnd, c->t_u32, 0, ops, 2);
+}
