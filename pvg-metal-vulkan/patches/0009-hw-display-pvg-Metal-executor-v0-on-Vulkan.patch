+static bool pvg_task_write(PVGLinuxPCIState *s, uint32_t task, uint64_t va,
+                           const void *buf, uint64_t len)
+{
+    const uint8_t *p = buf;
+
+    while (len) {
+        uint64_t chunk = MIN(len, 0x1000 - (va & 0xfff));
+        uint64_t gpa;
+
+        if (!pvg_task_translate(s, task, va, &gpa) ||
+            pci_dma_write(PCI_DEVICE(s), gpa, p, chunk) != MEMTX_OK) {
+            return false;
+        }
+        p += chunk;
+        va += chunk;
+        len -= chunk;
+    }
+    return true;
+}
