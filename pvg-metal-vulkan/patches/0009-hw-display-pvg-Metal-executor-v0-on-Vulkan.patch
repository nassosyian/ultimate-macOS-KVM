+
+static uint8_t pvg_exec_object(void *opaque, uint32_t task, uint32_t id, void *buf,
+                               uint32_t size, uint32_t *len)
+{
+    PVGLinuxPCIState *s = opaque;
+    uint8_t type;
+
+    if (task >= PVG_MAX_TASKS) {
+        return 0;
+    }
+    type = pvg_task_object(s, task, id, buf, size, len);
+    return type == PVG_OBJ_UNREADABLE ? 0 : type;
+}
+
+static void pvg_exec_log(void *opaque, const char *msg)
