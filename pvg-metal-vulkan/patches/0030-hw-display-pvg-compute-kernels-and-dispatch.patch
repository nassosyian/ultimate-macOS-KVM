+/* kernels: threads per threadgroup as spec constants A2S_SPEC_LOCAL_X..Z (default 1) */
+static void declare_local_size(Ctx *c)
+{
+    for (int i = 0; i < 3; i++) {
+        uint32_t sc[3] = { c->t_u32, spv_id(&c->m), 1 };
+
+        spv_emit(&c->m, SPV_SEC_TYPES, SpvOpSpecConstant, sc, 3);
+        decorate1(c, sc[1], SpvDecorationSpecId, A2S_SPEC_LOCAL_X + i);
+        c->local_size[i] = sc[1];
+    }
+}
+
+/* a uvec3 (or u32 when src_n == 1) kernel builtin as the AIR parameter's type */
+static uint32_t kernel_builtin_value(Ctx *c, uint32_t v, int src_n, LLVMTypeRef t)
+{
+    LLVMTypeRef et = LLVMGetTypeKind(t) == LLVMVectorTypeKind ? LLVMGetElementType(t) : t;
+    int n = LLVMGetTypeKind(t) == LLVMVectorTypeKind ? (int)LLVMGetVectorSize(t) : 1;
+    unsigned w = LLVMGetIntTypeWidth(et);
+    uint32_t ops[5];
+
+    if (n == 1 && src_n == 3) {
+        ops[0] = v;
+        ops[1] = 0;
+        v = emit(c, SpvOpCompositeExtract, c->t_u32, 0, ops, 2);
+    } else if (n == 2 && src_n == 3) {
+        ops[0] = v;
+        ops[1] = v;
+        ops[2] = 0;
+        ops[3] = 1;
+        v = emit(c, SpvOpVectorShuffle, spv_type_vec(&c->m, c->t_u32, 2), 0, ops, 4);
+    }
+    if (w != 32) {
+        v = emit(c, SpvOpUConvert, ty(c, t), 0, &v, 1);
+    }
+    return v;
+}
