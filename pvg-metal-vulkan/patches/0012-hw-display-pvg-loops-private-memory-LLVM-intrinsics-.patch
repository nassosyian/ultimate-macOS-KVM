+    *n = LLVMGetTypeKind(t) == LLVMVectorTypeKind ? LLVMGetVectorSize(t) : 1;
+    return (LLVMGetTypeKind(et) == LLVMFloatTypeKind ||
+            (LLVMGetTypeKind(et) == LLVMIntegerTypeKind && LLVMGetIntTypeWidth(et) == 32)) &&
+           *n <= 16;
+}
