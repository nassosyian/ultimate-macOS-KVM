+/* ---- blit segments: executed on guest memory (the executor's source of truth) ---- */
+
+static bool buffer_range(PVGExec *e, uint32_t task, uint32_t ref, uint64_t off, uint64_t len,
+                         uint64_t *va)
+{
+    uint8_t obj[MAX_OBJ];
+    uint32_t olen;
+
+    if (object(e, task, ref, obj, &olen) != OBJ_BUFFER || olen < 0x10 ||
+        off + len > ldq(obj) || off + len < off) {
+        return false;
+    }
+    *va = ((uint64_t)ldl(obj + 8) << 12) + off;
+    return true;
+}
+
+/* copy 'rows' rows of 'row' bytes between strided guest ranges through a bounce buffer */
+static bool copy_rows(PVGExec *e, uint32_t stask, uint64_t sva, uint64_t sstride,
+                      uint32_t dtask, uint64_t dva, uint64_t dstride, uint64_t row, uint64_t rows)
+{
+    g_autofree uint8_t *tmp = g_malloc(row);
+
+    for (uint64_t y = 0; y < rows; y++) {
+        if (!e->host.read(e->host.opaque, stask, sva + y * sstride, tmp, row) ||
+            !e->host.write(e->host.opaque, dtask, dva + y * dstride, tmp, row)) {
+            return false;
+        }
+    }
+    note_write(e, dtask, dva, dstride * (rows ? rows - 1 : 0) + row, 'B');
+    return true;
+}
+
+static void exec_blit_segment(PVGExec *e, uint32_t task, const uint8_t *p, uint32_t len)
