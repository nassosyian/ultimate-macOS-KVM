+                e->stats.blits++;
+            }
+            break;
+        case 0x132:     /* FillBuffer {buf, u64 location, u64 length, u8 value} */
+            if (alen >= 0x15 && ldq(a + 0xc) && ldq(a + 0xc) <= (64u << 20) &&
