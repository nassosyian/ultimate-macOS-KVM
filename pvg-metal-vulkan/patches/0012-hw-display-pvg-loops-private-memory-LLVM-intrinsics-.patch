+                          gi.row_bytes, w * gi.bpp, h);
+                e->stats.blits++;
+            }
+            break;
+        case 0x12e:     /* CopyFromTextureToBuffer */
+            if (alen >= 0x58 && guest_image(e, task, ldl(a), &gi) && !lduw(a + 0x52)) {
+                uint64_t x = ldq(a + 8), y = ldq(a + 0x10), w = ldq(a + 0x20), h = ldq(a + 0x28);
+                uint64_t bpr = ldq(a + 0x40);
+
+                if (x + w > gi.width || y + h > gi.height || !w || !h ||
+                    !buffer_range(e, task, ldl(a + 4), ldq(a + 0x38), bpr * (h - 1) + w * gi.bpp,
+                                  &va)) {
+                    break;
+                }
+                copy_rows(e, gi.task, gi.va + y * gi.row_bytes + x * gi.bpp, gi.row_bytes, task,
+                          va, bpr, w * gi.bpp, h);
+                e->stats.blits++;
+            }
+            break;
+        case 0x12f:     /* CopyFromTextureToTexture */
+        case 0x130:     /* ...WithOptions: same prefix */
+            if (alen >= 0x58 && guest_image(e, task, ldl(a), &gi) &&
+                guest_image(e, task, ldl(a + 4), &gi2) && gi.bpp == gi2.bpp &&
+                !lduw(a + 0x52) && !lduw(a + 0x56) && !lduw(a + 0x50) && !lduw(a + 0x54)) {
+                uint64_t sx = ldq(a + 8), sy = ldq(a + 0x10), w = ldq(a + 0x20), h = ldq(a + 0x28);
+                uint64_t dx = ldq(a + 0x38), dy = ldq(a + 0x40);
+
+                if (sx + w > gi.width || sy + h > gi.height || dx + w > gi2.width ||
+                    dy + h > gi2.height || !w || !h) {
+                    break;
+                }
+                copy_rows(e, gi.task, gi.va + sy * gi.row_bytes + sx * gi.bpp, gi.row_bytes,
+                          gi2.task, gi2.va + dy * gi2.row_bytes + dx * gi2.bpp, gi2.row_bytes,
+                          w * gi.bpp, h);
+                e->stats.blits++;
+            }
+            break;
+        case 0x12d:     /* CopyFromBufferToBuffer {src, dst, u64 soff, u64 doff, u64 size} */
+            if (alen >= 0x20 && ldq(a + 0x18) &&
