+/* entry-block declarations for every alloca (must precede other instructions) */
+static int declare_allocas(Ctx *c)
+{
+    for (LLVMBasicBlockRef bb = LLVMGetFirstBasicBlock(c->fn); bb; bb = LLVMGetNextBasicBlock(bb)) {
+        for (LLVMValueRef in = LLVMGetFirstInstruction(bb); in; in = LLVMGetNextInstruction(in)) {
+            LLVMTypeRef at;
+            uint64_t size;
+            uint32_t arr[2], arr_t, ptr_t, ops[3];
+
+            if (LLVMGetInstructionOpcode(in) != LLVMAlloca) {
+                continue;
+            }
+            if (c->npriv == 64 || !LLVMIsAConstantInt(LLVMGetOperand(in, 0))) {
+                return fail(c, "unsupported alloca");
+            }
+            at = LLVMGetAllocatedType(in);
+            size = LLVMABISizeOfType(c->td, at) * LLVMConstIntGetZExtValue(LLVMGetOperand(in, 0));
+            if (!size || size > 64 * 1024) {
+                return fail(c, "alloca of %llu bytes", (unsigned long long)size);
+            }
+            arr[0] = c->t_u32;
+            arr[1] = spv_const_u32(&c->m, (uint32_t)((size + 3) / 4));
+            arr_t = spv_type(&c->m, SpvOpTypeArray, arr, 2);
+            ptr_t = spv_type_ptr(&c->m, SpvStorageFunction, arr_t);
+            ops[0] = ptr_t;
+            ops[1] = spv_id(&c->m);
+            ops[2] = SpvStorageFunction;
+            spv_emit(&c->m, SPV_SEC_FUNCS, SpvOpVariable, ops, 3);
+            c->priv[c->npriv].v = in;
+            c->priv[c->npriv].var = ops[1];
+            c->priv[c->npriv].off = spv_const_u32(&c->m, 0);
+            c->priv[c->npriv].words = (uint32_t)((size + 3) / 4);
+            c->npriv++;
+        }
+    }
+    c->t_fn_u32_ptr = spv_type_ptr(&c->m, SpvStorageFunction, c->t_u32);
+    return 0;
+}
+
+/* GEP on a private pointer: same layout rules as device memory, 32-bit offsets */
+static int priv_gep(Ctx *c, LLVMValueRef inst, int base)
+{
+    LLVMTypeRef t = LLVMGetGEPSourceElementType(inst);
+    unsigned n = LLVMGetNumOperands(inst);
+    uint32_t off = c->priv[base].off;
+
+    if (c->npriv == 64) {
+        return fail(c, "too many private pointers");
+    }
+    for (unsigned i = 1; i < n; i++) {
+        LLVMValueRef idx = LLVMGetOperand(inst, i);
+        uint32_t ops[2], term;
+
+        if (i > 1 && LLVMGetTypeKind(t) == LLVMStructTypeKind) {
+            unsigned field = (unsigned)LLVMConstIntGetZExtValue(idx);
+
+            term = spv_const_u32(&c->m, (uint32_t)LLVMOffsetOfElement(c->td, t, field));
+            t = LLVMStructGetTypeAtIndex(t, field);
+        } else {
+            uint32_t iv;
+
+            if (i > 1) {
+                t = LLVMGetElementType(t);
+            }
+            iv = val(c, idx);
+            if (LLVMGetIntTypeWidth(LLVMTypeOf(idx)) != 32) {
+                iv = emit(c, SpvOpUConvert, c->t_u32, 0, &iv, 1);
+            }
+            ops[0] = iv;
+            ops[1] = spv_const_u32(&c->m, (uint32_t)LLVMABISizeOfType(c->td, t));
+            term = emit(c, SpvOpIMul, c->t_u32, 0, ops, 2);
+        }
+        ops[0] = off;
+        ops[1] = term;
+        off = emit(c, SpvOpIAdd, c->t_u32, 0, ops, 2);
+    }
+    c->priv[c->npriv] = c->priv[base];
+    c->priv[c->npriv].v = inst;
+    c->priv[c->npriv].off = off;
+    c->npriv++;
+    return 0;
+}
+
+/* word index of a private byte offset + k words */
+static uint32_t priv_word_ptr(Ctx *c, int pi, uint32_t k)
+{
+    uint32_t ops[3] = { c->priv[pi].off, spv_const_u32(&c->m, 2) };
+    uint32_t w = emit(c, SpvOpShiftRightLogical, c->t_u32, 0, ops, 2);
+
+    if (k) {
+        ops[0] = w;
+        ops[1] = spv_const_u32(&c->m, k);
+        w = emit(c, SpvOpIAdd, c->t_u32, 0, ops, 2);
+    }
+    ops[0] = c->priv[pi].var;
+    ops[1] = w;
+    return emit(c, SpvOpAccessChain, c->t_fn_u32_ptr, 0, ops, 2);
+}
