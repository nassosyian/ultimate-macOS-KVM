From d85f0642c042eb7353f34e0c4b98024a0e4234ab Mon Sep 17 00:00:00 2001
From: Nassos Yiannopoulos <nassosyian@gmail.com>
Date: Sat, 31 Oct 2026 11:21:57 +0200
Subject: [PATCH 69/72] hw/display/pvg: batch zero-copy regions and dirty
 marking

Copy regions are queued per imported RAM piece (merged when contiguous) and
recorded as one vkCmdCopyBuffer per piece: gathers once per submission,
scatters once per write-back (keeping write-backs ordered). Dirty marking
coalesces contiguous RAM ranges. Damage rectangles used one copy command
per row. Recording time 19 -> 7 ms per 500 cmdbufs.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hw/display/pvg/pvg-exec.c | 112 ++++++++++++++++++++++++++++----------
 hw/display/pvg/pvg-exec.h |   3 +-
 2 files changed, 84 insertions(+), 31 deletions(-)

diff --git a/hw/display/pvg/pvg-exec.c b/hw/display/pvg/pvg-exec.c
index 1a1c046..89f9fc1 100644
--- a/hw/display/pvg/pvg-exec.c
+++ b/hw/display/pvg/pvg-exec.c
@@ -188,8 +188,8 @@ struct PVGExec {
     bool zc_pre_open, zc_post_open;
     uint64_t (*zc_runs)[2];
     uint32_t zc_runs_max;
-    VkBufferCopy *zc_regs;
-    uint32_t zc_regs_max;
+    GArray *zc_acc[2][ZC_MAX_CHUNKS];   /* pending regions per RAM piece: [0] gather, [1] scatter */
+    uint64_t dirty_ram, dirty_len;      /* coalesced range still to be marked dirty */
     GHashTable *zc_cache;
     const char *flush_why;      /* diagnostics: why private images are being flushed */
     /*
@@ -867,17 +867,72 @@ static int zc_piece(PVGExec *e, uint64_t ram)
     return -1;
 }
 
-static void zc_flush_regions(PVGExec *e, VkCommandBuffer c, int piece, uint32_t nr,
-                             bool to_guest)
+/* queue one copy region of piece k (merged with the previous one when contiguous) */
+static void zc_add(PVGExec *e, bool to_guest, int k, uint64_t src, uint64_t dst, uint64_t size)
 {
-    if (!nr) {
+    GArray *a = e->zc_acc[to_guest][k];
+    VkBufferCopy *last;
+
+    if (!a) {
+        a = e->zc_acc[to_guest][k] = g_array_new(false, false, sizeof(VkBufferCopy));
+    }
+    last = a->len ? &g_array_index(a, VkBufferCopy, a->len - 1) : NULL;
+    if (last && last->srcOffset + last->size == src && last->dstOffset + last->size == dst) {
+        last->size += size;
+    } else {
+        VkBufferCopy r = { .srcOffset = src, .dstOffset = dst, .size = size };
+
+        g_array_append_val(a, r);
+    }
+}
+
+static void zc_mark_dirty(PVGExec *e, uint64_t ram, uint64_t len)
+{
+    if (e->dirty_len && e->dirty_ram + e->dirty_len == ram) {
+        e->dirty_len += len;
         return;
     }
+    if (e->dirty_len && e->host.mark_dirty) {
+        e->host.mark_dirty(e->host.opaque, e->dirty_ram, e->dirty_len);
+    }
+    e->dirty_ram = ram;
+    e->dirty_len = len;
+}
+
+/* record the queued gathers (pre) or scatters (post): one vkCmdCopyBuffer per piece */
+static void zc_emit(PVGExec *e, bool to_guest)
+{
+    for (uint32_t k = 0; k < e->zc_nram; k++) {
+        GArray *a = e->zc_acc[to_guest][k];
+
+        if (!a || !a->len) {
+            continue;
+        }
+        if (to_guest) {
+            vkCmdCopyBuffer(zc_cmd(e, true), e->stage, e->zc_ram[k].buf, a->len,
+                            (VkBufferCopy *)a->data);
+        } else {
+            vkCmdCopyBuffer(zc_cmd(e, false), e->zc_ram[k].buf, e->stage, a->len,
+                            (VkBufferCopy *)a->data);
+        }
+        g_array_set_size(a, 0);
+    }
     if (to_guest) {
-        vkCmdCopyBuffer(c, e->stage, e->zc_ram[piece].buf, nr, e->zc_regs);
-    } else {
-        vkCmdCopyBuffer(c, e->zc_ram[piece].buf, e->stage, nr, e->zc_regs);
+        zc_mark_dirty(e, 0, 0);     /* flush the coalesced range */
+        e->dirty_len = 0;
+    }
+}
+
+static void zc_acc_clear(PVGExec *e)
+{
+    for (int d = 0; d < 2; d++) {
+        for (uint32_t k = 0; k < ZC_MAX_CHUNKS; k++) {
+            if (e->zc_acc[d][k]) {
+                g_array_set_size(e->zc_acc[d][k], 0);
+            }
+        }
     }
+    e->dirty_len = 0;
 }
 
 /*
@@ -889,9 +944,7 @@ static void zc_flush_regions(PVGExec *e, VkCommandBuffer c, int piece, uint32_t
 static bool zc_copy(PVGExec *e, uint32_t task, uint64_t cva, uint64_t clen, uint64_t va,
                     uint64_t len, uint64_t off, bool to_guest)
 {
-    uint32_t lo, hi, nr = 0;
-    int last = -1;
-    VkCommandBuffer c;
+    uint32_t lo, hi;
     const ZCRuns *rr;
     uint64_t rel;
 
@@ -927,11 +980,6 @@ static bool zc_copy(PVGExec *e, uint32_t task, uint64_t cva, uint64_t clen, uint
             ram = e->zc_ram[k].ram + e->zc_ram[k].len;
         }
     }
-    if (rr->n + e->zc_nram > e->zc_regs_max) {
-        e->zc_regs_max = rr->n + e->zc_nram;
-        e->zc_regs = g_realloc(e->zc_regs, e->zc_regs_max * sizeof(*e->zc_regs));
-    }
-    c = zc_cmd(e, to_guest);
     for (uint32_t i = lo; i < rr->n && rr->runs[i][2] < rel + len; i++) {
         uint64_t rs = rr->runs[i][2], re = rs + rr->runs[i][1];
         uint64_t s0 = MAX(rs, rel), s1 = MIN(re, rel + len);
@@ -942,25 +990,17 @@ static bool zc_copy(PVGExec *e, uint32_t task, uint64_t cva, uint64_t clen, uint
             int k = zc_piece(e, ram);
             uint64_t take = MIN(left, e->zc_ram[k].ram + e->zc_ram[k].len - ram);
 
-            if (k != last) {
-                zc_flush_regions(e, c, last, nr, to_guest);
-                nr = 0;
-                last = k;
-            }
-            e->zc_regs[nr++] = to_guest ?
-                (VkBufferCopy){ .srcOffset = dst, .dstOffset = ram - e->zc_ram[k].ram,
-                                .size = take } :
-                (VkBufferCopy){ .srcOffset = ram - e->zc_ram[k].ram, .dstOffset = dst,
-                                .size = take };
-            if (to_guest && e->host.mark_dirty) {
-                e->host.mark_dirty(e->host.opaque, ram, take);
+            if (to_guest) {
+                zc_add(e, true, k, dst, ram - e->zc_ram[k].ram, take);
+                zc_mark_dirty(e, ram, take);
+            } else {
+                zc_add(e, false, k, ram - e->zc_ram[k].ram, dst, take);
             }
             ram += take;
             dst += take;
             left -= take;
         }
     }
-    zc_flush_regions(e, c, last, nr, to_guest);
     if (to_guest) {
         e->stats.zc_scattered += len;
     } else {
@@ -1038,6 +1078,7 @@ static bool arena_to_guest(PVGExec *e, uint32_t task, uint64_t va, uint64_t off,
 /* end of one image's or buffer's write-back: later (possibly overlapping) ones come after it */
 static void zc_writeback_done(PVGExec *e)
 {
+    zc_emit(e, true);
     if (e->zc_post_open) {
         zc_full_barrier(e->zc_post);
     }
@@ -1046,6 +1087,7 @@ static void zc_writeback_done(PVGExec *e)
 /* gathers/scatters recorded for a command buffer that was never submitted */
 static void zc_discard(PVGExec *e)
 {
+    zc_acc_clear(e);
     if (e->zc_pre_open) {
         vkEndCommandBuffer(e->zc_pre);
         e->zc_pre_open = false;
@@ -3097,6 +3139,10 @@ static bool submit_wait(PVGExec *e, const VkSubmitInfo *si)
     uint32_t ncb = 0;
 
     /* zero-copy: guest RAM gathers before the command buffer, write-back scatters after */
+    if (e->zc) {
+        zc_emit(e, false);
+        zc_emit(e, true);
+    }
     if (e->zc_pre_open) {
         zc_full_barrier(e->zc_pre);
         vkEndCommandBuffer(e->zc_pre);
@@ -5841,7 +5887,13 @@ void pvg_exec_free(PVGExec *e)
     g_ptr_array_free(e->retired, true);
     zc_fini(e);
     g_free(e->zc_runs);
-    g_free(e->zc_regs);
+    for (int dir = 0; dir < 2; dir++) {
+        for (uint32_t k = 0; k < ZC_MAX_CHUNKS; k++) {
+            if (e->zc_acc[dir][k]) {
+                g_array_free(e->zc_acc[dir][k], true);
+            }
+        }
+    }
     free_ctx = e;
     g_hash_table_destroy(e->images);
     g_ptr_array_free(e->cached, true);
diff --git a/hw/display/pvg/pvg-exec.h b/hw/display/pvg/pvg-exec.h
index a8bfb35..ad6b633 100644
--- a/hw/display/pvg/pvg-exec.h
+++ b/hw/display/pvg/pvg-exec.h
@@ -60,7 +60,8 @@ typedef struct PVGExecStats {
     uint64_t zc_gathered, zc_scattered, zc_fallbacks;  /* zero-copy bytes in / out, CPU fallbacks */
     uint64_t bar_written;
     uint64_t image_creates, pool_hits;  /* host images created / reused from the pool */
-    uint64_t queue_waits;       /* vkQueueWaitIdle actually needed */       /* bytes the CPU wrote straight into VRAM (resizable BAR) */       /* GenerateMipmaps done on the GPU (the rest: CPU fallback) */
+    uint64_t queue_waits;
+    uint64_t zc_record_us, zc_dirty_us, zc_regions, zc_copies;  /* TEMP diagnostics */       /* vkQueueWaitIdle actually needed */       /* bytes the CPU wrote straight into VRAM (resizable BAR) */       /* GenerateMipmaps done on the GPU (the rest: CPU fallback) */
 } PVGExecStats;
 
 typedef struct PVGExec PVGExec;
-- 
