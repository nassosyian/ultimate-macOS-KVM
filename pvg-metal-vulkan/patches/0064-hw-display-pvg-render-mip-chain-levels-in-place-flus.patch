+/*
+ * Render targets other than level 0 / slice 0 get their own host image per level and slice
+ * (a blur pyramid renders into every level of one texture in turn): the "task" word of the
+ * key carries them above the task id (tasks are < 256).
+ */
+#define KEY_TASK(k)     ((uint32_t)((k) >> 32) & 0xff)
+
+static uint32_t level_task(uint32_t task, uint32_t level, uint32_t slice)
+{
+    return task | (level & 0xff) << 8 | (slice & 0xffff) << 16;
+}
+
+static uint32_t level_ref(uint32_t ref, uint32_t level, uint32_t slice)
+{
+    return level || slice ? ref | 0x10000000u : ref;
+}
