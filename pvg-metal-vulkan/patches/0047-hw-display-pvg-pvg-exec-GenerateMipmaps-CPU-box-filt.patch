+/* ---- blit: mipmap generation (CPU 2x2 box filter on the guest copy) ---- */
+
+static float half_to_float(uint16_t h)
+{
+    uint32_t sign = (uint32_t)(h & 0x8000) << 16, exp = (h >> 10) & 0x1f, man = h & 0x3ff, f;
+    float r;
+
+    if (!exp) {
+        r = ldexpf((float)man, -24);
+        return sign ? -r : r;
+    }
+    f = sign | (exp == 31 ? 0x7f800000u | (man << 13) : ((exp + 112) << 23) | (man << 13));
+    memcpy(&r, &f, 4);
+    return r;
+}
+
+static uint16_t float_to_half(float v)
+{
+    uint32_t f, sign, man;
+    int exp;
+
+    memcpy(&f, &v, 4);
+    sign = (f >> 16) & 0x8000;
+    exp = (int)((f >> 23) & 0xff) - 127 + 15;
+    man = f & 0x7fffff;
+    if (((f >> 23) & 0xff) == 0xff) {
+        return sign | 0x7c00 | (man ? 0x200 : 0);
+    }
+    if (exp >= 31) {
+        return sign | 0x7c00;
+    }
+    if (exp <= 0) {
+        return exp < -10 ? sign : sign | ((man | 0x800000) >> (14 - exp));
+    }
+    return sign | (exp << 10) | (man >> 13);
+}
+
+/* channel layout of formats whose levels can be averaged per channel; 0 = unsupported */
+static int mip_channels(VkFormat f, int *kind)
+{
+    switch (f) {
+    case VK_FORMAT_R8_UNORM: case VK_FORMAT_R8_SRGB: *kind = 0; return 1;
+    case VK_FORMAT_R8G8_UNORM: *kind = 0; return 2;
+    case VK_FORMAT_R8G8B8A8_UNORM: case VK_FORMAT_R8G8B8A8_SRGB:
+    case VK_FORMAT_B8G8R8A8_UNORM: case VK_FORMAT_B8G8R8A8_SRGB: *kind = 0; return 4;
+    case VK_FORMAT_R16_SFLOAT: *kind = 1; return 1;
+    case VK_FORMAT_R16G16_SFLOAT: *kind = 1; return 2;
+    case VK_FORMAT_R16G16B16A16_SFLOAT: *kind = 1; return 4;
+    case VK_FORMAT_R32_SFLOAT: *kind = 2; return 1;
+    case VK_FORMAT_R32G32_SFLOAT: *kind = 2; return 2;
+    case VK_FORMAT_R32G32B32A32_SFLOAT: *kind = 2; return 4;
+    default: return 0;
+    }
+}
+
+static float mip_load(const uint8_t *p, int kind, int c)
+{
+    return kind == 0 ? p[c] : kind == 1 ? half_to_float(lduw(p + 2 * c)) : ldf(p + 4 * c);
+}
+
+static void mip_store(uint8_t *p, int kind, int c, float v)
+{
+    if (kind == 0) {
+        p[c] = (uint8_t)MIN(MAX(v + 0.5f, 0.0f), 255.0f);
+    } else if (kind == 1) {
+        uint16_t h = float_to_half(v);
+
+        memcpy(p + 2 * c, &h, 2);
+    } else {
+        memcpy(p + 4 * c, &v, 4);
+    }
+}
+
+static void generate_mipmaps(PVGExec *e, uint32_t task, uint32_t ref)
+{
+    GuestImage all, src, dst;
+    int kind, nc;
+
+    if (!guest_image_ex(e, task, ref, -1, 0, &all) || all.mips < 2) {
+        return;
+    }
+    nc = mip_channels(all.format, &kind);
+    if (!nc || all.depth > 1) {
+        elog(e, "task %u texture %u: generateMipmaps for format %d / 3D not supported", task, ref,
+             all.format);
+        return;
+    }
+    for (uint32_t slice = 0; slice < all.layers; slice++) {
+        for (uint32_t l = 1; l < all.mips; l++) {
+            g_autofree uint8_t *in = NULL, *out = NULL;
+
+            if (!guest_image_ex(e, task, ref, l - 1, slice, &src) ||
+                !guest_image_ex(e, task, ref, l, slice, &dst) ||
+                src.bpp != dst.bpp || !dst.width || !dst.height) {
+                return;
+            }
+            in = g_malloc((size_t)src.row_bytes * src.height);
+            out = g_malloc((size_t)dst.width * dst.bpp);
+            if (!e->host.read(e->host.opaque, src.task, src.va, in,
+                              (uint64_t)src.row_bytes * src.height)) {
+                return;
+            }
+            for (uint32_t y = 0; y < dst.height; y++) {
+                uint32_t y0 = MIN(2 * y, src.height - 1), y1 = MIN(2 * y + 1, src.height - 1);
+
+                for (uint32_t x = 0; x < dst.width; x++) {
+                    uint32_t x0 = MIN(2 * x, src.width - 1), x1 = MIN(2 * x + 1, src.width - 1);
+
+                    for (int c = 0; c < nc; c++) {
+                        float v = mip_load(in + y0 * src.row_bytes + x0 * src.bpp, kind, c) +
+                                  mip_load(in + y0 * src.row_bytes + x1 * src.bpp, kind, c) +
+                                  mip_load(in + y1 * src.row_bytes + x0 * src.bpp, kind, c) +
+                                  mip_load(in + y1 * src.row_bytes + x1 * src.bpp, kind, c);
+
+                        mip_store(out + x * dst.bpp, kind, c, v * 0.25f);
+                    }
+                }
+                e->host.write(e->host.opaque, dst.task, dst.va + (uint64_t)y * dst.row_bytes, out,
+                              (uint64_t)dst.width * dst.bpp);
+            }
+            note_write(e, dst.task, dst.va, (uint64_t)dst.row_bytes * dst.height, 'M');
+        }
+    }
+    e->stats.blits++;
+}
