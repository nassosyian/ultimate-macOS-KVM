+                        guest_image_ex(e, task, ldl(a + 4), dlevel + lv, dslice + sl, &gi2) &&
+                        gi.bpp == gi2.bpp && gi.width == gi2.width && gi.height == gi2.height) {
+                        copy_rows(e, gi.task, gi.va, gi.row_bytes, gi2.task, gi2.va,
+                                  gi2.row_bytes, (uint64_t)gi.width * gi.bpp, gi.height);
+                    }
+                }
+            }
+            e->stats.blits++;
+            break;
+        }
+        case 0x134: case 0x135:     /* OptimizeForCPU/GPUAccess: layout hints */
+            break;
+        default:        /* synchronise, fences: nothing to do (in order) */
             if (e->blit_unhandled++ < 200) {
