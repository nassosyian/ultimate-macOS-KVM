From 6819ab82b5c832e6fdef06e3e134832b36b4c8c2 Mon Sep 17 00:00:00 2001
From: Nassos Yiannopoulos <nassosyian@gmail.com>
Date: Thu, 29 Oct 2026 21:34:22 +0200
Subject: [PATCH 37/54] hw/display/pvg: present-rate trace (pvg_linux_fps);
 VTMTS sampler diagnostics

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hw/display/pvg-linux-pci.c | 13 +++++++++++++
 hw/display/pvg/pvg-exec.c  | 13 +++++++++++++
 hw/display/trace-events    |  1 +
 3 files changed, 27 insertions(+)

diff --git a/hw/display/pvg-linux-pci.c b/hw/display/pvg-linux-pci.c
index 30a183a..766b029 100644
--- a/hw/display/pvg-linux-pci.c
+++ b/hw/display/pvg-linux-pci.c
@@ -245,6 +245,8 @@ struct PVGLinuxPCIState {
     bool scanout_valid;             /* console holds a presented frame */
     uint8_t gamma_lut[3][256];      /* Transaction3 gamma table, 8-bit per channel */
     bool gamma_active;              /* table set and not the identity */
+    int64_t fps_start;              /* frame-rate window (realtime ms) */
+    uint32_t fps_frames;
 
     /* properties */
     uint16_t vendor_id;
@@ -1413,6 +1415,17 @@ static void pvg_dispatch(PVGLinuxPCIState *s, const PVGCmdHeader *h,
     case PVG_CMD_DISPLAY_TRANSACTION3:
         if (len >= 0x24 && ldl_le_p(payload) == 0 && ldl_le_p(payload + 4) == 0) {
             trace_pvg_linux_present(0, 0, ldl_le_p(payload + 8));
+            {
+                /* presents per second (desktop frame rate) */
+                int64_t now = qemu_clock_get_ms(QEMU_CLOCK_REALTIME);
+
+                s->fps_frames++;
+                if (now - s->fps_start >= 1000) {
+                    trace_pvg_linux_fps(s->fps_frames * 1000 / (uint32_t)(now - s->fps_start));
+                    s->fps_frames = 0;
+                    s->fps_start = now;
+                }
+            }
             if (ldq_le_p(payload + 12)) {
                 pvg_display_set_gamma(s, ldq_le_p(payload + 12), ldq_le_p(payload + 20),
                                       ldl_le_p(payload + 28));
diff --git a/hw/display/pvg/pvg-exec.c b/hw/display/pvg/pvg-exec.c
index 624db9c..fc25a22 100644
--- a/hw/display/pvg/pvg-exec.c
+++ b/hw/display/pvg/pvg-exec.c
@@ -2722,6 +2722,19 @@ static void exec_compute_segment(PVGExec *e, uint32_t task, const uint8_t *p, ui
             }
             pp = cs.pipeline ? compute_pipeline_get(e, task, cs.pipeline, local, unnorm,
                                                     cs.tg_bytes) : NULL;
+            if (pp && pp->ok && e->dump_dir && e->cio_dumps < 12 && cio_match(e, pp->fs_name)) {
+                for (int i = 0; i < 4; i++) {
+                    uint8_t so[MAX_OBJ];
+                    uint32_t sl = 0;
+                    uint8_t sty = cs.smp[i] ? object(e, task, cs.smp[i], so, &sl) : 0;
+
+                    elog(e, "cio %u %s sampler %d ref %u type 0x%x w0 %08x (unnorm mask %#x) "
+                         "groups %ux%ux%u local %ux%ux%u grid %ux%ux%u", e->cio_dumps,
+                         pp->fs_name, i, cs.smp[i], sty, sl >= 16 ? ldl(so + 12) : 0, unnorm,
+                         groups[0], groups[1], groups[2], local[0], local[1], local[2], grid[0],
+                         grid[1], grid[2]);
+                }
+            }
             if (!pp || !pp->ok) {
                 e->stats.skipped_draws++;
                 break;
diff --git a/hw/display/trace-events b/hw/display/trace-events
index 6e9d245..078c0af 100644
--- a/hw/display/trace-events
+++ b/hw/display/trace-events
@@ -241,6 +241,7 @@ pvg_linux_cursor_glyph(uint64_t va, uint64_t stride, uint32_t w, uint32_t h, uin
 pvg_linux_doorbell(uint32_t port, uint32_t show, int x, int y) "port %u show=%u pos=%d,%d"
 pvg_linux_present(uint32_t port, uint32_t task, uint32_t surface) "port %u task %u surface %u"
 pvg_linux_present_done(uint32_t events, uint32_t mask) "events=0x%x mask=0x%x"
+pvg_linux_fps(uint32_t fps) "presents per second %u"
 pvg_linux_object_list(uint32_t task, uint64_t va, uint32_t len) "task %u objects at va=0x%"PRIx64" len=0x%x"
 pvg_linux_scanout(uint32_t surface, uint32_t w, uint32_t h, uint64_t va, uint32_t missing_rows, uint32_t nonzero_samples) "surface %u %ux%u va=0x%"PRIx64" unreadable_rows=%u nonzero_samples=%u"
 pvg_linux_scanout_skip(uint32_t surface, const char *why) "surface %u: %s"
-- 
