+#define PVG_CMD_DISPLAY_ACK         0x02
+#define PVG_CMD_DISPLAY_CURSOR_GLYPH 0x04
+#define PVG_CMD_DISPLAY_CURSOR_SHOW 0x05
+#define PVG_CMD_DISPLAY_TRANSACTION3 0x07
 #define PVG_CMD_DEFINE_CHILD_FIFO   0x30
 #define PVG_CMD_SET_OBJECT_LIST     0x33
 #define PVG_CMD_DEFINE_TASK2        0x38
 #define PVG_CMD_GET_DEVICE_INFO     0x3a
 
 #define PVG_ROOT_STAMP_INDEX    0
