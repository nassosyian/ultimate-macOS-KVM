+/* ---- private textures: resident on the GPU, written back only when the guest needs it ---- */
+
+static bool gi_overlap(const GuestImage *a, uint32_t task, uint64_t va, uint64_t len)
+{
+    uint64_t alen = guest_image_size(a);
+
+    return a->task == task && a->va < va + len && va < a->va + alen;
