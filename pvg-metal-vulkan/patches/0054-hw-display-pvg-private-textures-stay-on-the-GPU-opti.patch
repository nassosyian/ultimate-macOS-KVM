+void pvg_exec_cache_invalidate(PVGExec *e, uint32_t task, uint64_t va, uint64_t len)
+{
+    for (guint i = e->cached ? e->cached->len : 0; i-- > 0;) {
+        HostImage *hi = g_ptr_array_index(e->cached, i);
