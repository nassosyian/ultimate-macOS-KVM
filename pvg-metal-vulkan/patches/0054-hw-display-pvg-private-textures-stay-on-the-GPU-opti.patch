+/* texture refs a segment binds (Set{Fragment,Vertex}Textures, compute SetTextures) */
+static uint32_t segment_texture_refs(const uint8_t *p, uint32_t off, uint32_t len, uint32_t *out,
+                                     uint32_t max)
+{
+    uint32_t n = 0;
+
+    for (uint32_t o = off; o + 8 <= len;) {
+        uint32_t id = ldl(p + o), clen = ldl(p + o + 4);
+
+        if (clen < 8 || o + clen > len) {
+            break;
+        }
+        if (id == 0x72 || id == 0x81 || id == 0xce) {
+            uint32_t refs[MAX_SLOTS] = { 0 };
+
+            set_refs(refs, p + o + 8, clen - 8);
+            for (int i = 0; i < MAX_SLOTS && n < max; i++) {
+                if (refs[i]) {
+                    out[n++] = refs[i];
+                }
+            }
+        }
+        o += clen;
+    }
+    return n;
+}
