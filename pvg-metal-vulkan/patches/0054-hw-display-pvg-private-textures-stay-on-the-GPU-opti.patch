+/* RAM offsets (ram_addr_t) backing task va..va+len, merged into contiguous runs */
+static uint32_t pvg_exec_ram_runs(void *opaque, uint32_t task, uint64_t va, uint64_t len,
+                                  uint64_t (*runs)[2], uint32_t max)
+{
+    PVGLinuxPCIState *s = opaque;
+    uint32_t n = 0;
+
+    RCU_READ_LOCK_GUARD();
+    for (uint64_t p = va & ~0xfffull; p < va + len; p += 0x1000) {
+        uint64_t gpa, xlat, l = 0x1000;
+        MemoryRegion *mr;
+        ram_addr_t ra;
+
+        if (!pvg_task_translate(s, task, p, &gpa)) {
+            return 0;
+        }
+        mr = address_space_translate(&address_space_memory, gpa & ~0xfffull, &xlat, &l, false,
+                                     MEMTXATTRS_UNSPECIFIED);
+        if (!memory_region_is_ram(mr) || l < 0x1000) {
+            return 0;
+        }
+        ra = memory_region_get_ram_addr(mr) + xlat;
+        if (n && runs[n - 1][0] + runs[n - 1][1] == ra) {
+            runs[n - 1][1] += 0x1000;
+        } else if (n == max) {
+            return 0;
+        } else {
+            runs[n][0] = ra;
+            runs[n][1] = 0x1000;
+            n++;
+        }
+    }
+    return n;
+}
