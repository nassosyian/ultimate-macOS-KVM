+/* make hi a shader-readable texture: reuse the cached copy or upload the guest's */
+static void texture_prepare(PVGExec *e, const GuestImage *gi, HostImage *hi,
+                            VkImageLayout final)
+{
+    if (e->private_resident && gi->storage == 2) {
+        if (hi->resident && priv_same(hi, gi)) {
+            if (hi->layout != final) {
+                barrier(e, hi->image, hi->layout, final);
+                hi->layout = final;
+            }
+            e->stats.priv_skipped += guest_image_size(gi);
+            return;
+        }
+        if (image_upload(e, gi, hi, final)) {
+            priv_track(e, hi, gi);
+            hi->resident = true;
+            hi->guest_stale = false;
+        }
+        return;
+    }
+    if (cache_valid(hi, gi) && cache_check(e, hi)) {
+        if (hi->layout != final) {
+            barrier(e, hi->image, hi->layout, final);
+            hi->layout = final;
+        }
+        e->stats.cache_hits++;
+        e->stats.cache_saved += hi->c_len;
+        return;
+    }
+    if (image_upload(e, gi, hi, final)) {
+        cache_fill(e, hi, gi);
+    } else {
+        cache_drop(e, hi);
+    }
+}
