+static bool submit_wait(PVGExec *e, const VkSubmitInfo *si);
+
+/*
+ * write a stale image back to guest memory (its own submission: call only while no command
+ * buffer is being recorded). Stale images are single-level 2D render targets.
+ */
+static void priv_flush(PVGExec *e, HostImage *hi)
+{
+    const GuestImage *gi = &hi->pgi;
+    uint64_t size = (uint64_t)gi->row_bytes * gi->height, off;
+    VkCommandBufferBeginInfo bi = { .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+                                    .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT };
+    VkSubmitInfo si = { .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO, .commandBufferCount = 1,
+                        .pCommandBuffers = &e->cmd };
+    VkBufferImageCopy r = {
+        .bufferRowLength = gi->row_bytes / MAX(gi->bpp, 1),
+        .imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+        .imageExtent = { gi->width, gi->height, 1 },
+    };
+
+    if (!hi->guest_stale) {
+        return;
+    }
+    hi->guest_stale = false;
+    off = arena_alloc(e, size);
+    if (off == UINT64_MAX || hi->layout == VK_IMAGE_LAYOUT_UNDEFINED) {
+        return;
+    }
+    r.bufferOffset = off;
+    vkResetCommandBuffer(e->cmd, 0);
+    vkBeginCommandBuffer(e->cmd, &bi);
+    barrier(e, hi->image, hi->layout, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+    hi->layout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    vkCmdCopyImageToBuffer(e->cmd, hi->image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, e->arena, 1,
+                           &r);
+    vkEndCommandBuffer(e->cmd);
+    if (!submit_wait(e, &si)) {
+        return;
+    }
+    e->host.write(e->host.opaque, gi->task, gi->va, e->arena_ptr + off, wb_size(gi, size));
+    e->stats.priv_flushes++;
+}
+
+/* guest memory task:va..va+len is about to be read from the guest side: write back stale images */
+static void priv_flush_range(PVGExec *e, uint32_t task, uint64_t va, uint64_t len,
+                             const HostImage *except)
+{
+    for (guint i = 0; i < e->priv_imgs->len; i++) {
+        HostImage *hi = g_ptr_array_index(e->priv_imgs, i);
+
+        if (hi != except && hi->guest_stale && gi_overlap(&hi->pgi, task, va, len)) {
+            priv_flush(e, hi);
+        }
+    }
+}
+
+/* the memory was rewritten (by the GPU into 'writer', or by the executor): others are stale */
+static void priv_invalidate_range(PVGExec *e, uint32_t task, uint64_t va, uint64_t len,
+                                  const HostImage *writer)
+{
+    for (guint i = 0; i < e->priv_imgs->len; i++) {
+        HostImage *hi = g_ptr_array_index(e->priv_imgs, i);
+
+        if (hi != writer && hi->resident && gi_overlap(&hi->pgi, task, va, len)) {
+            hi->resident = false;
+        }
+    }
+}
+
+void pvg_exec_synchronize(PVGExec *e, uint32_t task, uint32_t id)
+{
+    static const uint32_t variants[] = { 0, 0x10000000u };
+
+    for (size_t i = 0; i < G_N_ELEMENTS(variants); i++) {
+        gint64 key = key_of(task, id | variants[i]);
+        HostImage *hi = g_hash_table_lookup(e->images, &key);
+
+        if (hi && hi->guest_stale) {
+            priv_flush(e, hi);
+        }
+    }
+}
+
+void pvg_exec_flush_range(PVGExec *e, uint32_t task, uint64_t va, uint64_t len)
+{
+    for (guint i = 0; e->priv_imgs && i < e->priv_imgs->len; i++) {
+        HostImage *hi = g_ptr_array_index(e->priv_imgs, i);
+
+        if (hi->guest_stale && (!len || gi_overlap(&hi->pgi, task, va, len)) &&
+            hi->pgi.task == task) {
+            priv_flush(e, hi);
+        }
+    }
+}
