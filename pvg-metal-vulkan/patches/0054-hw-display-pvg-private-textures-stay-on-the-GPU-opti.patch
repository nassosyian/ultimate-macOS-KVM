+/*
+ * before a segment records anything: make guest memory current for every texture it may
+ * upload (other images' stale contents overlapping it)
+ */
+static void priv_prepare_refs(PVGExec *e, uint32_t task, const uint32_t *refs, uint32_t n)
+{
+    for (uint32_t i = 0; i < n && e->priv_imgs->len; i++) {
+        GuestImage gi;
+        gint64 key = key_of(task, refs[i]);
+
+        if (refs[i] && guest_image(e, task, refs[i], &gi)) {
+            HostImage *own = g_hash_table_lookup(e->images, &key);
+
+            if (own && own->guest_stale && !priv_same(own, &gi)) {
+                priv_flush(e, own);     /* about to be re-created for another shape */
+            }
+            priv_flush_range(e, gi.task, gi.va, guest_image_size(&gi),
+                             priv_same(own, &gi) ? own : NULL);
+        }
+    }
+}
