+/* will hi be used as is for gi (else it gets re-created and loses unflushed contents) */
+static bool priv_same(const HostImage *hi, const GuestImage *gi)
+{
+    return hi && hi->priv && hi->pgi.task == gi->task && hi->pgi.va == gi->va &&
+           hi->pgi.width == gi->width && hi->pgi.height == gi->height &&
+           hi->pgi.mips == gi->mips && hi->pgi.layers == gi->layers &&
+           hi->pgi.depth == gi->depth && hi->pgi.format == gi->format;
+}
+
+static void priv_track(PVGExec *e, HostImage *hi, const GuestImage *gi)
+{
+    if (!hi->priv) {
+        hi->priv = true;
+        g_ptr_array_add(e->priv_imgs, hi);
+    }
+    hi->pgi = *gi;
+}
