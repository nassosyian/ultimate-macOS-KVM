+/* ---- upload cache: GPU copies of textures, valid while their guest pages stay clean ---- */
+
+#define CACHE_MAX_RUNS 4096
+
+static void cache_drop(PVGExec *e, HostImage *hi)
+{
+    if (!hi->cached) {
+        return;
+    }
+    g_ptr_array_remove_fast(e->cached, hi);
+    g_free(hi->runs);
+    hi->runs = NULL;
+    hi->nruns = 0;
+    hi->cached = false;
+    e->stats.cache_invalidated++;
+}
+
+static void dirty_log_add(PVGExec *e, uint64_t start, uint64_t len, const HostImage *owner);
+static bool cache_valid(const HostImage *hi, const GuestImage *gi);
+
+/* the image now equals the guest's copy of gi (just uploaded, or rendered and written back) */
+static void cache_fill(PVGExec *e, HostImage *hi, const GuestImage *gi)
+{
+    uint64_t (*runs)[2];
+    uint64_t len = guest_image_size(gi);
+    uint32_t n;
+
+    if (!e->upload_cache || !e->host.ram_runs || !len) {
+        return;
+    }
+    if (cache_valid(hi, gi)) {
+        /* same pages as before (mapping changes drop entries): just clear their bits */
+        for (uint32_t i = 0; i < hi->nruns; i++) {
+            if (e->host.dirty_test_clear(e->host.opaque, hi->runs[i][0], hi->runs[i][1])) {
+                dirty_log_add(e, hi->runs[i][0], hi->runs[i][1], hi);
+            }
+        }
+        hi->checked = e->cache_epoch;
+        return;
+    }
+    runs = g_malloc(sizeof(*runs) * CACHE_MAX_RUNS);
+    n = e->host.ram_runs(e->host.opaque, gi->task, gi->va, len, runs, CACHE_MAX_RUNS);
+    if (!n) {
+        g_free(runs);
+        cache_drop(e, hi);
+        return;
+    }
+    /*
+     * Clear the pages' dirty bits (they include our own upload source / write-back) but keep
+     * what was dirty for the next sync: other cached images may share these pages.
+     */
+    for (uint32_t i = 0; i < n; i++) {
+        if (e->host.dirty_test_clear(e->host.opaque, runs[i][0], runs[i][1])) {
+            dirty_log_add(e, runs[i][0], runs[i][1], hi);
+        }
+    }
+    if (!hi->cached) {
+        g_ptr_array_add(e->cached, hi);
+    }
+    g_free(hi->runs);
+    hi->runs = g_realloc(runs, sizeof(*runs) * n);
+    hi->nruns = n;
+    hi->c_task = gi->task;
+    hi->c_va = gi->va;
+    hi->c_len = len;
+    hi->cached = true;
+    hi->checked = e->cache_epoch;
+}
+
+static bool cache_valid(const HostImage *hi, const GuestImage *gi)
+{
+    return hi->cached && hi->c_task == gi->task && hi->c_va == gi->va &&
+           hi->c_len == guest_image_size(gi);
+}
+
+#define CACHE_DIRTY_LOG 8192     /* recently dirty runs remembered for images sharing pages */
+
+/* remember runs found dirty: other cached images on the same pages check this list */
+static void dirty_log_add(PVGExec *e, uint64_t start, uint64_t len, const HostImage *owner)
+{
+    uint64_t r[4] = { start, len, (uintptr_t)owner, e->cache_epoch };
+
+    if (e->pending->len >= CACHE_DIRTY_LOG) {
+        /* forget the oldest half; images not checked since then are dropped when used */
+        guint keep = e->pending->len / 2;
+
+        e->dirty_floor = g_array_index(e->pending, uint64_t, 4 * (e->pending->len - keep) + 3);
+        g_array_remove_range(e->pending, 0, e->pending->len - keep);
+    }
+    g_array_append_vals(e->pending, r, 1);
+}
+
+/*
+ * Start of a command buffer: collect the guest's writes since the last FIFO run (one KVM
+ * dirty-log sync). Cached images are checked lazily, when a command buffer uses them.
+ */
+static void cache_sync(PVGExec *e)
+{
+    int64_t t0;
+
+    if (!e->upload_cache || !e->cache_stale || !e->cached->len) {
+        return;
+    }
+    e->cache_stale = false;
+    t0 = g_get_monotonic_time();
+    e->host.dirty_sync(e->host.opaque);
+    e->cache_epoch++;
+    e->stats.cache_sync_us += g_get_monotonic_time() - t0;
+    if (++e->cache_syncs % 1000 == 0) {
+        elog(e, "write-back by storage mode: shared %" G_GUINT64_FORMAT " MiB, managed %"
+             G_GUINT64_FORMAT " MiB, private %" G_GUINT64_FORMAT " MiB", e->wb_storage[0] >> 20,
+             e->wb_storage[1] >> 20, e->wb_storage[2] >> 20);
+        uint64_t runs = 0, bytes = 0;
+
+        for (guint i = 0; i < e->cached->len; i++) {
+            HostImage *hi = g_ptr_array_index(e->cached, i);
+
+            runs += hi->nruns;
+            bytes += hi->c_len;
+        }
+        elog(e, "upload cache: %u images, %" G_GUINT64_FORMAT " runs, %" G_GUINT64_FORMAT
+             " MiB, %u recent dirty runs", e->cached->len, runs, bytes >> 20, e->pending->len);
+    }
+}
+
+/* is the cached copy still the guest's? (tests and clears its pages' dirty bits) */
+static bool cache_check(PVGExec *e, HostImage *hi)
+{
+    int64_t t0;
+    g_autofree bool *dirty = NULL;
+    bool ok = true;
+
+    if (hi->checked == e->cache_epoch) {
+        return true;
+    }
+    if (hi->checked < e->dirty_floor) {
+        cache_drop(e, hi);      /* writes it may have missed are no longer remembered */
+        return false;
+    }
+    t0 = g_get_monotonic_time();
+    dirty = g_new(bool, hi->nruns);
+    e->host.dirty_test_clear_many(e->host.opaque, (const uint64_t (*)[2])hi->runs, hi->nruns,
+                                  dirty);
+    for (uint32_t k = 0; k < hi->nruns; k++) {
+        if (dirty[k]) {
+            dirty_log_add(e, hi->runs[k][0], hi->runs[k][1], NULL);
+            ok = false;
+        }
+    }
+    /* pages written while another image sharing them was checked or filled */
+    for (guint i = e->pending->len, seen = 0; ok && i-- > 0; seen++) {
+        const uint64_t *r = &g_array_index(e->pending, uint64_t, 4 * i);
+
+        if (r[3] <= hi->checked) {
+            break;
+        }
+        if (seen >= 512) {
+            ok = false;         /* long unused: re-uploading beats scanning the whole log */
+            break;
+        }
+        if (r[2] == (uintptr_t)hi) {
+            continue;
+        }
+        for (uint32_t k = 0; k < hi->nruns; k++) {
+            if (r[0] < hi->runs[k][0] + hi->runs[k][1] && hi->runs[k][0] < r[0] + r[1]) {
+                ok = false;
+                break;
+            }
+        }
+    }
+    e->stats.cache_sync_us += g_get_monotonic_time() - t0;
+    if (!ok) {
+        cache_drop(e, hi);
+        return false;
+    }
+    hi->checked = e->cache_epoch;
+    return true;
+}
