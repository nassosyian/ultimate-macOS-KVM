                 }
             }
         }
@@ -1890,6 +2086,16 @@ static void pvg_linux_exit(PCIDevice *dev)
     PVGLinuxPCIState *s = PVG_LINUX_PCI(dev);
 
     msi_uninit(dev);
+    if (s->exec_thread_started) {
+        pvg_exec_drain(s);
+        qemu_mutex_lock(&s->exec_lock);
+        s->exec_stop = true;
+        qemu_cond_broadcast(&s->exec_cond);
+        qemu_mutex_unlock(&s->exec_lock);
+        qemu_thread_join(&s->exec_thread);
+        qemu_bh_delete(s->exec_bh);
+        s->exec_thread_started = false;
+    }
     if (s->exec) {
