             /* the host's presentFrame completion: the guest waits for it before the next frame */
             pvg_display_event(s, DS_EVENT_PRESENTED);
@@ -2247,6 +2402,7 @@ static void pvg_linux_realize(PCIDevice *dev, Error **errp)
                     warn_report("pvg-linux-pci: Metal executor initialisation failed");
                 } else if (s->async_exec) {
