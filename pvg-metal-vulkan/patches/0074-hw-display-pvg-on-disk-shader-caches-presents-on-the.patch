+/*
+ * On-disk copy of the translation cache: one file per key, <cache_dir>/spv-<build>/<key>, holding
+ * the A2SResult (spirv pointer cleared) followed by the SPIR-V words. Read on a memory miss.
+ */
+#define SPV_FILE_MAGIC 0x31767370u      /* "psv1" */
+
+/*
+ * Cached translations are only valid for the translator that produced them, so the on-disk
+ * caches are keyed by the QEMU binary (size and mtime): any rebuild starts a new cache.
+ */
+static const char *cache_build_id(void)
+{
+    static char id[40];
+    struct stat st;
+
+    if (!id[0]) {
+        if (stat("/proc/self/exe", &st) == 0) {
+            snprintf(id, sizeof(id), "%llx-%llx", (unsigned long long)st.st_size,
+                     (unsigned long long)st.st_mtime);
+        } else {
+            snprintf(id, sizeof(id), "unknown");
+        }
+    }
+    return id;
+}
+
+static char *spv_cache_path(PVGExec *e, const char *key)
+{
+    return g_strdup_printf("%s/spv-%s/%s", e->cache_dir, cache_build_id(), key);
+}
+
+static const A2SResult *spv_cache_load(PVGExec *e, const char *key)
+{
+    g_autofree char *path = NULL;
+    g_autofree char *buf = NULL;
+    gsize len;
+    A2SResult *r;
+    uint32_t hdr[2];
+
+    if (!e->cache_dir) {
+        return NULL;
+    }
+    path = spv_cache_path(e, key);
+    if (!g_file_get_contents(path, &buf, &len, NULL) || len < 8 + sizeof(*r)) {
+        return NULL;
+    }
+    memcpy(hdr, buf, 8);
+    if (hdr[0] != SPV_FILE_MAGIC || hdr[1] != sizeof(*r)) {
+        return NULL;
+    }
+    r = g_memdup2(buf + 8, sizeof(*r));
+    if (len != 8 + sizeof(*r) + r->nwords * 4 || !r->nwords) {
+        g_free(r);
+        return NULL;
+    }
+    r->spirv = g_memdup2(buf + 8 + sizeof(*r), r->nwords * 4);
+    g_hash_table_replace(e->spv_cache, g_strdup(key), r);
+    e->stats.spv_disk_hits++;
+    return r;
+}
+
+static void spv_cache_save(PVGExec *e, const char *key, const A2SResult *r)
+{
+    g_autofree char *path = NULL;
+    g_autofree char *dir = NULL;
+    g_autofree char *buf = NULL;
+    size_t len = 8 + sizeof(*r) + r->nwords * 4;
+    uint32_t hdr[2] = { SPV_FILE_MAGIC, sizeof(*r) };
+    A2SResult flat = *r;
+
+    if (!e->cache_dir) {
+        return;
+    }
+    path = spv_cache_path(e, key);
+    dir = g_path_get_dirname(path);
+    g_mkdir_with_parents(dir, 0700);
+    flat.spirv = NULL;
+    buf = g_malloc(len);
+    memcpy(buf, hdr, 8);
+    memcpy(buf + 8, &flat, sizeof(flat));
+    memcpy(buf + 8 + sizeof(flat), r->spirv, r->nwords * 4);
+    g_file_set_contents(path, buf, len, NULL);
+}
+
 static bool spv_cache_lookup(PVGExec *e, const char *key, A2SResult *r)
 {
     const A2SResult *hit = g_hash_table_lookup(e->spv_cache, key);
 
-    if (!hit) {
