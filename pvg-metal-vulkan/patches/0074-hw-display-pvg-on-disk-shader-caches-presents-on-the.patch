@@ -1643,7 +1785,7 @@ static void pvg_exec_submit(PVGLinuxPCIState *s, PVGExecJob *job)
     job->stamp_index = s->cur_stamp_index;
     job->stamp = s->cur_stamp_value;
     if (!s->async_exec || !s->exec_thread_started) {
-        for (guint i = 0; i < job->bufs->len; i++) {
+        for (guint i = 0; job->bufs && i < job->bufs->len; i++) {
             gsize n;
             const uint8_t *b = g_bytes_get_data(g_ptr_array_index(job->bufs, i), &n);
 
@@ -1771,7 +1913,12 @@ static void pvg_dispatch(PVGLinuxPCIState *s, const PVGCmdHeader *h,
                          const uint8_t *payload, uint32_t len)
 {
     switch (h->opcode) {
-    case PVG_CMD_DISPLAY_TRANSACTION3: case PVG_CMD_UNMAP_MEMORY: case PVG_CMD_MAP_MEMORY2:
+    case PVG_CMD_DISPLAY_TRANSACTION3:
+        if (s->exec_thread_started) {
+            break;              /* queued behind the command buffers it shows */
+        }
+        /* fall through */
+    case PVG_CMD_UNMAP_MEMORY: case PVG_CMD_MAP_MEMORY2:
     case PVG_CMD_DELETE_TASK: case PVG_CMD_DELETE_RESOURCE: case PVG_CMD_DELETE_OBJECT:
     case PVG_CMD_DEFINE_TASK2: case PVG_CMD_SET_OBJECT_LIST: case 0x3c: /* ReplacePhysical */
     case 0x35:          /* SynchronizeResources: the executor writes resources back */
@@ -1812,6 +1959,14 @@ static void pvg_dispatch(PVGLinuxPCIState *s, const PVGCmdHeader *h,
                 pvg_display_set_gamma(s, ldq_le_p(payload + 12), ldq_le_p(payload + 20),
