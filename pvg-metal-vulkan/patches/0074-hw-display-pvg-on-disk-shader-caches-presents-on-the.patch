+/*
+ * The VkPipelineCache is saved when new pipelines were created and 20 s passed since the last
+ * save (QEMU exits without freeing devices, so there is no reliable final save). The driver
+ * checks the data's header (device and driver UUID) when it is loaded again.
+ */
+static void vk_cache_maybe_save(PVGExec *e, bool force)
+{
+    static int64_t last;
+    int64_t now = g_get_monotonic_time();
+    g_autofree char *path = NULL;
+    g_autofree void *data = NULL;
