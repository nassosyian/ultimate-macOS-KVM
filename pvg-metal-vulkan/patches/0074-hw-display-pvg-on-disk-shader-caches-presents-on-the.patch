+/*
+ * Worker side of a present: read the frame into present_tmp without holding anything, then
+ * merge it into present_buf under present_lock, recording the rows that changed.
+ */
+static void pvg_present_run(PVGLinuxPCIState *s, uint32_t surface_id)
+{
+    uint8_t obj[0x100];
+    uint32_t objlen, offset, width, height, row_bytes, missing = 0, changed = 0;
+    uint64_t base;
+
+    if (pvg_task_object(s, 0, surface_id, obj, sizeof(obj), &objlen) !=
+        PVG_OBJ_BACKING || objlen < 0x24 || ldl_le_p(obj + 0x10) < 1) {
+        trace_pvg_linux_scanout_skip(surface_id, "not a backing");
+        goto done;
+    }
+    base = (uint64_t)ldl_le_p(obj + 0x08) << 12;
+    offset = ldl_le_p(obj + 0x14);
+    width = ldl_le_p(obj + 0x18);
+    height = ldl_le_p(obj + 0x1c);
+    row_bytes = ldl_le_p(obj + 0x20) & 0xffffff;
+    if (ldl_le_p(obj + 0x0c) != PVG_FOURCC_BGRA || (ldl_le_p(obj + 0x20) >> 24) != 4 ||
+        !width || !height || width > 8192 || height > 8192 || row_bytes < width * 4) {
+        trace_pvg_linux_scanout_skip(surface_id, "unsupported format");
+        goto done;
+    }
+    if (width != s->present_w || height != s->present_h) {
+        qemu_mutex_lock(&s->present_lock);
+        g_free(s->present_buf);
+        g_free(s->present_tmp);
+        s->present_buf = g_new0(uint32_t, (size_t)width * height);
+        s->present_tmp = g_new0(uint32_t, (size_t)width * height);
+        s->present_w = width;
+        s->present_h = height;
+        s->present_y0 = 0;
+        s->present_y1 = height;
+        qemu_mutex_unlock(&s->present_lock);
+    }
+    for (uint32_t y = 0; y < height; y++) {
+        uint32_t *row = s->present_tmp + (size_t)y * width;
+
+        if (!pvg_task_read(s, 0, base + offset + (uint64_t)y * row_bytes, row, width * 4)) {
+            memset(row, 0, width * 4);
+            missing++;
+        }
+    }
+    qemu_mutex_lock(&s->present_lock);
+    for (uint32_t y = 0; y < height; y++) {
+        uint32_t *src = s->present_tmp + (size_t)y * width;
+        uint32_t *dst = s->present_buf + (size_t)y * width;
+
+        if (memcmp(src, dst, width * 4)) {
+            memcpy(dst, src, width * 4);
+            if (s->present_y1 == 0) {
+                s->present_y0 = y;
+            }
+            s->present_y0 = MIN(s->present_y0, y);
+            s->present_y1 = MAX(s->present_y1, y + 1);
+            changed++;
+        }
+    }
+    qemu_mutex_unlock(&s->present_lock);
+    trace_pvg_linux_scanout(surface_id, width, height, base, missing, changed);
+done:
+    qatomic_inc(&s->presents_done);
+}
+
+/* main loop: put the rows the worker found changed on the console and complete the present */
+static void pvg_present_show(PVGLinuxPCIState *s)
+{
+    uint32_t done = qatomic_read(&s->presents_done), y0, y1, w, h;
+    uint32_t *fb;
+    int stride;
+
+    if (done == s->presents_shown || !s->con) {
+        return;
+    }
+    s->presents_shown = done;
+    qemu_mutex_lock(&s->present_lock);
+    w = s->present_w;
+    h = s->present_h;
+    if (w && h) {
+        pvg_display_ensure_surface(s, w, h);
+        if (s->present_full || !s->scanout_valid) {
+            s->present_y0 = 0;
+            s->present_y1 = h;
+            s->present_full = false;
+        }
+    }
+    y0 = s->present_y0;
+    y1 = s->present_y1;
+    s->present_y0 = s->present_y1 = 0;
+    if (w && h && y1 > y0) {
+        fb = surface_data(s->surface);
+        stride = surface_stride(s->surface);
+        for (uint32_t y = y0; y < y1; y++) {
+            const uint32_t *src = s->present_buf + (size_t)y * w;
+            uint32_t *row = (uint32_t *)((uint8_t *)fb + y * stride);
+
+            if (!s->gamma_active) {
+                memcpy(row, src, w * 4);
+                continue;
+            }
+            for (uint32_t x = 0; x < w; x++) {
+                uint32_t p = src[x];
+
+                row[x] = (p & 0xff000000) | s->gamma_lut[0][p >> 16 & 0xff] << 16 |
+                         s->gamma_lut[1][p >> 8 & 0xff] << 8 | s->gamma_lut[2][p & 0xff];
+            }
+        }
+    }
+    qemu_mutex_unlock(&s->present_lock);
+    if (w && h) {
+        s->scanout_valid = true;
+        if (y1 > y0) {
+            qemu_console_update(s->con, 0, y0, w, y1 - y0);
+        }
+    }
+    pvg_display_event(s, DS_EVENT_PRESENTED);
+    trace_pvg_linux_present_shown(y0, y1, g_get_monotonic_time() - s->present_queued_us);
+}
