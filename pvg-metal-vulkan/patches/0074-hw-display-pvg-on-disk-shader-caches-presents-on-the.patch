+/* caches of other QEMU builds are deleted once they are a week old */
+static void cache_prune(const char *dir)
+{
+    g_autoptr(GDir) d = g_dir_open(dir, 0, NULL);
+    const char *name;
+    time_t old = time(NULL) - 7 * 24 * 3600;
+
+    while (d && (name = g_dir_read_name(d))) {
+        g_autofree char *path = g_build_filename(dir, name, NULL);
+        struct stat st;
+
+        if (strstr(name, cache_build_id()) || stat(path, &st) || st.st_mtime > old) {
+            continue;
+        }
+        if (S_ISDIR(st.st_mode)) {
+            g_autoptr(GDir) sub = g_dir_open(path, 0, NULL);
+            const char *f;
+
+            while (sub && (f = g_dir_read_name(sub))) {
+                g_autofree char *fp = g_build_filename(path, f, NULL);
+
+                g_unlink(fp);
+            }
+            g_rmdir(path);
+        } else {
+            g_unlink(path);
+        }
+    }
+}
+
+static char *vk_cache_path(PVGExec *e)
+{
+    return g_strdup_printf("%s/pipelines-%s.bin", e->cache_dir, cache_build_id());
+}
