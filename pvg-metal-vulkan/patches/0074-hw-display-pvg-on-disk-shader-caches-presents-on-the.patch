+/*
+ * Diagnostic (PVG_DIAG_REDUNDANT=1): how many uploaded bytes are identical to the previous upload
+ * of the same guest range. Hashes every upload on the CPU: slow, measurement runs only.
+ */
+static void diag_redundant(PVGExec *e, uint32_t task, uint64_t va, uint64_t len)
+{
+    static GHashTable *last;
+    static uint64_t total[2], same[2], n;
+    static int on = -1;
+    g_autofree uint64_t *buf = NULL;
+    uint64_t h = 0xcbf29ce484222325ull, key[2] = { (uint64_t)task << 48 ^ va, len };
+    gint64 k;
+    gpointer old;
+    int big = len > (1u << 20);
+
+    if (on < 0) {
+        on = g_getenv("PVG_DIAG_REDUNDANT") != NULL;
+        last = g_hash_table_new_full(g_int64_hash, g_int64_equal, g_free, NULL);
+    }
+    if (!on || len < 64) {
+        return;
+    }
+    buf = g_malloc((len + 7) & ~7ull);
+    if (!e->host.read(e->host.opaque, task, va, buf, len)) {
+        return;
+    }
+    for (uint64_t i = 0; i < len / 8; i++) {
+        h = (h ^ buf[i]) * 0x100000001b3ull;
+    }
+    k = (gint64)(key[0] * 31 + key[1]);
+    total[big] += len;
+    if (g_hash_table_lookup_extended(last, &k, NULL, &old) && (uint64_t)(uintptr_t)old == h) {
+        same[big] += len;
+    } else {
+        g_hash_table_replace(last, g_memdup2(&k, sizeof(k)), (gpointer)(uintptr_t)h);
+    }
+    if (++n % 20000 == 0) {
+        elog(e, "diag: uploads <=1MiB %" G_GUINT64_FORMAT " MiB, %" G_GUINT64_FORMAT
+             " MiB unchanged; >1MiB %" G_GUINT64_FORMAT " MiB, %" G_GUINT64_FORMAT
+             " MiB unchanged; %u ranges", total[0] >> 20,
+             same[0] >> 20, total[1] >> 20, same[1] >> 20, g_hash_table_size(last));
+    }
+}
